@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<SchoolApp.Models.Enrollment>
@{
    ViewData["Title"] = L["Enr_Title"].Value;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var statusVal = ViewData["Status"]?.ToString() ?? "";
    var statusLabel = statusVal switch {
        "completed"  => L["Enr_StatusCompleted"].Value,
        "inprogress" => L["Enr_StatusInProgress"].Value,
        _            => L["Enr_StatusFilter"].Value
    };
    var filterActive = !string.IsNullOrEmpty(statusVal);
}

<!-- ==================== PAGE HEADER ==================== -->
<div class="adm-page-header">
    <div>
        <div class="adm-page-title">📋 @L["Enr_Title"]</div>
        <div class="adm-page-sub">@L["Enr_Sub"]</div>
    </div>
</div>

<!-- ==================== TOOLBAR ==================== -->
<div style="display:flex; align-items:center; gap:.75rem; margin-bottom:1.5rem; flex-wrap:wrap;">
    <form id="searchForm" method="get" style="display:flex; align-items:center; gap:8px; flex:1; flex-wrap:wrap;">
        <!-- Search -->
        <div style="position:relative; min-width:200px; max-width:380px; flex:1; display:flex;">
            <i class="bi bi-search" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--adm-text-dim); font-size:.85rem; z-index:1;"></i>
            <input type="text" name="searchTerm" value="@ViewData["SearchTerm"]"
                   class="adm-input" placeholder="@L["Enr_SearchPlaceholder"]"
                   style="padding-left:36px; border-radius:8px 0 0 8px; flex:1;" />
            <button type="submit" class="adm-btn adm-btn-primary" style="border-radius:0 8px 8px 0; padding:9px 18px; font-weight:600;">
                @L["Course_SearchBtn"]
            </button>
        </div>

        <!-- Dropdown filter trạng thái -->
        <input type="hidden" id="statusInput" name="status" value="@statusVal" />
        <div class="dropdown">
            <button class="adm-btn dropdown-toggle" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false"
                    style="@(filterActive ? "border-color:#c9a84c; color:#c9a84c;" : "background:rgba(255,255,255,.07); color:rgba(255,255,255,.6); border:1px solid rgba(255,255,255,.15);")">
                @statusLabel
            </button>
            <ul class="dropdown-menu dropdown-menu-dark"
                style="min-width:180px; border:1px solid rgba(255,255,255,.1); background:#14233d;">
                <li>
                    <a class="dropdown-item @(statusVal == "" ? "active" : "")"
                       href="javascript:void(0)" onclick="setStatus('')">
                        <i class="bi bi-list-ul me-2"></i> @L["Enr_StatusAll"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item @(statusVal == "inprogress" ? "active" : "")"
                       href="javascript:void(0)" onclick="setStatus('inprogress')">
                        <i class="bi bi-play-circle me-2" style="color:#42a5f5;"></i> @L["Enr_BadgeInProgress"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item @(statusVal == "completed" ? "active" : "")"
                       href="javascript:void(0)" onclick="setStatus('completed')">
                        <i class="bi bi-check-circle-fill me-2" style="color:#4caf50;"></i> @L["Enr_BadgeCompleted"]
                    </a>
                </li>
            </ul>
        </div>
    </form>
</div>

<!-- Nút ghi danh thủ công -->
<div style="display:flex; justify-content:flex-end; margin-bottom:1rem;">
    <button type="button" class="adm-btn adm-btn-primary" data-bs-toggle="modal" data-bs-target="#enrollManualModal">
        <i class="bi bi-person-plus-fill me-1"></i> @L["Enr_ManualEnroll"]
    </button>
</div>

<!-- ==================== TABLE ==================== -->
<div id="enrollmentTableContainer">
    @await Html.PartialAsync("_EnrollmentTable", Model)
</div>

<!-- ==================== MODAL GHI DANH ==================== -->
<div class="modal fade" id="enrollManualModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border:none; border-radius:12px; overflow:hidden; box-shadow:0 8px 32px rgba(0,0,0,.5);">
            <div class="modal-header" style="background:linear-gradient(135deg,#0d1b2e,#1a2f4e); border:none; padding:1.25rem 1.5rem;">
                <h5 class="modal-title" style="color:#c9a84c; font-weight:600;">
                    <i class="bi bi-person-plus-fill me-2"></i>@L["Enr_ManualEnroll"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:1.5rem; background:#fff;">
                <div id="enrollResult"></div>
                <div class="mb-3">
                    <label class="sa-label">@L["Enr_SelectStudent"] <span class="text-danger">*</span></label>
                    <input type="text" id="studentSearch" class="sa-input" placeholder="@L["Enr_StudentSearchPlaceholder"]" autocomplete="off" />
                    <input type="hidden" id="selectedUserId" />
                    <div id="studentSuggestions" style="background:#fff; border:1px solid #ddd; border-radius:6px; max-height:180px; overflow-y:auto; display:none; position:absolute; z-index:9999; width:calc(100% - 3rem);"></div>
                    <small class="text-muted" id="selectedStudentLabel"></small>
                </div>
                <div class="mb-3">
                    <label class="sa-label">@L["Enr_SelectCourse"] <span class="text-danger">*</span></label>
                    <select id="selectedCourseId" class="sa-input">
                        <option value="">@L["Enr_SelectCoursePlaceholder"]</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer" style="background:#f8f9fa; border-top:1px solid #e9ecef; padding:1rem 1.5rem;">
                <button type="button" class="sa-btn sa-btn-outline" data-bs-dismiss="modal">@L["Btn_Cancel"]</button>
                <button type="button" class="sa-btn sa-btn-primary" id="btnEnrollSave">
                    <i class="bi bi-check-lg me-1"></i> @L["Enr_Enroll"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
    <script>
        var _enrNotFound   = '@L["Enr_NotFound"]';
        var _enrSelected   = '@L["Enr_Selected"]';
        var _enrStudentWar = '@L["Enr_SelectStudentWarning"]';
        var _enrCourseWar  = '@L["Enr_SelectCourseWarning"]';
        var _enrConnErr    = '@L["Enr_ConnError"]';
        var _enrDelConf    = '@L["Enr_DeleteConfirm"]';
        var _enrAjaxError  = '@L["Stu_AjaxError"]';
        var _enrLoadErr    = '@L["Stu_LoadDataError"]';

        function setStatus(val) {
            $('#statusInput').val(val);
            loadEnrollments(1);
        }

        $(function () {
            $('#searchForm').on('submit', function (e) {
                e.preventDefault();
                loadEnrollments(1);
            });

            $(document).on('click', '.ajax-page-link', function (e) {
                e.preventDefault();
                var match = $(this).attr('href').match(/page=(\d+)/);
                loadEnrollments(match ? match[1] : 1);
            });

            $(document).on('click', '.btn-delete-enrollment', function () {
                if (!confirm(_enrDelConf)) return;
                var id = $(this).data('id');
                var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("DeleteAjax", "Enrollment")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function (res) {
                        if (res.success) { showToast(res.message, 'success'); loadEnrollments(1); }
                        else { showToast(res.message, 'danger'); }
                    },
                    error: function (xhr) {
                        showToast(_enrAjaxError + xhr.statusText, 'danger');
                    }
                });
            });

            function loadEnrollments(page) {
                var searchTerm = $('#searchForm input[name="searchTerm"]').val();
                var status     = $('#statusInput').val();
                $.ajax({
                    url: '@Url.Action("Index", "Enrollment")',
                    type: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    data: { searchTerm: searchTerm, page: page, status: status },
                    success: function (html) {
                        $('#enrollmentTableContainer').html(html);
                    },
                    error: function (xhr) {
                        showToast(_enrLoadErr + xhr.statusText, 'danger');
                    }
                });
            }

            var searchTimer;
            $('#studentSearch').on('input', function () {
                clearTimeout(searchTimer);
                var q = $(this).val().trim();
                $('#selectedUserId').val('');
                $('#selectedStudentLabel').text('');
                if (q.length < 2) { $('#studentSuggestions').hide(); return; }
                searchTimer = setTimeout(function () {
                    $.get('@Url.Action("SearchStudents", "Enrollment")', { q: q }, function (data) {
                        var $box = $('#studentSuggestions').empty().show();
                        if (!data.length) {
                            $box.html('<div style="padding:8px 12px; color:#555; font-size:.9rem;">' + _enrNotFound + '</div>');
                            return;
                        }
                        data.forEach(function (u) {
                            $('<div>').text(u.label)
                                .css({ padding: '8px 12px', cursor: 'pointer', color: '#212529', fontSize: '.9rem' })
                                .hover(function () { $(this).css('background', '#e8f0fe'); },
                                       function () { $(this).css('background', '#fff'); })
                                .on('click', function () {
                                    $('#selectedUserId').val(u.userId);
                                    $('#studentSearch').val(u.label);
                                    $('#selectedStudentLabel').text(_enrSelected).css('color', '#198754');
                                    $('#studentSuggestions').hide();
                                })
                                .appendTo($box);
                        });
                    });
                }, 300);
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('#studentSearch, #studentSuggestions').length)
                    $('#studentSuggestions').hide();
            });

            $('#enrollManualModal').on('show.bs.modal', function () {
                $('#enrollResult').html('');
                $('#studentSearch').val('');
                $('#selectedUserId').val('');
                $('#selectedStudentLabel').text('');
                $('#studentSuggestions').hide();
                if ($('#selectedCourseId option').length <= 1) {
                    $.get('/Course/GetActiveCourses', function (data) {
                        var $sel = $('#selectedCourseId').empty().append('<option value="">@L["Enr_SelectCoursePlaceholder"]</option>');
                        (data || []).forEach(function (c) {
                            $sel.append($('<option>').val(c.courseId).text(c.courseName));
                        });
                    });
                }
            });

            $('#btnEnrollSave').on('click', function () {
                var userId = $('#selectedUserId').val();
                var courseId = $('#selectedCourseId').val();
                if (!userId) { $('#enrollResult').html('<div class="alert alert-warning py-2">' + _enrStudentWar + '</div>'); return; }
                if (!courseId) { $('#enrollResult').html('<div class="alert alert-warning py-2">' + _enrCourseWar + '</div>'); return; }
                var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("EnrollManual", "Enrollment")',
                    type: 'POST',
                    data: { userId: userId, courseId: courseId, __RequestVerificationToken: token },
                    success: function (res) {
                        if (res.success) {
                            $('#enrollManualModal').modal('hide');
                            showToast(res.message, 'success');
                            loadEnrollments(1);
                        } else {
                            $('#enrollResult').html('<div class="alert alert-danger py-2">' + $('<span>').text(res.message).html() + '</div>');
                        }
                    },
                    error: function () {
                        $('#enrollResult').html('<div class="alert alert-danger py-2">' + _enrConnErr + '</div>');
                    }
                });
            });

            window.showToast = function (message, type) {
                var cls  = type === 'success' ? 'sa-alert-success' : 'sa-alert-danger';
                var icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
                var toast = $('<div class="sa-alert ' + cls + '" style="position:fixed; top:1rem; right:1rem; z-index:9999; min-width:300px; max-width:450px; box-shadow:var(--shadow-md);">' +
                    '<span class="sa-alert-icon"><i class="bi ' + icon + '"></i></span>' +
                    '<span>' + $('<span>').text(message).html() + '</span>' +
                    '<button class="sa-alert-close" onclick="$(this).parent().remove()"><i class="bi bi-x"></i></button>' +
                    '</div>');
                $('body').append(toast);
                setTimeout(function () { toast.fadeOut(300, function () { $(this).remove(); }); }, 3000);
            };
        });
    </script>
}
