@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<SchoolApp.Models.Enrollment>
@{
    ViewData["Title"] = L["MyEnr_Title"].Value;
    var studentName = Context.Session.GetString("StudentName");
    var filter = Context.Request.Query["filter"].ToString();
    if (string.IsNullOrEmpty(filter)) filter = "all";
    var allCount = (int)(ViewBag.AllCount ?? 0);
    var activeCount = (int)(ViewBag.ActiveCount ?? 0);
    var completedCount = (int)(ViewBag.CompletedCount ?? 0);
    var reviewedIds = ViewBag.ReviewedCourseIds as HashSet<int> ?? new HashSet<int>();
    var certMap = ViewBag.CertMap as Dictionary<int, int> ?? new Dictionary<int, int>();
    var pct = allCount > 0 ? (int)Math.Round(completedCount * 100.0 / allCount) : 0;
}

@section Styles {
    <style>
        .mec-layout {
            display: flex;
            gap: 1.5rem;
            align-items: flex-start;
        }

        .mec-sidebar {
            width: 230px;
            flex-shrink: 0;
            position: sticky;
            top: 80px;
            background: var(--surface,#fff);
            border: 1px solid var(--smoke,#e9ecef);
            border-radius: 16px;
            padding: .75rem 0;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
        }

            .mec-sidebar .s-label {
                font-size: .68rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .09em;
                color: var(--text-light,#888);
                padding: .5rem 1.1rem .3rem;
            }

            .mec-sidebar .s-link {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: .55rem 1.1rem;
                border-radius: 8px;
                margin: 0 .4rem;
                color: var(--text-mid,#444);
                font-size: .88rem;
                font-weight: 500;
                text-decoration: none;
                transition: background .15s;
            }

                .mec-sidebar .s-link:hover {
                    background: rgba(0,0,0,.04);
                }

                .mec-sidebar .s-link.active {
                    background: var(--navy,#0d1b2a);
                    color: #fff;
                }

                .mec-sidebar .s-link .badge {
                    font-size: .7rem;
                    padding: .12rem .5rem;
                    border-radius: 999px;
                    background: rgba(255,255,255,.25);
                    font-weight: 600;
                }

                .mec-sidebar .s-link:not(.active) .badge {
                    background: #e9ecef;
                    color: #555;
                }

        .mec-content {
            flex: 1;
            min-width: 0;
        }

        /* Card row */
        .course-card {
            background: var(--surface,#fff);
            border: 1px solid var(--smoke,#e9ecef);
            border-radius: 14px;
            padding: 1.1rem 1.25rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: box-shadow .2s, border-color .2s;
            margin-bottom: .65rem;
        }

            .course-card:hover {
                box-shadow: 0 4px 18px rgba(0,0,0,.09);
                border-color: rgba(201,168,76,.3);
            }

            .course-card.completed {
                border-left: 3px solid #198754;
            }

            .course-card.inprogress {
                border-left: 3px solid var(--navy,#0d1b2a);
            }

        .cc-index {
            width: 32px;
            height: 32px;
            flex-shrink: 0;
            border-radius: 50%;
            background: var(--smoke,#f1f3f5);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
            font-weight: 700;
            color: var(--text-light,#888);
        }

        .cc-info {
            flex: 1;
            min-width: 0;
        }

        .cc-name {
            font-weight: 600;
            font-size: .95rem;
            color: var(--text-dark,#1a1a2e);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .cc-meta {
            font-size: .78rem;
            color: var(--text-light,#888);
            margin-top: .2rem;
            display: flex;
            align-items: center;
            gap: .75rem;
            flex-wrap: wrap;
        }

        .cc-actions {
            display: flex;
            gap: .5rem;
            flex-shrink: 0;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .btn-review {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .38rem .85rem;
            border-radius: 8px;
            font-size: .8rem;
            font-weight: 600;
            border: 1.5px solid var(--gold,#c9a84c);
            color: var(--gold,#c9a84c);
            background: transparent;
            cursor: pointer;
            text-decoration: none;
            transition: background .15s, color .15s;
        }

            .btn-review:hover {
                background: var(--gold,#c9a84c);
                color: #fff;
            }

        .btn-reviewed {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .38rem .85rem;
            border-radius: 8px;
            font-size: .8rem;
            font-weight: 500;
            border: 1.5px solid #e9ecef;
            color: var(--text-light,#888);
            background: #f8f9fa;
            cursor: default;
            text-decoration: none;
        }

        @@media (max-width:768px) {
            .mec-layout {
                flex-direction: column;
            }

            .mec-sidebar {
                width: 100%;
                position: static;
            }

            .course-card {
                flex-wrap: wrap;
            }

            .cc-actions {
                width: 100%;
            }
        }
    </style>
}

<!-- Hero -->
<div class="sa-page-hero mb-4">
    <h1 style="font-family:var(--font-display); font-size:1.8rem; color:#fff; margin-bottom:.25rem;">
        🎓 @L["MyEnr_Title"]
    </h1>
    <p style="color:rgba(255,255,255,.55); font-size:.9rem;">
        @L["MyEnr_Welcome"] <strong style="color:var(--gold-light);">@studentName</strong> — @L["MyEnr_WelcomeSub"]
    </p>
</div>

@if (!Model.Any() && filter == "all")
{
    <div class="sa-card" style="text-align:center; padding:3rem 1.5rem;">
        <div style="font-size:3rem; margin-bottom:1rem;">📭</div>
        <h3 style="font-family:var(--font-display); color:var(--text-mid); margin-bottom:.5rem;">
            @L["MyEnr_NoEnrollments"]
        </h3>
        <p style="color:var(--text-light); margin-bottom:1.5rem;">
            @L["MyEnr_Explore"]
        </p>
        <a asp-controller="Course" asp-action="Index" class="sa-btn sa-btn-gold">
            <i class="bi bi-book-fill"></i> @L["MyEnr_ViewCourse"]
        </a>
    </div>
}
else
{
    <div class="mec-layout">

        <!-- Sidebar -->
        <nav class="mec-sidebar">
            <div class="s-label">@L["MyEnr_Filter"]</div>
            <a href="@Url.Action("MyEnrollments", new { filter = "all" })"
               class="s-link @(filter == "all" ? "active" : "")">
                <span><i class="bi bi-grid me-2"></i>@L["MyEnr_All"]</span>
                <span class="badge">@allCount</span>
            </a>
            <a href="@Url.Action("MyEnrollments", new { filter = "inprogress" })"
               class="s-link @(filter == "inprogress" ? "active" : "")">
                <span><i class="bi bi-play-circle me-2"></i>@L["MyEnr_InProgress"]</span>
                <span class="badge">@activeCount</span>
            </a>
            <a href="@Url.Action("MyEnrollments", new { filter = "completed" })"
               class="s-link @(filter == "completed" ? "active" : "")">
                <span><i class="bi bi-patch-check me-2"></i>@L["MyEnr_Completed"]</span>
                <span class="badge">@completedCount</span>
            </a>

            <hr style="margin:.6rem .75rem;" />

            <div class="s-label">@L["MyEnr_StatsTitle"]</div>
            <div style="padding:.4rem 1.1rem .8rem;">
                <div style="display:flex; justify-content:space-between; font-size:.84rem; margin-bottom:.35rem;">
                    <span style="color:var(--text-light);">@L["MyEnr_Enrolled"]</span>
                    <strong>@allCount</strong>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:.84rem; margin-bottom:.35rem;">
                    <span style="color:var(--text-light);">@L["MyEnr_CompletedStat"]</span>
                    <strong style="color:#198754;">@completedCount</strong>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:.84rem; margin-bottom:.65rem;">
                    <span style="color:var(--text-light);">@L["MyEnr_InProgressStat"]</span>
                    <strong style="color:var(--navy,#0d1b2a);">@activeCount</strong>
                </div>
                @if (allCount > 0)
                {
                    <div style="font-size:.72rem; color:var(--text-light); margin-bottom:.25rem;">
                        @L["MyEnr_OverallProgress"]
                    </div>
                    <div style="background:#e9ecef; border-radius:999px; height:7px; overflow:hidden;">
                        <div style="width:@pct%; height:100%; background:linear-gradient(90deg,#198754,#34d399); border-radius:999px; transition:width .4s;"></div>
                    </div>
                    <div style="font-size:.72rem; color:var(--text-light); text-align:right; margin-top:.25rem;">@pct%</div>
                }
            </div>
        </nav>

        <!-- Main -->
        <div class="mec-content">
            @if (!Model.Any())
            {
                <div class="sa-card" style="text-align:center; padding:2.5rem 1.5rem;">
                    <div style="font-size:2.5rem; margin-bottom:.75rem;">
                        @(filter == "completed" ? "🏆" : "📖")
                    </div>
                    <p style="color:var(--text-light); margin:0;">
                        @(filter == "completed" ? L["MyEnr_NoneCompleted"].Value : L["MyEnr_NoneInProgress"].Value)
                    </p>
                </div>
            }
            else
            {
                int i = (Model.PageNumber - 1) * Model.PageSize + 1;
                foreach (var item in Model)
                {
                    <div class="course-card @(item.IsCompleted ? "completed" : "inprogress")">

                        <!-- Index -->
                        <div class="cc-index">@i</div>

                        <!-- Info -->
                        <div class="cc-info">
                            <div class="cc-name">@item.Course?.CourseName</div>
                            <div class="cc-meta">
                                <span><i class="bi bi-calendar3" style="opacity:.6;"></i> @item.EnrollDate.ToString("dd/MM/yyyy")</span>
                                @if (item.IsCompleted)
                                {
                                    <span style="color:#198754; font-weight:600;">
                                        <i class="bi bi-check-circle-fill"></i> @L["MyEnr_Completed"]
                                        @if (item.CompletedAt.HasValue)
                                        {
                                            <text>· @item.CompletedAt.Value.ToString("dd/MM/yyyy")</text>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--navy,#0d1b2a); font-weight:500;">
                                        <i class="bi bi-play-circle-fill"></i> @L["MyEnr_InProgress"]
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="cc-actions">
                            @if (item.IsCompleted)
                            {
                                @if (certMap.TryGetValue(item.EnrollmentId, out var certId))
                                {
                                    <a href="@Url.Action("Download", "Certificate", new { id = certId })"
                                       class="btn-review" target="_blank" title="@L["MyEnr_CertTitle"]"
                                       style="border-color:#16a34a; color:#16a34a;"
                                       onmouseenter="this.style.background='#16a34a';this.style.color='#fff'"
                                       onmouseleave="this.style.background='transparent';this.style.color='#16a34a'">
                                        <i class="bi bi-patch-check-fill"></i> @L["MyEnr_CertBadge"]
                                    </a>
                                }

                                @if (reviewedIds.Contains(item.CourseId))
                                {
                                    <span class="btn-reviewed">
                                        <i class="bi bi-star-fill" style="color:#f59e0b;"></i> @L["MyEnr_ReviewedBadge"]
                                    </span>
                                }
                                else
                                {
                                    <button class="btn-review btn-open-review"
                                            data-course-id="@item.CourseId"
                                            data-course-name="@item.Course?.CourseName">
                                        <i class="bi bi-star"></i> @L["MyEnr_ReviewBtn"]
                                    </button>
                                }
                            }

                            <a asp-controller="Learn" asp-action="Course" asp-route-id="@item.CourseId"
                               class="sa-btn sa-btn-gold" style="padding:.38rem .95rem; font-size:.82rem;">
                                <i class="bi @(item.IsCompleted ? "bi-eye-fill" : "bi-play-fill")"></i>
                                @(item.IsCompleted ? L["MyEnr_ViewAgain"].Value : L["MyEnr_GoLearn"].Value)
                            </a>
                        </div>
                    </div>
                    i++;
                }

                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center px-1 py-2 mt-1">
                    <small style="color:var(--text-light);">
                        @L["MyEnr_Page"] @Model.PageNumber / @Model.PageCount
                        (@L["MyEnr_Total"] @Model.TotalItemCount @L["MyEnr_TotalSuffix"])
                    </small>
                    @Html.PagedListPager(Model,
                    page => Url.Action("MyEnrollments", new { page, filter }),
                        new PagedListRenderOptions
                        {
                            LiElementClasses = new[] { "page-item" },
                            PageClasses = new[] { "page-link" },
                            UlElementClasses = new[] { "pagination mb-0" }
                        })
        </div>
                }
        </div>
    </div>
}

<!-- Review Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:460px;">
        <div class="modal-content" style="border-radius:16px; border:none; overflow:hidden;">
            <div style="background:var(--navy,#0d1b2a); padding:1.1rem 1.4rem; display:flex; align-items:center; justify-content:space-between;">
                <h6 style="margin:0; color:#fff; font-size:.95rem;">
                    <i class="bi bi-star-fill" style="color:var(--gold-light,#c9a84c);"></i>
                    @L["MyEnr_ReviewTitle"]
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:1.4rem;">
                <p id="rmCourseName" style="font-weight:600; font-size:.95rem; color:var(--text-dark); margin-bottom:1rem;"></p>

                <!-- Stars -->
                <div style="margin-bottom:1rem;">
                    <label style="font-size:.82rem; color:var(--text-light); display:block; margin-bottom:.4rem;">@L["MyEnr_RatingLabel"]</label>
                    <div id="rmStars" style="display:flex; gap:.4rem;">
                        @for (int s = 1; s <= 5; s++)
                        {
                            <i class="bi bi-star rm-star" data-val="@s"
                               style="font-size:1.9rem; color:#d1d5db; cursor:pointer; transition:color .12s;"></i>
                        }
                    </div>
                    <div id="rmStarLabel" style="font-size:.78rem; color:var(--text-light); margin-top:.3rem; min-height:1em;"></div>
                </div>

                <!-- Comment -->
                <div style="margin-bottom:1.1rem;">
                    <label style="font-size:.82rem; color:var(--text-light); display:block; margin-bottom:.4rem;">@L["MyEnr_ReviewComment"]</label>
                    <textarea id="rmComment" rows="3" placeholder="@L["MyEnr_CommentPh"]"
                              style="width:100%; border:1px solid #dee2e6; border-radius:10px;
                                     padding:.65rem .9rem; font-size:.875rem; resize:vertical; outline:none;
                                     transition:border-color .15s; font-family:inherit;"></textarea>
                </div>

                <div id="rmError" style="font-size:.82rem; color:#dc2626; margin-bottom:.6rem; display:none;"></div>

                <button id="rmSubmit" class="sa-btn sa-btn-gold" style="width:100%; justify-content:center;">
                    <i class="bi bi-send-fill me-1"></i> @L["MyEnr_SubmitReview"]
                </button>
            </div>
        </div>
    </div>
</div>
<form id="antiForgery">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        var starLabels = ['', '@L["MyEnr_Star1"]', '@L["MyEnr_Star2"]', '@L["MyEnr_Star3"]', '@L["MyEnr_Star4"]', '@L["MyEnr_Star5"]'];
        var rmRating = 0;
        var rmCourseId = 0;
        var rmModal = new bootstrap.Modal(document.getElementById('reviewModal'));

        var rmStars = document.querySelectorAll('.rm-star');
        rmStars.forEach(function(star) {
            star.addEventListener('mouseover', function() {
                var v = parseInt(this.dataset.val);
                rmStars.forEach(function(s, i) {
                    s.className = 'bi rm-star ' + (i < v ? 'bi-star-fill' : 'bi-star');
                    s.style.color = i < v ? '#f59e0b' : '#d1d5db';
                });
                document.getElementById('rmStarLabel').textContent = starLabels[v];
            });
            star.addEventListener('click', function() {
                rmRating = parseInt(this.dataset.val);
                document.getElementById('rmStarLabel').textContent = starLabels[rmRating];
            });
        });
        document.getElementById('rmStars').addEventListener('mouseleave', function() {
            rmStars.forEach(function(s, i) {
                s.className = 'bi rm-star ' + (i < rmRating ? 'bi-star-fill' : 'bi-star');
                s.style.color = i < rmRating ? '#f59e0b' : '#d1d5db';
            });
            document.getElementById('rmStarLabel').textContent = rmRating ? starLabels[rmRating] : '';
        });

        document.querySelectorAll('.btn-open-review').forEach(function(btn) {
            btn.addEventListener('click', function() {
                rmCourseId = parseInt(this.dataset.courseId);
                rmRating = 0;
                document.getElementById('rmCourseName').textContent = this.dataset.courseName;
                document.getElementById('rmComment').value = '';
                document.getElementById('rmError').style.display = 'none';
                document.getElementById('rmStarLabel').textContent = '';
                rmStars.forEach(function(s) {
                    s.className = 'bi rm-star bi-star';
                    s.style.color = '#d1d5db';
                });
                rmModal.show();
            });
        });

        document.getElementById('rmSubmit').addEventListener('click', function() {
            var errEl = document.getElementById('rmError');
            if (!rmRating) {
                errEl.textContent = '@L["MyEnr_SelectStars"]';
                errEl.style.display = 'block';
                return;
            }
            errEl.style.display = 'none';
            var token = document.querySelector('#antiForgery input[name="__RequestVerificationToken"]').value;
            var comment = document.getElementById('rmComment').value;
            this.disabled = true;
            fetch('@Url.Action("Create", "Review")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'courseId=' + rmCourseId + '&rating=' + rmRating + '&comment=' + encodeURIComponent(comment) + '&__RequestVerificationToken=' + encodeURIComponent(token)
            })
            .then(r => r.json())
            .then(function(res) {
                if (res.success) {
                    rmModal.hide();
                    location.reload();
                } else {
                    errEl.textContent = res.message;
                    errEl.style.display = 'block';
                    document.getElementById('rmSubmit').disabled = false;
                }
            });
        });
    </script>
}