@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<SchoolApp.Models.Enrollment>
@{
    ViewData["Title"] = "Khóa học của tôi";
    var studentName = Context.Session.GetString("StudentName");
    var filter = Context.Request.Query["filter"].ToString();
    if (string.IsNullOrEmpty(filter)) filter = "all";
    var allCount       = (int)(ViewBag.AllCount       ?? 0);
    var activeCount    = (int)(ViewBag.ActiveCount    ?? 0);
    var completedCount = (int)(ViewBag.CompletedCount ?? 0);
}

<style>
    .my-courses-layout {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
    }

    .my-courses-sidebar {
        width: 220px;
        flex-shrink: 0;
        position: sticky;
        top: 80px;
    }

        .my-courses-sidebar .sidebar-title {
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--text-light, #888);
            padding: .5rem 1rem .3rem;
        }

        .my-courses-sidebar .nav-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: .55rem 1rem;
            border-radius: 8px;
            color: var(--text-mid, #444);
            font-size: .9rem;
            font-weight: 500;
            text-decoration: none;
            transition: background .15s;
        }

            .my-courses-sidebar .nav-link:hover {
                background: rgba(0,0,0,.05);
            }

            .my-courses-sidebar .nav-link.active {
                background: var(--navy, #1a237e);
                color: #fff;
            }

            .my-courses-sidebar .nav-link .count-badge {
                font-size: .72rem;
                padding: .1rem .45rem;
                border-radius: 999px;
                background: rgba(255,255,255,.25);
                font-weight: 600;
            }

            .my-courses-sidebar .nav-link:not(.active) .count-badge {
                background: #e9ecef;
                color: #555;
            }

    .my-courses-content {
        flex: 1;
        min-width: 0;
    }

    @@media (max-width: 768px) {
        .my-courses-layout {
            flex-direction: column;
        }

        .my-courses-sidebar {
            width: 100%;
            position: static;
        }
    }
</style>

<div class="sa-page-hero mb-4">
    <h1 style="font-family:var(--font-display); font-size:1.8rem; color:var(--white); margin-bottom:.25rem;">
        🎓 Khóa học của tôi
    </h1>
    <p style="color:rgba(255,255,255,.55); font-size:.9rem;">
        Xin chào <strong style="color:var(--gold-light);">@studentName</strong> — danh sách khóa học bạn đã đăng ký
    </p>
</div>

@if (!Model.Any() && filter == "all")
{
    <div class="sa-card" style="text-align:center; padding:3rem 1.5rem;">
        <div style="font-size:3rem; margin-bottom:1rem;">📭</div>
        <h3 style="font-family:var(--font-display); color:var(--text-mid); margin-bottom:.5rem;">
            Bạn chưa đăng ký khóa học nào
        </h3>
        <p style="color:var(--text-light); margin-bottom:1.5rem;">
            Khám phá các khóa học đang mở và bắt đầu học ngay hôm nay!
        </p>
        <a asp-controller="Course" asp-action="Index" class="sa-btn sa-btn-gold">
            <i class="bi bi-book-fill"></i> Xem khóa học
        </a>
    </div>
}
else
{
    <div class="my-courses-layout">

        @* Sidebar *@
        <nav class="my-courses-sidebar sa-card" style="padding:.75rem 0;">
            <div class="sidebar-title">Lọc khóa học</div>

            <a href="@Url.Action("MyEnrollments", new { filter = "all" })"
               class="nav-link @(filter == "all" ? "active" : "")">
                <span><i class="bi bi-grid me-2"></i>Tất cả</span>
                <span class="count-badge">@allCount</span>
            </a>

            <a href="@Url.Action("MyEnrollments", new { filter = "inprogress" })"
               class="nav-link @(filter == "inprogress" ? "active" : "")">
                <span><i class="bi bi-play-circle me-2"></i>Đang học</span>
                <span class="count-badge">@activeCount</span>
            </a>

            <a href="@Url.Action("MyEnrollments", new { filter = "completed" })"
               class="nav-link @(filter == "completed" ? "active" : "")">
                <span><i class="bi bi-patch-check me-2"></i>Đã hoàn thành</span>
                <span class="count-badge">@completedCount</span>
            </a>

            <hr style="margin:.6rem 1rem;" />

            <div class="sidebar-title">Thống kê</div>
            <div style="padding:.5rem 1rem;">
                <div style="display:flex; justify-content:space-between; font-size:.85rem; margin-bottom:.4rem;">
                    <span style="color:var(--text-light);">Đã đăng ký</span>
                    <strong>@allCount</strong>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:.85rem; margin-bottom:.4rem;">
                    <span style="color:var(--text-light);">Hoàn thành</span>
                    <strong style="color:var(--success, #198754);">@completedCount</strong>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:.85rem;">
                    <span style="color:var(--text-light);">Đang học</span>
                    <strong style="color:var(--navy, #1a237e);">@activeCount</strong>
                </div>
                @if (allCount > 0)
                {
                    var pct = (int)Math.Round(completedCount * 100.0 / allCount);
                    <div style="margin-top:.75rem;">
                        <div style="font-size:.75rem; color:var(--text-light); margin-bottom:.25rem;">
                            Tiến độ tổng thể
                        </div>
                        <div style="background:#e9ecef; border-radius:999px; height:6px; overflow:hidden;">
                            <div style="width:@(pct)%; height:100%; background:var(--success, #198754); border-radius:999px;"></div>
                        </div>
                        <div style="font-size:.72rem; color:var(--text-light); text-align:right; margin-top:.2rem;">@pct%</div>
                    </div>
                }
            </div>
        </nav>

        @* Main content *@
        <div class="my-courses-content">

            @if (!Model.Any())
            {
                <div class="sa-card" style="text-align:center; padding:2.5rem 1.5rem;">
                    <div style="font-size:2.5rem; margin-bottom:.75rem;">
                        @(filter == "completed" ? "🏆" : "📖")
                    </div>
                    <p style="color:var(--text-light); margin:0;">
                        @(filter == "completed" ? "Bạn chưa hoàn thành khóa học nào." : "Không có khóa học đang học.")
                    </p>
                </div>
            }
            else
            {
                <div class="sa-table-wrap">
                    <table class="sa-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Khóa học</th>
                                <th>Ngày đăng ký</th>
                                <th class="text-center">Trạng thái</th>
                                <th>Ghi chú</th>
                                <th class="text-center" style="width:130px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td><strong>@item.Course?.CourseName</strong></td>
                                    <td>@item.EnrollDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        @if (item.IsCompleted)
                                        {
                                            <span class="sa-badge sa-badge-green">
                                                <i class="bi bi-check-circle me-1"></i>Đã hoàn thành
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="sa-badge sa-badge-navy">
                                                <i class="bi bi-play-circle me-1"></i>Đang học
                                            </span>
                                        }
                                    </td>
                                    <td style="color:var(--text-light);">@(item.Notes ?? "—")</td>
                                    <td class="text-center">
                                        <a asp-controller="Learn" asp-action="Course" asp-route-id="@item.CourseId"
                                           class="sa-btn sa-btn-gold" style="padding:.4rem .9rem; font-size:.85rem;">
                                            <i class="bi bi-play-fill"></i>
                                            @(item.IsCompleted ? "Xem lại" : "Vào học")
                                        </a>
                                    </td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>

                @if (filter == "all")
                {
                    <div class="d-flex justify-content-between align-items-center px-1 py-2 mt-2">
                        <small style="color:var(--text-light);">
                            Trang @Model.PageNumber / @Model.PageCount
                            (Tổng: @Model.TotalItemCount khóa học)
                        </small>
                        @Html.PagedListPager(Model,
                        page => Url.Action("MyEnrollments", new { page }),
                        new PagedListRenderOptions
                        {
                            LiElementClasses = new[] { "page-item" },
                            PageClasses = new[] { "page-link" },
                            UlElementClasses = new[] { "pagination mb-0" }
                        })
        </div>
                }
            }
        </div>
    </div>
}