@using SchoolApp.Models
@model List<Course>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SchoolApp.Resources.MyLanguage> L

@{
    string LvLabel(CourseLevel l) => l switch
    {
        CourseLevel.Basic => L["Det_LevelBasic"].Value,
        CourseLevel.Intermediate => L["Det_LevelIntermediate"].Value,
        CourseLevel.Advanced => L["Det_LevelAdvanced"].Value,
        _ => l.ToString()
    };
    string LvColor(CourseLevel l) => l switch
    {
        CourseLevel.Basic => "#16a34a",
        CourseLevel.Intermediate => "#d97706",
        CourseLevel.Advanced => "#dc2626",
        _ => "#6b7280"
    };
}

@if (Model != null && Model.Any())
{
    <div style="margin-top:2.5rem;">
        <!-- Header -->
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.25rem;">
            <h2 style="font-size:1.35rem; font-weight:700; color:var(--text-dark); margin:0;">
                @L["Trnd_Title"]
            </h2>
            <a asp-controller="Course" asp-action="Index"
               style="font-size:.85rem; color:#6d28d9; font-weight:600; text-decoration:none; display:flex; align-items:center; gap:.3rem;">
                @L["Trnd_ViewAll"] <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <!-- Carousel wrapper -->
        <div style="position:relative;">
            <!-- Prev button -->
            <button id="trendPrev" onclick="scrollTrend(-1)"
                    style="position:absolute; left:-18px; top:50%; transform:translateY(-50%);
                               z-index:2; width:36px; height:36px; border-radius:50%; border:1px solid #e5e7eb;
                               background:#fff; box-shadow:0 2px 8px rgba(0,0,0,.12); cursor:pointer;
                               display:flex; align-items:center; justify-content:center; color:#374151;">
                <i class="bi bi-chevron-left"></i>
            </button>

            <!-- Scrollable track -->
            <div id="trendTrack" style="display:flex; gap:1rem; overflow-x:hidden; scroll-behavior:smooth;
                                            padding-bottom:.5rem; scrollbar-width:none; -ms-overflow-style:none;">

                @foreach (var c in Model)
                {
                    <a asp-controller="Course" asp-action="Detail" asp-route-id="@c.CourseId"
                       style="flex:0 0 calc(25% - 12px); min-width:0; border:1px solid #e5e7eb; border-radius:10px; overflow:hidden;
                                      background:#fff; text-decoration:none; color:inherit; display:flex; flex-direction:column;
                                      box-shadow:0 1px 4px rgba(0,0,0,.06); transition:box-shadow .2s, transform .2s;"
                       onmouseenter="this.style.boxShadow='0 6px 20px rgba(0,0,0,.13)'; this.style.transform='translateY(-3px)'"
                       onmouseleave="this.style.boxShadow='0 1px 4px rgba(0,0,0,.06)'; this.style.transform='translateY(0)'">

                        <!-- Thumbnail -->
                        <div style="width:100%; height:138px; background:#f3f4f6; overflow:hidden; flex-shrink:0;">
                            @if (!string.IsNullOrEmpty(c.ThumbnailUrl))
                            {
                                <img src="@c.ThumbnailUrl" alt="@c.CourseName"
                                     style="width:100%; height:100%; object-fit:cover; display:block;" />
                            }
                            else
                            {
                                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center;">
                                    <i class="bi bi-play-btn" style="font-size:2.5rem; color:#d1d5db;"></i>
                                </div>
                            }
                        </div>

                        <!-- Body -->
                        <div style="padding:.85rem .9rem 1rem; flex:1; display:flex; flex-direction:column; gap:.45rem;">
                            <!-- Title -->
                            <div style="font-size:.9rem; font-weight:700; color:#111827; line-height:1.35;
                                                display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                @c.CourseName
                            </div>

                            <!-- Level badge + credits -->
                            <div style="display:flex; align-items:center; gap:.5rem; flex-wrap:wrap;">
                                <span style="display:inline-block; padding:.1rem .45rem; border-radius:20px; font-size:.68rem; font-weight:700;
                                                     background:@(LvColor(c.Level))18; color:@(LvColor(c.Level)); border:1px solid @(LvColor(c.Level))44;">
                                    @LvLabel(c.Level)
                                </span>
                                <span style="font-size:.72rem; color:#9ca3af;">
                                    <i class="bi bi-journal-bookmark"></i> @c.Credits @L["Det_Credits"]
                                </span>
                            </div>

                            <!-- Price -->
                            <div style="margin-top:auto; padding-top:.4rem;">
                                @if (c.Fee == 0)
                                {
                                    <span style="font-size:1rem; font-weight:800; color:#059669;">@L["Det_Free"]</span>
                                }
                                else
                                {
                                    <span style="font-size:1rem; font-weight:800; color:#111827;">
                                        @c.Fee.ToString("N0") <span style="font-size:.72rem; font-weight:400; color:#6b7280;">₫</span>
                                    </span>
                                }
                            </div>
                        </div>
                    </a>
                }

            </div>

            <!-- Next button -->
            <button id="trendNext" onclick="scrollTrend(1)"
                    style="position:absolute; right:-18px; top:50%; transform:translateY(-50%);
                               z-index:2; width:36px; height:36px; border-radius:50%; border:1px solid #e5e7eb;
                               background:#fff; box-shadow:0 2px 8px rgba(0,0,0,.12); cursor:pointer;
                               display:flex; align-items:center; justify-content:center; color:#374151;">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>

    <style>
        #trendTrack::-webkit-scrollbar {
            display: none;
        }
    </style>

    <script>
        function scrollTrend(dir) {
            var track = document.getElementById('trendTrack');
            track.scrollBy({ left: dir * track.clientWidth, behavior: 'smooth' });
        }
    </script>
}