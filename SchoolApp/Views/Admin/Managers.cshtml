@model IEnumerable<SchoolApp.Models.User>
@{
    ViewData["Title"] = L["Nav_ManageManagers"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .adm-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .adm-form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .adm-form-group.full {
                grid-column: 1 / -1;
            }

        .adm-form-label {
            font-size: .75rem;
            color: rgba(255,255,255,0.5);
        }

        .adm-btn-create {
            background: linear-gradient(135deg, #c9a84c, #a8862e);
            border: none;
            border-radius: 8px;
            color: #0d1b2a;
            font-weight: 700;
            font-size: .875rem;
            padding: 10px 24px;
            cursor: pointer;
            margin-top: 8px;
            transition: opacity .2s;
        }

            .adm-btn-create:hover {
                opacity: .85;
            }

        .adm-btn-del {
            background: rgba(248,81,73,0.12);
            border: 1px solid rgba(248,81,73,0.3);
            color: #f85149;
            border-radius: 6px;
            padding: 5px 12px;
            font-size: .78rem;
            cursor: pointer;
            transition: all .2s;
        }

            .adm-btn-del:hover {
                background: rgba(248,81,73,0.25);
            }

        .adm-btn-edit {
            background: rgba(201,168,76,0.12);
            border: 1px solid rgba(201,168,76,0.35);
            color: #c9a84c;
            border-radius: 6px;
            padding: 5px 12px;
            font-size: .78rem;
            cursor: pointer;
            transition: all .2s;
        }

            .adm-btn-edit:hover {
                background: rgba(201,168,76,0.25);
            }

        .adm-empty {
            text-align: center;
            padding: 40px;
            color: rgba(255,255,255,0.3);
        }

        @@media (max-width: 768px) {
            .adm-form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- ── PAGE HEADER ─────────────────────────────────────────── -->
<div class="adm-page-header">
    <div>
        <div class="adm-page-title">@L["Footer_Manage"] <span>Manager</span></div>
        <div class="adm-page-sub">@L["Adm_ManagerSub"]</div>
    </div>
</div>

<!-- ── FORM TẠO MANAGER ────────────────────────────────────── -->
<div class="adm-card">
    <div class="adm-card-title"><i class="bi bi-person-plus-fill"></i> @L["Adm_CreateManagerTitle"]</div>
    <form asp-action="CreateManager" asp-controller="Admin" method="post">
        @Html.AntiForgeryToken()
        <div class="adm-form-grid">
            <div class="adm-form-group">
                <label class="adm-form-label">@L["Adm_FullName"] *</label>
                <input name="FullName" class="adm-input" placeholder="Nguyễn Văn A" required minlength="2" maxlength="100" />
            </div>
            <div class="adm-form-group">
                <label class="adm-form-label">Email *</label>
                <input name="Email" type="email" class="adm-input" placeholder="manager@school.vn" required maxlength="150" />
            </div>
            <div class="adm-form-group">
                <label class="adm-form-label">@L["Adm_Password"] *</label>
                <input name="Password" type="password" class="adm-input" placeholder="@L["Register_PasswordPlaceholder"]" required minlength="6" />
            </div>
            <div class="adm-form-group">
                <label class="adm-form-label">@L["Adm_Phone"]</label>
                <input name="Phone" class="adm-input" placeholder="0901234567" maxlength="15" />
            </div>
            <div class="adm-form-group full" style="align-items:flex-start;">
                <button type="submit" class="adm-btn-create">
                    <i class="bi bi-plus-circle"></i> @L["Adm_CreateManagerBtn"]
                </button>
            </div>
        </div>
    </form>
</div>

<!-- ── DANH SÁCH MANAGER ───────────────────────────────────── -->
<div class="adm-card">
    <div class="adm-card-title">
        <i class="bi bi-people-fill"></i>
        @L["Adm_ManagerListTitle"] (@Model.Count() @L["Adm_Accounts"])
    </div>

    @if (!Model.Any())
    {
        <div class="adm-empty">
            <i class="bi bi-person-x" style="font-size:2.5rem;display:block;margin-bottom:8px;"></i>
            @L["Adm_NoManagers"]
        </div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table adm-table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["Adm_FullName"]</th>
                        <th>Email</th>
                        <th>@L["Adm_Phone"]</th>
                        <th>@L["Adm_ColCreatedDate"]</th>
                        <th>@L["Adm_ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int idx = 1;
                    }
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td style="color:rgba(255,255,255,0.35);">@idx</td>
                            <td style="font-weight:600;">@m.FullName</td>
                            <td style="color:rgba(201,168,76,0.8);">@m.Email</td>
                            <td>@(m.Phone ?? "—")</td>
                            <td>@m.RegisteredDate.ToString("dd/MM/yyyy")</td>
                            <td style="white-space:nowrap;">
                                <button type="button" class="adm-btn-edit"
                                        onclick="openEditModal(@m.UserId)">
                                    <i class="bi bi-pencil"></i> @L["Btn_Edit"]
                                </button>
                                <form asp-action="DeleteManager" asp-controller="Admin" method="post" style="display:inline;"
                                      onsubmit="return confirm('@L["Adm_DeleteConfirm"] @m.FullName?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.UserId" />
                                    <button type="submit" class="adm-btn-del">
                                        <i class="bi bi-trash"></i> @L["Btn_Delete"]
                                    </button>
                                </form>
                            </td>
                        </tr>
                        idx++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ── MODAL SỬA MANAGER ───────────────────────────────── -->
<div class="modal fade" id="editManagerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
        <div class="modal-content" style="background:#0d1b2a; border:1px solid rgba(255,255,255,.1); border-radius:12px; box-shadow:0 20px 60px rgba(0,0,0,.5);">
            <div class="modal-header" style="background:linear-gradient(135deg,#14233d,#1e3356); border-bottom:1px solid rgba(255,255,255,.08); padding:1.25rem 1.5rem;">
                <h5 style="font-size:1.05rem; font-weight:700; color:#c9a84c; margin:0;">
                    <i class="bi bi-pencil-square me-2"></i>@L["Adm_EditManagerTitle"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:1.5rem;">
                <div id="editManagerResult" style="margin-bottom:.75rem;"></div>
                <form id="editManagerForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editUserId" name="userId" />
                    <div class="adm-form-grid">
                        <div class="adm-form-group full">
                            <label class="adm-form-label">@L["Adm_EmailReadOnly"]</label>
                            <input id="editEmail" class="adm-input" readonly
                                   style="background:rgba(255,255,255,.04); color:rgba(255,255,255,.4); cursor:default;" />
                        </div>
                        <div class="adm-form-group full">
                            <label class="adm-form-label">@L["Adm_FullName"] *</label>
                            <input id="editFullName" name="fullName" class="adm-input"
                                   placeholder="Nguyễn Văn A" maxlength="100" />
                            <div id="err-fullName" style="color:#f85149; font-size:.75rem; margin-top:.25rem;"></div>
                        </div>
                        <div class="adm-form-group full">
                            <label class="adm-form-label">@L["Adm_Phone"]</label>
                            <input id="editPhone" name="phone" class="adm-input"
                                   placeholder="0901234567" maxlength="15" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="border-top:1px solid rgba(255,255,255,.08); padding:1rem 1.5rem; background:rgba(255,255,255,.02);">
                <button type="button" class="adm-btn adm-btn-sm" data-bs-dismiss="modal"
                        style="background:rgba(255,255,255,.07); color:rgba(255,255,255,.6); border:1px solid rgba(255,255,255,.12);">
                    @L["Btn_Cancel"]
                </button>
                <button type="button" id="btnSaveManager" class="adm-btn-create" style="margin-top:0;">
                    <i class="bi bi-check-lg me-1"></i> @L["Btn_Save"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
    <script>
        var _admLoading = '@L["Adm_Loading"]';
        function openEditModal(id) {
            $('#editManagerResult').html('');
            $('#err-fullName').text('');
            $('#editFullName').val('');
            $('#editEmail').val(_admLoading);
            $('#editPhone').val('');
            $('#editManagerModal').modal('show');

            $.get('@Url.Action("GetManager", "Admin")/' + id, function (data) {
                $('#editUserId').val(data.userId);
                $('#editFullName').val(data.fullName);
                $('#editEmail').val(data.email);
                $('#editPhone').val(data.phone);
            }).fail(function () {
                $('#editManagerModal').modal('hide');
                alert('@L["Adm_LoadError"]');
            });
        }

        $('#btnSaveManager').on('click', function () {
            var btn = $(this);
            $('#editManagerResult').html('');
            $('#err-fullName').text('');

            var fullName = $('#editFullName').val().trim();
            if (fullName.length < 2) {
                $('#err-fullName').text('@L["Adm_FullNameMin"]');
                return;
            }

            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> @L["Adm_Saving"]');

            var token = $('input[name="__RequestVerificationToken"]').first().val();
            $.ajax({
                url: '@Url.Action("EditManagerAjax", "Admin")',
                type: 'POST',
                data: {
                    userId: $('#editUserId').val(),
                    fullName: fullName,
                    phone: $('#editPhone').val().trim(),
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i> @L["Btn_Save"]');
                    if (res.success) {
                        $('#editManagerModal').modal('hide');
                        location.reload();
                    } else {
                        $('#editManagerResult').html(
                            '<div style="background:rgba(248,81,73,.12); border:1px solid rgba(248,81,73,.3); color:#f85149; border-radius:6px; padding:.5rem .75rem; font-size:.82rem;">' +
                            '<i class="bi bi-exclamation-circle me-1"></i>' + $('<span>').text(res.message).html() + '</div>'
                        );
                    }
                },
                error: function () {
                    btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i> @L["Btn_Save"]');
                    alert('@L["Adm_ServerError"]');
                }
            });
        });
    </script>
}