@model SchoolApp.DTOs.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Hệ thống";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var monthLabelsJson = System.Text.Json.JsonSerializer.Serialize(Model.MonthLabels);
    var newStudentsJson = System.Text.Json.JsonSerializer.Serialize(Model.NewStudentsByMonth);
    var revenueJson = System.Text.Json.JsonSerializer.Serialize(Model.RevenueByMonth);
    var topCourseNamesJson = System.Text.Json.JsonSerializer.Serialize(Model.TopCourseNames);
    var topCourseEnrollJson = System.Text.Json.JsonSerializer.Serialize(Model.TopCourseEnrollments);
}

@section Styles {
    <style>
        /* STAT CARDS — adm-stat (alias cho adm-stat-card với layout dọc) */
        .adm-stat {
            background: linear-gradient(135deg, #0d1b2a, #152435);
            border: 1px solid rgba(201,168,76,0.15);
            border-radius: 14px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        /* CHART GRID — dùng .adm-charts thay vì .adm-chart-grid */
        .adm-charts {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .adm-chart-card.full {
            grid-column: 1 / -1;
        }

        .adm-chart-canvas {
            width: 100% !important;
        }

        /* TABLE CARD WRAPPER */
        .adm-table-card {
            background: #0d1b2a;
            border: 1px solid rgba(201,168,76,0.15);
            border-radius: 14px;
            padding: 20px;
            margin-bottom: 20px;
            overflow-x: auto;
        }

        /* PAYMENT STATUS BADGES */
        .badge-paid {
            background: rgba(46,160,67,0.15);
            color: #3fb950;
            border-radius: 20px;
            padding: 2px 10px;
            font-size: .75rem;
        }

        .badge-pending {
            background: rgba(210,153,34,0.15);
            color: #e3b341;
            border-radius: 20px;
            padding: 2px 10px;
            font-size: .75rem;
        }

        .badge-cancelled {
            background: rgba(248,81,73,0.15);
            color: #f85149;
            border-radius: 20px;
            padding: 2px 10px;
            font-size: .75rem;
        }

        @@media (max-width: 900px) {
            .adm-charts {
                grid-template-columns: 1fr;
            }

            .adm-chart-card.full {
                grid-column: auto;
            }
        }
    </style>
}

<!-- ── PAGE HEADER ─────────────────────────────────────────── -->
<div class="adm-page-header">
    <div>
        <div class="adm-page-title">Dashboard <span>Hệ thống</span></div>
        <div class="adm-page-sub">Tổng quan toàn bộ hoạt động — cập nhật @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
</div>

<!-- ── STAT CARDS ──────────────────────────────────────────── -->
<div class="adm-stats">
    <div class="adm-stat">
        <div class="adm-stat-icon" style="background:rgba(88,166,255,0.12);color:#58a6ff;"><i class="bi bi-people-fill"></i></div>
        <div class="adm-stat-label">Học viên</div>
        <div class="adm-stat-value">@Model.TotalStudents</div>
        <div class="adm-stat-sub">Tài khoản Student</div>
    </div>
    <div class="adm-stat">
        <div class="adm-stat-icon" style="background:rgba(91,157,217,0.12);color:#5b9dd9;"><i class="bi bi-person-gear"></i></div>
        <div class="adm-stat-label">Manager</div>
        <div class="adm-stat-value">@Model.TotalManagers</div>
        <div class="adm-stat-sub">Tài khoản quản lý</div>
    </div>
    <div class="adm-stat">
        <div class="adm-stat-icon" style="background:rgba(201,168,76,0.12);color:#c9a84c;"><i class="bi bi-book-fill"></i></div>
        <div class="adm-stat-label">Khóa học</div>
        <div class="adm-stat-value">@Model.TotalCourses</div>
        <div class="adm-stat-sub">Tổng số khóa học</div>
    </div>
    <div class="adm-stat">
        <div class="adm-stat-icon" style="background:rgba(63,185,80,0.12);color:#3fb950;"><i class="bi bi-journal-check"></i></div>
        <div class="adm-stat-label">Đăng ký</div>
        <div class="adm-stat-value">@Model.TotalEnrollments</div>
        <div class="adm-stat-sub">Lượt đăng ký học</div>
    </div>
    <div class="adm-stat">
        <div class="adm-stat-icon" style="background:rgba(248,81,73,0.12);color:#f85149;"><i class="bi bi-cash-coin"></i></div>
        <div class="adm-stat-label">Doanh thu</div>
        <div class="adm-stat-value" style="font-size:1.2rem;">@Model.TotalRevenue.ToString("N0") ₫</div>
        <div class="adm-stat-sub">Thanh toán thành công</div>
    </div>
</div>

<!-- ── CHARTS ROW 1 ────────────────────────────────────────── -->
<div class="adm-charts">
    <div class="adm-chart-card">
        <div class="adm-chart-title"><i class="bi bi-person-plus"></i> Học viên đăng ký mới (12 tháng)</div>
        <canvas id="chartStudents" height="220" class="adm-chart-canvas"></canvas>
    </div>
    <div class="adm-chart-card">
        <div class="adm-chart-title"><i class="bi bi-cash-stack"></i> Doanh thu theo tháng</div>
        <canvas id="chartRevenue" height="220" class="adm-chart-canvas"></canvas>
    </div>
</div>

<!-- ── CHARTS ROW 2 ────────────────────────────────────────── -->
<div class="adm-charts">
    <div class="adm-chart-card">
        <div class="adm-chart-title"><i class="bi bi-trophy"></i> Top khóa học phổ biến</div>
        <canvas id="chartTopCourses" height="260" class="adm-chart-canvas"></canvas>
    </div>
    <div class="adm-chart-card">
        <div class="adm-chart-title"><i class="bi bi-pie-chart"></i> Trạng thái thanh toán</div>
        <canvas id="chartPaymentStatus" height="260" class="adm-chart-canvas"></canvas>
    </div>
</div>

<!-- ── RECENT ENROLLMENTS ──────────────────────────────────── -->
<div class="adm-table-card">
    <div class="adm-chart-title"><i class="bi bi-clock-history"></i> Đăng ký học gần nhất</div>
    <table class="adm-table">
        <thead>
            <tr>
                <th>Học viên</th>
                <th>Khóa học</th>
                <th>Ngày đăng ký</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.RecentEnrollments.Any())
            {
                <tr><td colspan="4" style="text-align:center;color:rgba(255,255,255,0.3);padding:24px;">Chưa có dữ liệu</td></tr>
            }
            @foreach (var e in Model.RecentEnrollments)
            {
                <tr>
                    <td>@e.StudentName</td>
                    <td>@e.CourseName</td>
                    <td>@e.EnrollDate.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ── RECENT PAYMENTS ────────────────────────────────────── -->
<div class="adm-table-card">
    <div class="adm-chart-title"><i class="bi bi-credit-card"></i> Thanh toán gần nhất</div>
    <table class="adm-table">
        <thead>
            <tr>
                <th>Học viên</th>
                <th>Khóa học</th>
                <th>Số tiền</th>
                <th>Trạng thái</th>
                <th>Thời gian</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.RecentPayments.Any())
            {
                <tr><td colspan="5" style="text-align:center;color:rgba(255,255,255,0.3);padding:24px;">Chưa có dữ liệu</td></tr>
            }
            @foreach (var p in Model.RecentPayments)
            {
                <tr>
                    <td>@p.StudentName</td>
                    <td>@p.CourseName</td>
                    <td>@p.Amount.ToString("N0") ₫</td>
                    <td>
                        @if (p.Status == "PAID")
                        {
                            <span class="badge-paid">PAID</span>
                        }
                        else if (p.Status == "PENDING")
                        {

                            <span class="badge-pending">PENDING</span>
                        }
                        else
                        {

                            <span class="badge-cancelled">CANCELLED</span>
                        }
                    </td>
                    <td>@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.color = 'rgba(255,255,255,0.55)';
        Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';

        const monthLabels = @Html.Raw(monthLabelsJson);
        const gold = '#c9a84c';
        const blue = '#58a6ff';

        // Chart 1: Học viên mới - Line
        new Chart(document.getElementById('chartStudents'), {
            type: 'line',
            data: {
                labels: monthLabels,
                datasets: [{
                    label: 'Học viên mới',
                    data: @Html.Raw(newStudentsJson),
                    borderColor: blue,
                    backgroundColor: 'rgba(88,166,255,0.1)',
                    borderWidth: 2.5,
                    pointBackgroundColor: blue,
                    pointRadius: 4,
                    tension: 0.35,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: 'rgba(255,255,255,0.05)' } },
                    y: { grid: { color: 'rgba(255,255,255,0.05)' }, beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });

        // Chart 2: Doanh thu - Bar
        new Chart(document.getElementById('chartRevenue'), {
            type: 'bar',
            data: {
                labels: monthLabels,
                datasets: [{
                    label: 'Doanh thu (₫)',
                    data: @Html.Raw(revenueJson),
                    backgroundColor: 'rgba(201,168,76,0.6)',
                    borderColor: gold,
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: 'rgba(255,255,255,0.05)' } },
                    y: {
                        grid: { color: 'rgba(255,255,255,0.05)' },
                        beginAtZero: true,
                        ticks: {
                            callback: v => v >= 1000000
                                ? (v / 1000000).toFixed(1) + 'M'
                                : v >= 1000 ? (v / 1000).toFixed(0) + 'K' : v
                        }
                    }
                }
            }
        });

        // Chart 3: Top courses - Horizontal bar
        new Chart(document.getElementById('chartTopCourses'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(topCourseNamesJson),
                datasets: [{
                    label: 'Lượt đăng ký',
                    data: @Html.Raw(topCourseEnrollJson),
                    backgroundColor: [
                        'rgba(201,168,76,0.7)','rgba(88,166,255,0.7)','rgba(63,185,80,0.7)',
                        'rgba(248,81,73,0.7)','rgba(210,153,34,0.7)','rgba(161,119,245,0.7)',
                        'rgba(255,123,0,0.7)','rgba(50,199,199,0.7)'
                    ],
                    borderRadius: 6,
                    borderWidth: 0
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: 'rgba(255,255,255,0.05)' }, beginAtZero: true, ticks: { precision: 0 } },
                    y: { grid: { display: false } }
                }
            }
        });

        // Chart 4: Payment status - Doughnut
        new Chart(document.getElementById('chartPaymentStatus'), {
            type: 'doughnut',
            data: {
                labels: ['PAID', 'PENDING', 'CANCELLED'],
                datasets: [{
                    data: [@Model.PaidCount, @Model.PendingCount, @Model.CancelledCount],
                    backgroundColor: ['rgba(63,185,80,0.8)','rgba(227,179,65,0.8)','rgba(248,81,73,0.8)'],
                    borderColor: ['#3fb950','#e3b341','#f85149'],
                    borderWidth: 1.5,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                cutout: '65%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { padding: 16, boxWidth: 12, boxHeight: 12 }
                    }
                }
            }
        });
    </script>
}