@using SchoolApp.Models
@model IEnumerable<QuizAttempt>

@{
    ViewData["Title"] = "Lịch sử làm bài";
    var quiz = (Quiz)ViewData["Quiz"]!;
}

<div class="container mt-4">

    @if (TempData["QuizError"] != null)
    {
        <div class="alert alert-warning">@TempData["QuizError"]</div>
    }

    <div class="sa-card">
        <div style="padding:1rem 1.25rem; border-bottom:1px solid var(--smoke); display:flex; align-items:center; gap:.6rem;">
            <i class="bi bi-clock-history" style="color:var(--gold); font-size:1.1rem;"></i>
            <strong style="font-size:1rem;">Lịch sử: @quiz.Title</strong>
        </div>
        <div style="padding:1.25rem;">
            @if (!Model.Any())
            {
                <div style="text-align:center; padding:3rem 1rem; color:var(--text-light);">
                    <i class="bi bi-inbox" style="font-size:2.5rem; display:block; margin-bottom:.75rem;"></i>
                    Chưa có lượt làm bài nào.
                    <div class="mt-3">
                        <a href="@Url.Action("Take", new { id = quiz.QuizId })" class="sa-btn sa-btn-gold">
                            <i class="bi bi-play-circle"></i> Bắt đầu làm bài
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="sa-table-wrap">
                    <table class="sa-table">
                        <thead>
                            <tr>
                                <th class="text-center">Lần</th>
                                <th>Bắt đầu</th>
                                <th>Thời gian làm</th>
                                <th class="text-center">Điểm</th>
                                <th class="text-center">Phần trăm</th>
                                <th class="text-center">Kết quả</th>
                                <th class="text-center">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model)
                            {
                                int p = a.MaxScore > 0
                                ? (int)Math.Round((double)a.Score * 100 / a.MaxScore)
                                : 0;
                                <tr>
                                    <td class="text-center" style="font-weight:700;">#@a.AttemptNumber</td>
                                    <td>@a.StartedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</td>
                                    <td>
                                        @if (a.FinishedAt.HasValue)
                                        {
                                            var dur = a.FinishedAt.Value - a.StartedAt;
                                            @($"{(int)dur.TotalMinutes}p {dur.Seconds}s")
                                        }
                                        else
                                        {
                                            <span class="sa-badge sa-badge-gold">Chưa hoàn thành</span>
                                        }
                                    </td>
                                    <td class="text-center">@a.Score / @a.MaxScore</td>
                                    <td class="text-center" style="font-weight:700; color:@(p >= quiz.PassingScore ? "var(--success)" : "var(--danger)");">@p%</td>
                                    <td class="text-center">
                                        @if (a.Passed)
                                        {
                                            <span class="sa-badge sa-badge-green"><i class="bi bi-check-lg"></i> Đạt</span>
                                        }
                                        else
                                        {
                                            <span class="sa-badge sa-badge-red"><i class="bi bi-x-lg"></i> Chưa đạt</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Result", new { id = a.QuizAttemptId })"
                                           class="sa-btn sa-btn-outline" style="padding:.35rem .8rem; font-size:.82rem;">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                int totalDone = Model.Count();
                int remaining = quiz.MaxAttempts > 0 ? quiz.MaxAttempts - totalDone : -1;
                bool canRetry = quiz.AllowRetry && (remaining != 0);

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <small style="color:var(--text-light);">
                        Đã làm: @totalDone lượt
                        @if (remaining > 0)
                        {
                            <span>· Còn lại: @remaining lượt</span>
                        }
                        @if (remaining == -1)
                        {
                            <span>· Không giới hạn</span>
                        }
                    </small>
                    @if (canRetry)
                    {
                        <a href="@Url.Action("Take", new { id = quiz.QuizId })" class="sa-btn sa-btn-gold">
                            <i class="bi bi-arrow-repeat"></i> Làm lại
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>