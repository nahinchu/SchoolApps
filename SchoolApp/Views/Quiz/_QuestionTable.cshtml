@using SchoolApp.Models
@model IEnumerable<Question>

<div class="adm-table-wrap">
    <table class="adm-table adm-table-bordered" id="questionsTable">
        <thead>
            <tr>
                <th style="width:40px;"></th>
                <th class="text-center" style="width:60px;">Thứ tự</th>
                <th>Nội dung câu hỏi</th>
                <th style="width:140px;">Loại</th>
                <th class="text-center" style="width:80px;">Điểm</th>
                <th class="text-center" style="width:80px;">Đáp án</th>
                <th class="text-center" style="width:160px;">Thao tác</th>
            </tr>
        </thead>
        <tbody id="questionsTbody">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" style="text-align:center; padding:2.5rem; color:rgba(255,255,255,0.3);">
                        <i class="bi bi-question-circle" style="font-size:2rem; display:block; margin-bottom:.5rem;"></i>
                        Chưa có câu hỏi nào. Hãy thêm câu hỏi đầu tiên!
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr data-question-id="@item.QuestionId">
                        <td class="text-center drag-handle" style="cursor:grab; color:rgba(255,255,255,0.25);" title="Kéo để đổi thứ tự">
                            <i class="bi bi-grip-vertical"></i>
                        </td>
                        <td class="text-center order-cell" style="font-weight:700;">@item.OrderIndex</td>
                        <td>@item.Content</td>
                        <td>
                            @switch (item.Type)
                            {
                                case SchoolApp.Models.Enums.QuestionType.SingleChoice:
                                    <span class="adm-badge adm-badge-info">Một đáp án</span>
                                    break;
                                case SchoolApp.Models.Enums.QuestionType.MultiChoice:
                                    <span class="adm-badge adm-badge-warning">Nhiều đáp án</span>
                                    break;
                                case SchoolApp.Models.Enums.QuestionType.TrueFalse:
                                    <span class="adm-badge adm-badge-gold">Đúng/Sai</span>
                                    break;
                            }
                        </td>
                        <td class="text-center">@item.Points</td>
                        <td class="text-center">@item.Options.Count</td>
                        <td class="text-center" style="white-space:nowrap;">
                            <button class="adm-btn adm-btn-warning adm-btn-sm me-1" onclick="editQuestion(@item.QuestionId)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="adm-btn adm-btn-danger adm-btn-sm me-1" onclick="deleteQuestion(@item.QuestionId)">
                                <i class="bi bi-trash"></i>
                            </button>
                            <button class="adm-btn adm-btn-success adm-btn-sm"
                                    onclick="copyToBank(@item.QuestionId)"
                                    title="Lưu vào ngân hàng câu hỏi">
                                <i class="bi bi-bank"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>