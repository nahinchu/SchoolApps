@using SchoolApp.Models
@using SchoolApp.Models.Enums
@model Quiz

@{
    ViewData["Title"] = L["Qt_Title"].Value;
    int attemptCount = (int)(ViewData["AttemptCount"] ?? 0);
    int attemptsRemaining = (int)(ViewData["AttemptsRemaining"] ?? -1);
}

<style>
    .qt-wrap {
        max-width: 860px;
        margin: 2rem auto;
        padding: 0 1rem 4rem;
    }

    /* ---- Header banner ---- */
    .qt-header {
        background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
        border-radius: var(--radius-md);
        padding: 1.6rem 2rem;
        color: var(--white);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
        box-shadow: var(--shadow-md);
    }

    .qt-header-title {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: .25rem;
    }

    .qt-header-desc {
        font-size: .88rem;
        color: rgba(255,255,255,.7);
        margin-bottom: .75rem;
    }

    .qt-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem .9rem;
        font-size: .82rem;
        color: rgba(255,255,255,.75);
    }

    .qt-meta i { margin-right: .3rem; }

    .qt-timer {
        background: rgba(255,255,255,.12);
        border: 1.5px solid rgba(255,255,255,.25);
        border-radius: var(--radius-sm);
        padding: .6rem 1.1rem;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: .04em;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: .5rem;
        transition: background .3s, border-color .3s;
    }

    .qt-timer.warning {
        background: rgba(201,168,76,.25);
        border-color: var(--gold);
        color: var(--gold-light);
    }

    .qt-timer.danger {
        background: rgba(192,57,43,.3);
        border-color: #e74c3c;
        color: #ff8080;
    }

    /* ---- Question card ---- */
    .qt-question {
        background: var(--white);
        border-radius: var(--radius-md);
        border: 1px solid var(--smoke);
        padding: 1.4rem 1.6rem;
        margin-bottom: 1.1rem;
        box-shadow: var(--shadow-sm);
        transition: box-shadow .2s;
    }

    .qt-question:hover { box-shadow: var(--shadow-md); }

    .qt-q-num {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--gold);
        margin-bottom: .35rem;
    }

    .qt-q-content {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-dark);
        line-height: 1.5;
        margin-bottom: .75rem;
    }

    .qt-q-badges {
        display: flex;
        gap: .4rem;
        margin-bottom: .85rem;
    }

    .qt-badge {
        font-size: .72rem;
        font-weight: 600;
        padding: .2rem .55rem;
        border-radius: 50px;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
    }

    .qt-badge-pts {
        background: var(--gold-pale);
        color: var(--gold);
    }

    .qt-badge-multi {
        background: #fff3cd;
        color: #856404;
    }

    /* ---- Options ---- */
    .qt-option {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .65rem 1rem;
        border-radius: var(--radius-sm);
        border: 1.5px solid var(--smoke);
        cursor: pointer;
        transition: background .15s, border-color .15s;
        margin-bottom: .5rem;
        user-select: none;
    }

    .qt-option:hover { background: var(--off-white); border-color: var(--gold-light); }

    .qt-option input[type=radio],
    .qt-option input[type=checkbox] { display: none; }

    .qt-option-dot {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 2px solid var(--text-light);
        flex-shrink: 0;
        transition: border-color .15s, background .15s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .qt-option.is-check .qt-option-dot {
        border-radius: 4px;
    }

    .qt-option.selected {
        background: #f0f7ff;
        border-color: #3b82f6;
    }

    .qt-option.selected .qt-option-dot {
        border-color: #3b82f6;
        background: #3b82f6;
    }

    .qt-option.selected .qt-option-dot::after {
        content: '';
        display: block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: white;
    }

    .qt-option.is-check.selected .qt-option-dot::after {
        content: '';
        width: 9px;
        height: 6px;
        border-radius: 0;
        background: transparent;
        border-left: 2px solid white;
        border-bottom: 2px solid white;
        transform: rotate(-45deg) translate(1px, -1px);
    }

    .qt-option-label { font-size: .93rem; color: var(--text-dark); }

    /* ---- Footer bar ---- */
    .qt-footer {
        position: fixed;
        bottom: 0; left: 0; right: 0;
        background: var(--white);
        border-top: 1px solid var(--smoke);
        padding: .85rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 100;
        box-shadow: 0 -4px 16px rgba(13,27,42,.08);
    }

    .qt-progress-text {
        font-size: .88rem;
        color: var(--text-mid);
    }

    .qt-progress-text strong {
        color: var(--text-dark);
        font-size: 1rem;
    }

    .qt-btn-clear {
        background: transparent;
        border: 1.5px solid var(--smoke);
        color: var(--text-mid);
        border-radius: var(--radius-sm);
        padding: .5rem 1.1rem;
        font-size: .88rem;
        cursor: pointer;
        transition: border-color .2s, color .2s;
        display: flex;
        align-items: center;
        gap: .4rem;
    }

    .qt-btn-clear:hover { border-color: var(--danger); color: var(--danger); }

    .qt-btn-submit {
        background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
        color: var(--navy);
        border: none;
        border-radius: var(--radius-sm);
        padding: .6rem 1.8rem;
        font-size: .95rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: .45rem;
        transition: opacity .2s, transform .15s;
        box-shadow: 0 2px 8px rgba(201,168,76,.35);
    }

    .qt-btn-submit:hover { opacity: .92; transform: translateY(-1px); }
    .qt-btn-submit:disabled { opacity: .6; cursor: not-allowed; transform: none; }

    .qt-autosave {
        font-size: .78rem;
        color: var(--success);
        display: none;
        align-items: center;
        gap: .3rem;
    }
</style>

<div class="qt-wrap">

    @* ---- Header ---- *@
    <div class="qt-header">
        <div>
            <div class="qt-header-title">@Model.Title</div>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="qt-header-desc">@Model.Description</div>
            }
            <div class="qt-meta">
                <span><i class="bi bi-list-check"></i>@Model.Questions.Count @L["Lrn_QuestionSuffix"]</span>
                @if (Model.TimeLimitMinutes > 0)
                {
                    <span><i class="bi bi-clock"></i>@Model.TimeLimitMinutes @L["Qt_MinUnit"]</span>
                }
                <span><i class="bi bi-trophy"></i>@L["Qt_Passing"] @Model.PassingScore%</span>
                @if (attemptsRemaining > 0)
                {
                    <span><i class="bi bi-arrow-repeat"></i>@L["Adm_Remaining"] @attemptsRemaining @L["Qt_AttemptsLeft"]</span>
                }
                else if (attemptsRemaining == -1 && Model.AllowRetry)
                {
                    <span><i class="bi bi-arrow-repeat"></i>@L["Qt_Unlimited"]</span>
                }
            </div>
        </div>
        @if (Model.TimeLimitMinutes > 0)
        {
            <div id="timerBox" class="qt-timer">
                <i class="bi bi-stopwatch"></i><span id="timerDisplay">--:--</span>
            </div>
        }
    </div>

    @* ---- Question list ---- *@
    <form id="quizTakeForm">
        @Html.AntiForgeryToken()

        @foreach (var q in Model.Questions.OrderBy(q => q.OrderIndex))
        {
            var isMulti = q.Type == QuestionType.MultiChoice;
            var inputType = isMulti ? "checkbox" : "radio";

            <div class="qt-question question-block" data-question-id="@q.QuestionId" data-question-type="@((int)q.Type)">
                <div class="qt-q-num">@L["Qt_QuestionLabel"] @q.OrderIndex</div>
                <div class="qt-q-content">@q.Content</div>
                <div class="qt-q-badges">
                    <span class="qt-badge qt-badge-pts"><i class="bi bi-star-fill"></i>@q.Points @L["Qt_PointsUnit"]</span>
                    @if (isMulti)
                    {
                        <span class="qt-badge qt-badge-multi"><i class="bi bi-check2-all"></i>@L["Qt_MultiSelectHint"]</span>
                    }
                </div>

                @foreach (var opt in q.Options.OrderBy(o => o.OrderIndex))
                {
                    <label class="qt-option @(isMulti ? "is-check" : "")" data-opt-id="@opt.AnswerOptionId">
                        <input type="@inputType"
                               class="quiz-option"
                               name="question_@q.QuestionId"
                               value="@opt.AnswerOptionId"
                               id="opt_@opt.AnswerOptionId">
                        <span class="qt-option-dot"></span>
                        <span class="qt-option-label">@opt.Content</span>
                    </label>
                }
            </div>
        }
    </form>
</div>

@* ---- Sticky footer ---- *@
<div class="qt-footer">
    <div class="qt-progress-text">
        <strong id="answeredCount">0</strong> / @Model.Questions.Count @L["Qt_AnsweredSuffix"]
        <span id="autosaveStatus" class="qt-autosave ms-3">
            <i class="bi bi-cloud-check"></i> @L["Qt_DraftSaved"]
        </span>
    </div>
    <div style="display:flex; gap:.6rem; align-items:center;">
        <button type="button" class="qt-btn-clear" onclick="clearDraft()">
            <i class="bi bi-eraser"></i> @L["Qt_ClearDraft"]
        </button>
        <button type="button" id="btnSubmitQuiz" class="qt-btn-submit" onclick="submitQuiz(@Model.QuizId)">
            <i class="bi bi-check-circle-fill"></i> @L["Qt_Submit"]
        </button>
    </div>
</div>

@section Scripts {
    <script>
        const QUIZ_ID = @Model.QuizId;
        const TIME_LIMIT_MIN = @Model.TimeLimitMinutes;
        const TOTAL_QUESTIONS = @Model.Questions.Count;
        const DRAFT_KEY = `quiz_draft_${QUIZ_ID}`;
        const START_KEY = `quiz_start_${QUIZ_ID}`;

        var _qtNoAnswers        = '@L["Qt_NoAnswers"]';
        var _qtUnansweredSuffix = '@L["Qt_UnansweredSuffix"]';
        var _qtSubmitConfirm    = '@L["Qt_SubmitConfirm"]';
        var _qtSubmitting       = '<span class="spinner-border spinner-border-sm"></span> @L["Qt_Submitting"]';
        var _qtSubmitBtn        = '<i class="bi bi-check-circle-fill"></i> @L["Qt_Submit"]';
        var _qtConnError        = '@L["Qt_ConnError"]';
        var _qtTimeUp           = '@L["Qt_TimeUp"]';
        var _qtClearConfirm     = '@L["Qt_ClearConfirm"]';
        var _qtDraftCleared     = '@L["Qt_DraftCleared"]';
        var _qtDraftSuffix      = '@L["Qt_DraftRestoredSuffix"]';

        let submitted = false;
        let timerInterval = null;

        // ---- Custom option toggle ----
        document.querySelectorAll('.qt-option').forEach(function (label) {
            label.addEventListener('click', function () {
                const input = this.querySelector('input');
                if (!input) return;
                const isCheckbox = input.type === 'checkbox';

                if (isCheckbox) {
                    input.checked = !input.checked;
                    this.classList.toggle('selected', input.checked);
                } else {
                    const name = input.name;
                    document.querySelectorAll(`input[name="${name}"]`).forEach(function (r) {
                        r.checked = false;
                        r.closest('.qt-option').classList.remove('selected');
                    });
                    input.checked = true;
                    this.classList.add('selected');
                }
                updateAnsweredCount();
                saveDraft();
            });
        });

        // ---- Toast ----
        function showToast(message, type) {
            type = type || 'success';
            const cls = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
            const el = document.createElement('div');
            el.className = `alert ${cls} alert-dismissible fade show`;
            el.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:9999;min-width:300px;box-shadow:0 4px 16px rgba(0,0,0,.15);';
            el.innerHTML = `<i class="bi ${icon}"></i> ${message}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
            document.body.appendChild(el);
            setTimeout(function () { el.remove(); }, 3500);
        }

        function getToken() {
            return document.querySelector('#quizTakeForm input[name="__RequestVerificationToken"]').value;
        }

        // ---- Answer counter ----
        function updateAnsweredCount() {
            const blocks = document.querySelectorAll('.question-block');
            let count = 0;
            blocks.forEach(function (b) {
                if (b.querySelector('.quiz-option:checked')) count++;
            });
            document.getElementById('answeredCount').textContent = count;
        }

        // ---- Draft ----
        function collectAnswers() {
            const answers = {};
            document.querySelectorAll('.question-block').forEach(function (b) {
                const qId = b.dataset.questionId;
                const selected = [];
                b.querySelectorAll('.quiz-option:checked').forEach(function (i) {
                    selected.push(parseInt(i.value));
                });
                if (selected.length > 0) answers[qId] = selected;
            });
            return answers;
        }

        function saveDraft() {
            try {
                localStorage.setItem(DRAFT_KEY, JSON.stringify({ answers: collectAnswers(), savedAt: new Date().toISOString() }));
                const el = document.getElementById('autosaveStatus');
                el.style.display = 'inline-flex';
                setTimeout(function () { el.style.display = 'none'; }, 2000);
            } catch (e) {}
        }

        function restoreDraft() {
            try {
                const raw = localStorage.getItem(DRAFT_KEY);
                if (!raw) return;
                const draft = JSON.parse(raw);
                if (!draft.answers) return;
                let restored = 0;
                Object.keys(draft.answers).forEach(function (qId) {
                    draft.answers[qId].forEach(function (optId) {
                        const input = document.getElementById('opt_' + optId);
                        if (input) {
                            input.checked = true;
                            input.closest('.qt-option').classList.add('selected');
                            restored++;
                        }
                    });
                });
                if (restored > 0) {
                    showToast(restored + ' ' + _qtDraftSuffix, 'success');
                    updateAnsweredCount();
                }
            } catch (e) {}
        }

        function clearDraft() {
            if (!confirm(_qtClearConfirm)) return;
            document.querySelectorAll('.quiz-option').forEach(function (i) { i.checked = false; });
            document.querySelectorAll('.qt-option').forEach(function (l) { l.classList.remove('selected'); });
            localStorage.removeItem(DRAFT_KEY);
            updateAnsweredCount();
            showToast(_qtDraftCleared, 'success');
        }

        // ---- Timer ----
        function initTimer() {
            if (TIME_LIMIT_MIN <= 0) return;
            let startTime = localStorage.getItem(START_KEY);
            if (!startTime) {
                startTime = new Date().toISOString();
                localStorage.setItem(START_KEY, startTime);
            }
            const endTime = new Date(startTime).getTime() + TIME_LIMIT_MIN * 60 * 1000;

            timerInterval = setInterval(function () {
                const remaining = endTime - Date.now();
                const box = document.getElementById('timerBox');
                const disp = document.getElementById('timerDisplay');

                if (remaining <= 0) {
                    clearInterval(timerInterval);
                    disp.textContent = '00:00';
                    box.className = 'qt-timer danger';
                    if (!submitted) {
                        showToast(_qtTimeUp, 'danger');
                        setTimeout(function () { submitQuiz(QUIZ_ID, true); }, 1200);
                    }
                    return;
                }

                const min = Math.floor(remaining / 60000);
                const sec = Math.floor((remaining % 60000) / 1000);
                const pad = function (n) { return String(n).padStart(2, '0'); };
                disp.textContent = pad(min) + ':' + pad(sec);

                if (remaining < 60000) box.className = 'qt-timer danger';
                else if (remaining < 5 * 60000) box.className = 'qt-timer warning';
            }, 1000);
        }

        // ---- Submit ----
        function submitQuiz(quizId, autoSubmit) {
            autoSubmit = autoSubmit || false;
            if (submitted) return;
            const answers = collectAnswers();
            const answeredCount = Object.keys(answers).length;

            if (!autoSubmit) {
                if (answeredCount === 0) { showToast(_qtNoAnswers, 'danger'); return; }
                const unanswered = TOTAL_QUESTIONS - answeredCount;
                const msg = unanswered > 0
                    ? unanswered + ' ' + _qtUnansweredSuffix
                    : _qtSubmitConfirm;
                if (!confirm(msg)) return;
            }

            submitted = true;
            const btn = document.getElementById('btnSubmitQuiz');
            btn.disabled = true;
            btn.innerHTML = _qtSubmitting;

            fetch('@Url.Action("SubmitQuiz", "Quiz")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getToken()
                },
                body: JSON.stringify({ QuizId: quizId, Answers: answers })
            })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (res.success) {
                    localStorage.removeItem(DRAFT_KEY);
                    localStorage.removeItem(START_KEY);
                    if (timerInterval) clearInterval(timerInterval);
                    window.location.href = res.resultUrl;
                } else {
                    submitted = false;
                    btn.disabled = false;
                    btn.innerHTML = _qtSubmitBtn;
                    showToast(res.message || _qtConnError, 'danger');
                }
            })
            .catch(function () {
                submitted = false;
                btn.disabled = false;
                btn.innerHTML = _qtSubmitBtn;
                showToast(_qtConnError, 'danger');
            });
        }

        // ---- Init ----
        restoreDraft();
        updateAnsweredCount();
        initTimer();

        window.addEventListener('beforeunload', function (e) {
            if (!submitted && Object.keys(collectAnswers()).length > 0) {
                e.preventDefault();
                e.returnValue = '';
            }
        });
    </script>
}
