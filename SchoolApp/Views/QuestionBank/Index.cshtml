@* Views/QuestionBank/Index.cshtml *@
@model IEnumerable<SchoolApp.Models.Question>
@{
    ViewData["Title"] = L["QB_Title"].Value;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentTag = ViewData["CurrentTag"] as string;
    var allTags = ViewData["AllTags"] as List<string> ?? new();
}

<div class="adm-page-header">
    <div>
        <div class="adm-page-title">🗃️ @L["QB_Title"]</div>
        <div class="adm-page-sub">@L["QB_Sub"]</div>
    </div>
</div>

@* ── TOOLBAR ──────────────────────────────────────────────────────── *@
@{
    var tagLabel = currentTag != null ? $"🏷 {currentTag}" : "☰ Tag";
    var tagActive = currentTag != null;
}
<div style="display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:1.5rem; flex-wrap:wrap;">
    <div style="display:flex; align-items:center; gap:8px; flex:1; flex-wrap:wrap;">
        <!-- Search -->
        <div style="position:relative; flex:1; min-width:200px; max-width:380px; display:flex;">
            <i class="bi bi-search" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--adm-text-dim); font-size:.85rem; z-index:1;"></i>
            <input type="text" id="searchInput" class="adm-input"
                   placeholder="@L["QB_SearchPlaceholder"]"
                   oninput="filterTable()"
                   style="padding-left:36px; border-radius:8px 0 0 8px; flex:1;" />
            <button type="button" class="adm-btn adm-btn-primary" onclick="filterTable()"
                    style="border-radius:0 8px 8px 0; padding:9px 18px; font-weight:600;">
                @L["Course_SearchBtn"]
            </button>
        </div>

        @* Tag filter dropdown *@
        @if (allTags.Any())
        {
            <div class="dropdown">
                <button class="adm-btn dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        style="@(tagActive ? "border-color:var(--gold); color:var(--gold);" : "")">
                    @tagLabel
                </button>
                <ul class="dropdown-menu dropdown-menu-dark"
                    style="min-width:200px; border:1px solid rgba(255,255,255,.1); background:#14233d;">
                    <li>
                        <a class="dropdown-item @(currentTag == null ? "active" : "")"
                           href="/QuestionBank/Index">
                            <i class="bi bi-list-ul me-2"></i> @L["QB_TagAll"]
                            <span class="badge bg-secondary ms-1">@Model.Count()</span>
                        </a>
                    </li>
                    @foreach (var tag in allTags)
                    {
                        <li>
                            <a class="dropdown-item @(currentTag == tag ? "active" : "")"
                               href="/QuestionBank/Index?tag=@Uri.EscapeDataString(tag)">
                                <i class="bi bi-tag me-2"></i>@tag
                                <span class="badge bg-secondary ms-1">@Model.Count(q => q.Tag == tag)</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <button class="adm-btn adm-btn-primary" onclick="openModal(0)">
        <i class="bi bi-plus-circle me-1"></i> @L["QB_AddQuestion"]
    </button>
</div>

@* ── THỐNG KÊ ─────────────────────────────────────────────────────── *@
<div class="adm-stats mb-4">
    <div class="adm-stat-card">
        <div class="adm-stat-icon" style="background:rgba(201,168,76,0.12); color:#c9a84c;"><i class="bi bi-collection"></i></div>
        <div class="adm-stat-label">@L["QB_TotalQuestions"]</div>
        <div class="adm-stat-value">@Model.Count()</div>
    </div>
    <div class="adm-stat-card">
        <div class="adm-stat-icon" style="background:rgba(63,185,80,0.12); color:#3fb950;"><i class="bi bi-tags"></i></div>
        <div class="adm-stat-label">@L["QB_Tags"]</div>
        <div class="adm-stat-value">@allTags.Count</div>
    </div>
    <div class="adm-stat-card">
        <div class="adm-stat-icon" style="background:rgba(88,166,255,0.12); color:#58a6ff;"><i class="bi bi-check-circle"></i></div>
        <div class="adm-stat-label">@L["QB_SingleChoice"]</div>
        <div class="adm-stat-value">@Model.Count(q => q.Type == SchoolApp.Models.Enums.QuestionType.SingleChoice)</div>
    </div>
    <div class="adm-stat-card">
        <div class="adm-stat-icon" style="background:rgba(227,179,65,0.12); color:#e3b341;"><i class="bi bi-check2-all"></i></div>
        <div class="adm-stat-label">@L["QB_MultiChoice"]</div>
        <div class="adm-stat-value">@Model.Count(q => q.Type == SchoolApp.Models.Enums.QuestionType.MultiChoice)</div>
    </div>
</div>

@* ── BẢNG ─────────────────────────────────────────────────────────── *@
<div class="adm-card" style="padding:0; overflow:hidden;">
    <div class="adm-table-wrap">
        <table class="adm-table adm-table-bordered" id="bankTable">
            <thead>
                <tr>
                    <th style="width:50px" class="text-center">#</th>
                    <th>@L["QB_ColContent"]</th>
                    <th style="width:140px">@L["QB_ColType"]</th>
                    <th style="width:80px" class="text-center">@L["QB_ColPoints"]</th>
                    <th style="width:80px" class="text-center">@L["QB_ColAnswers"]</th>
                    <th style="width:110px">Tag</th>
                    <th style="width:130px" class="text-center">@L["Adm_ColActions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center; padding:2.5rem; color:rgba(255,255,255,0.3);">
                            <i class="bi bi-inbox" style="font-size:2rem; display:block; margin-bottom:.5rem;"></i>
                            @L["QB_NoQuestions"]
                        </td>
                    </tr>
                }
                @{
                    int stt = 1;
                }
                @foreach (var q in Model)
                {
                    <tr data-content="@q.Content.ToLower()" data-tag="@(q.Tag ?? "")">
                        <td class="text-center" style="color:rgba(255,255,255,0.35);">@(stt++)</td>
                        <td>
                            <div style="font-weight:500;">@q.Content</div>
                            @if (!string.IsNullOrWhiteSpace(q.Explanation))
                            {
                                <small style="color:#58a6ff;">
                                    <i class="bi bi-info-circle me-1"></i>@L["QB_HasExplanation"]
                                </small>
                            }
                        </td>
                        <td>
                            @switch (q.Type)
                            {
                                case SchoolApp.Models.Enums.QuestionType.SingleChoice:
                                    <span class="adm-badge adm-badge-info">@L["QB_SingleChoice"]</span>
                                    break;
                                case SchoolApp.Models.Enums.QuestionType.MultiChoice:
                                    <span class="adm-badge adm-badge-warning">@L["QB_MultiChoice"]</span>
                                    break;
                                case SchoolApp.Models.Enums.QuestionType.TrueFalse:
                                    <span class="adm-badge adm-badge-gold">@L["QB_TrueFalse"]</span>
                                    break;
                            }
                        </td>
                        <td class="text-center">@q.Points</td>
                        <td class="text-center">@q.Options.Count</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(q.Tag))
                            {
                                <span class="adm-badge adm-badge-gold">
                                    <i class="bi bi-tag me-1"></i>@q.Tag
                                </span>
                            }
                        </td>
                        <td class="text-center" style="white-space:nowrap;">
                            <button class="adm-btn adm-btn-warning adm-btn-sm me-1"
                                    onclick="openModal(@q.QuestionId)"
                                    title="@L["Btn_Edit"]">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="adm-btn adm-btn-danger adm-btn-sm"
                                    onclick="deleteQuestion(@q.QuestionId)"
                                    title="@L["Btn_Delete"]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Any())
    {
        <div style="padding:.6rem 1rem; border-top:1px solid rgba(201,168,76,0.12); color:rgba(255,255,255,0.35); font-size:.78rem;">
            @L["QB_Showing"] <span id="visibleCount">@Model.Count()</span> / @Model.Count() @L["QB_Questions"]
        </div>
    }
</div>

@* ══════════════════════════════════════════════════════════════════
   MODAL THÊM / SỬA
══════════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="bankModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header bg-navy text-white">
                <h5 class="modal-title" id="bankModalLabel">@L["QB_AddQuestion"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="bankForm">
                    <input type="hidden" id="f_id" value="0" />

                    <div class="row">
                        <div class="col-md-8">
                            <label class="sa-label">@L["QB_QuestionContent"] <span class="text-danger">*</span></label>
                            <textarea id="f_content" class="sa-input" rows="3"
                                      placeholder="@L["QB_QuestionContent"]..."></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="sa-label">@L["QB_QuestionType"]</label>
                            <select id="f_type" class="sa-input" onchange="onTypeChange()">
                                <option value="0">@L["QB_SingleChoice"]</option>
                                <option value="1">@L["QB_MultiChoice"]</option>
                                <option value="2">@L["QB_TrueFalse"]</option>
                            </select>

                            <label class="sa-label mt-3">@L["QB_ColPoints"]</label>
                            <input type="number" id="f_points" class="sa-input"
                                   value="1" min="1" max="100" />

                            <label class="sa-label mt-3">@L["QB_TagTopic"]</label>
                            <input type="text" id="f_tag" class="sa-input"
                                   placeholder="@L["QB_FilterTagPh"]"
                                   list="tagSuggestions" />
                            <datalist id="tagSuggestions">
                                @foreach (var tag in allTags)
                                {
                                    <option value="@tag" />
                                }
                            </datalist>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="sa-label">@L["QB_Explanation"]</label>
                        <textarea id="f_explanation" class="sa-input" rows="2"
                                  placeholder="@L["QB_Explanation"]..."></textarea>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">@L["QB_Answers"]</h6>
                        <div>
                            <small class="text-muted me-3" id="optionsHint">
                                @L["QB_MarkCorrect"]
                            </small>
                            <button type="button" id="btnAddOpt"
                                    class="btn btn-sm btn-outline-primary"
                                    onclick="addOptionField()">
                                <i class="bi bi-plus"></i> @L["QB_AddAnswer"]
                            </button>
                        </div>
                    </div>

                    <div id="optionsContainer" class="mt-2"></div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="sa-btn sa-btn-outline" data-bs-dismiss="modal">@L["Btn_Cancel"]</button>
                <button type="button" class="sa-btn sa-btn-primary" id="btnSave">
                    <i class="bi bi-check-lg"></i> @L["QB_SaveQuestion"]
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

    <script>
        var _lblModalAdd  = '@L["QB_ModalAddTitle"]';
        var _lblModalEdit = '@L["QB_ModalEditTitle"]';
        var _lblSave      = '@L["QB_SaveQuestion"]';
        var _lblUpdate    = '@L["QB_Update"]';
        var _lblCorrect   = '@L["QB_Correct"]';
        var _lblAnswerPh  = '@L["QB_AnswerPlaceholder"]';
        var _lblLoadErr   = '@L["QB_LoadError"]';
        var _lblSaveFail  = '@L["QB_SaveFailed"]';
        var _lblConnErr   = '@L["QB_ConnError"]';
        var _lblDelConf   = '@L["QB_DeleteConfirm"]';
        var _lblMarkCorr  = '@L["QB_MarkCorrect"]';
        var _lblOptTrue   = '@L["QB_OptionTrue"]';
        var _lblOptFalse  = '@L["QB_OptionFalse"]';

        let isBankEdit = false;

        function getToken() {
            return $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
        }

        function ajaxJson(url, data) {
            return $.ajax({
                url, type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': getToken() },
                data: JSON.stringify(data)
            });
        }

        window.filterTable = function () {
            const kw = $('#searchInput').val().toLowerCase().trim();
            let visible = 0;
            $('#bankTable tbody tr[data-content]').each(function () {
                const match = !kw || $(this).data('content').includes(kw);
                $(this).toggle(match);
                if (match) visible++;
            });
            $('#visibleCount').text(visible);
        };

        window.openModal = function (id) {
            $('#f_id').val(0);
            $('#f_content').val('');
            $('#f_type').val(0);
            $('#f_points').val(1);
            $('#f_tag').val('');
            $('#f_explanation').val('');
            $('#optionsContainer').html('');

            if (id === 0) {
                isBankEdit = false;
                $('#bankModalLabel').text('➕ ' + _lblModalAdd);
                $('#btnSave').html('<i class="bi bi-check-lg"></i> ' + _lblSave);
                window.addOptionField();
                window.addOptionField();
                window.onTypeChange();
                $('#bankModal').modal('show');
            } else {
                isBankEdit = true;
                $('#bankModalLabel').text('✏️ ' + _lblModalEdit);
                $('#btnSave').html('<i class="bi bi-check-lg"></i> ' + _lblUpdate);

                $.get('/QuestionBank/GetQuestion', { id })
                    .done(function (data) {
                        $('#f_id').val(data.questionId);
                        $('#f_content').val(data.content);
                        $('#f_type').val(data.type);
                        $('#f_points').val(data.points);
                        $('#f_tag').val(data.tag ?? '');
                        $('#f_explanation').val(data.explanation ?? '');
                        data.options.forEach(o =>
                            window.addOptionField(o.content, o.isCorrect, o.answerOptionId));
                        window.onTypeChange();
                        $('#bankModal').modal('show');
                    })
                    .fail(() => showToast(_lblLoadErr, 'danger'));
            }
        };

        window.onTypeChange = function () {
            const type = parseInt($('#f_type').val());
            const isTF = type === 2;

            if (isTF) {
                $('#btnAddOpt').hide();
                $('#optionsHint').html(_lblMarkCorr);
                if (!isBankEdit && $('#optionsContainer .option-item').length === 0) {
                    window.addOptionField(_lblOptTrue, true, 0);
                    window.addOptionField(_lblOptFalse, false, 0);
                }
                $('#optionsContainer .option-correct')
                    .attr('type', 'radio').attr('name', 'tf_correct');
            } else {
                $('#btnAddOpt').show();
                $('#optionsHint').html(_lblMarkCorr);
                $('#optionsContainer .option-correct')
                    .attr('type', 'checkbox').removeAttr('name');
            }
        };

        window.addOptionField = function (content = '', isCorrect = false, answerOptionId = 0) {
            const safeContent = $('<div>').text(content).html();
            const html = `
                <div class="option-item input-group mb-2" data-option-id="${answerOptionId}">
                    <input type="text" class="form-control option-content"
                           placeholder="${_lblAnswerPh}" value="${safeContent}" />
                    <div class="input-group-text">
                        <input type="checkbox" class="option-correct form-check-input mt-0 me-2"
                               ${isCorrect ? 'checked' : ''} />
                        <span>${_lblCorrect}</span>
                    </div>
                    <button type="button" class="btn btn-outline-danger"
                            onclick="$(this).closest('.option-item').remove()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>`;
            $('#optionsContainer').append(html);
        };

        window.deleteQuestion = function (id) {
            if (!confirm(_lblDelConf)) return;
            $.ajax({
                url: '/QuestionBank/Delete',
                type: 'POST',
                data: { id, __RequestVerificationToken: getToken() },
                success: function (res) {
                    if (res.success) {
                        showToast(res.message, 'success');
                        setTimeout(() => location.reload(), 600);
                    } else {
                        showToast(res.message, 'danger');
                    }
                },
                error: () => showToast(_lblConnErr, 'danger')
            });
        };

        function showToast(message, type = 'success') {
            const cls  = type === 'success' ? 'sa-alert-success' : 'sa-alert-danger';
            const icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
            const toast = $(`
                <div class="sa-alert ${cls}"
                     style="position:fixed;top:1rem;right:1rem;z-index:9999;min-width:320px;">
                    <span class="sa-alert-icon"><i class="bi ${icon}"></i></span>
                    <span>${message}</span>
                    <button class="sa-alert-close" onclick="$(this).parent().remove()">
                        <i class="bi bi-x"></i>
                    </button>
                </div>`);
            $('body').append(toast);
            setTimeout(() => toast.fadeOut(400, () => toast.remove()), 3000);
        }

        $(function () {
            $('#btnSave').on('click', function () {
                const options = [];
                $('.option-item').each(function () {
                    const content   = $(this).find('.option-content').val().trim();
                    const isCorrect = $(this).find('.option-correct').is(':checked');
                    const optId     = parseInt($(this).data('option-id')) || 0;
                    if (content) options.push({ answerOptionId: optId, content, isCorrect });
                });

                const dto = {
                    questionId:  parseInt($('#f_id').val()) || 0,
                    quizId:      null,
                    content:     $('#f_content').val().trim(),
                    type:        parseInt($('#f_type').val()),
                    points:      parseInt($('#f_points').val()) || 1,
                    tag:         $('#f_tag').val().trim(),
                    explanation: $('#f_explanation').val().trim(),
                    options
                };

                ajaxJson('/QuestionBank/Save', dto)
                    .done(function (res) {
                        if (res.success) {
                            $('#bankModal').modal('hide');
                            showToast(res.message, 'success');
                            setTimeout(() => location.reload(), 700);
                        } else {
                            showToast(res.message || _lblSaveFail, 'danger');
                        }
                    })
                    .fail(() => showToast(_lblConnErr, 'danger'));
            });
        });
    </script>
}
