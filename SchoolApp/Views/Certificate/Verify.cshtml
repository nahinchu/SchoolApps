@model SchoolApp.Models.Certificate?
@{
    ViewData["Title"] = L["Cert_VerifyTitle"].Value;
    bool isValid = (bool)(ViewBag.Valid ?? false);
}

<style>
    .verify-wrapper {
        max-width: 600px;
        margin: 4rem auto;
        text-align: center;
    }

    .verify-card {
        background: linear-gradient(135deg, #1b2d42 0%, #243650 100%);
        border-radius: 20px;
        padding: 3rem 2.5rem;
        position: relative;
        overflow: hidden;
    }

        .verify-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 5px;
            background: linear-gradient(90deg, #c9a84c, #e8d08a, #c9a84c);
        }

    .verify-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
    }

    .verify-status-valid {
        color: #4ade80;
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
    }

    .verify-status-invalid {
        color: #f87171;
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
    }

    .verify-info-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1.5rem;
        text-align: left;
    }

        .verify-info-table td {
            padding: .6rem .8rem;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .verify-info-table td:first-child {
            color: #8090a0;
            font-size: .85rem;
            width: 40%;
        }

        .verify-info-table td:last-child {
            color: #fff;
            font-weight: 600;
            font-size: .9rem;
        }

    .cert-code-display {
        font-family: monospace;
        font-size: .75rem;
        color: #c9a84c;
        background: rgba(201,168,76,0.1);
        border: 1px solid rgba(201,168,76,0.25);
        border-radius: 6px;
        padding: .4rem .7rem;
        display: inline-block;
        margin-top: 1rem;
        word-break: break-all;
    }
</style>

<div class="verify-wrapper">
    <div class="verify-card">
        @if (isValid && Model != null)
        {
            <div class="verify-icon">✅</div>
            <div class="verify-status-valid">
                <i class="bi bi-shield-fill-check"></i> @L["Cert_Valid"]
            </div>
            <p style="color:#8090a0;">@L["Cert_IssuedBy"] <strong style="color:#c9a84c;">School App</strong></p>

            <table class="verify-info-table">
                <tr>
                    <td>@L["Cert_ColStudent"]</td>
                    <td>@Model.User?.FullName</td>
                </tr>
                <tr>
                    <td>@L["Cert_ColCourse"]</td>
                    <td>@Model.Course?.CourseName</td>
                </tr>
                <tr>
                    <td>@L["Cert_ColIssued"]</td>
                    <td>@Model.IssuedDate.ToString("dd/MM/yyyy")</td>
                </tr>
            </table>

            <div class="cert-code-display">
                <i class="bi bi-fingerprint"></i> @Model.CertificateCode
            </div>
        }
        else
        {
            <div class="verify-icon">❌</div>
            <div class="verify-status-invalid">
                <i class="bi bi-shield-x"></i> @L["Cert_Invalid"]
            </div>
            <p style="color:#8090a0;">@L["Cert_InvalidDesc"]</p>
        }
    </div>

    <div style="margin-top:1.5rem;">
        <a asp-controller="Home" asp-action="Index" style="color:#8090a0;text-decoration:none;">
            <i class="bi bi-arrow-left"></i> @L["Cert_Home"]
        </a>
    </div>
</div>
