@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<SchoolApp.Models.Course>
@{
    ViewData["Title"] = "Danh sách khóa học";
    var role = Context.Session.GetString("Role");
    var isAdminOrManager = role == "Admin" || role == "Manager";
    Layout = isAdminOrManager
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_Layout.cshtml";
}

<!-- ==================== PAGE HEADER ==================== -->
@if (isAdminOrManager)
{
    <div class="adm-page-header">
        <div>
            <div class="adm-page-title">📚 Danh sách <span>Khóa học</span></div>
            <div class="adm-page-sub">Quản lý và khám phá các khóa học hiện có</div>
        </div>
    </div>
}
else
{
    <div class="sa-page-hero">
        <h1>📚 Danh sách khóa học</h1>
        <p>Quản lý và khám phá các khóa học hiện có</p>
    </div>
}

<!-- ==================== TOOLBAR ==================== -->
<div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1.5rem; flex-wrap:wrap;">
    <form id="searchForm" method="get" style="flex:1; max-width:420px; display:flex; gap:0;">
        <div style="position:relative; flex:1;">
            <i class="bi bi-search" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--text-light);"></i>
            <input type="text" name="searchTerm" value="@ViewData["SearchTerm"]"
                   class="sa-input" placeholder="Tìm theo tên khóa học..."
                   style="padding-left:42px; border-radius:var(--radius-sm) 0 0 var(--radius-sm);" />
        </div>
        <button type="submit" class="sa-btn sa-btn-primary"
                style="border-radius:0 var(--radius-sm) var(--radius-sm) 0; padding:10px 20px;">
            <i class="bi bi-search"></i>
        </button>
    </form>

    @if (isAdminOrManager)
    {
        <div style="display:flex; gap:.5rem; flex-wrap:wrap;">
            <a id="btnExport" href="@Url.Action("ExportExcel", "Course", new { searchTerm = ViewData["SearchTerm"] })"
               class="sa-btn" style="background:#1d7a3a; color:#fff; border:none;">
                <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
            </a>
            <button type="button" class="sa-btn" style="background:rgba(13,110,253,0.9); color:#fff; border:none;"
                    data-bs-toggle="modal" data-bs-target="#importModal">
                <i class="bi bi-upload me-1"></i> Nhập từ Excel
            </button>
            <button type="button" class="sa-btn sa-btn-gold" data-bs-toggle="modal" data-bs-target="#courseModal"
                    onclick="openCreateModal()">
                <i class="bi bi-plus-circle me-2"></i> Thêm khóa học mới
            </button>
        </div>
    }
</div>

<!-- ==================== TABLE ==================== -->
<div id="courseTableContainer">
    @await Html.PartialAsync("_CourseTable", Model)
</div>

<!-- ==================== MODAL CREATE / EDIT ==================== -->
<div class="modal fade" id="courseModal" tabindex="-1" aria-labelledby="courseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="border:none; border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-lg);">

            <div class="modal-header" style="
                background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
                padding:1.25rem 1.5rem; border:none;">
                <h5 id="courseModalLabel" style="
                    font-family:var(--font-display); font-size:1.15rem; font-weight:600;
                    color:var(--gold-light); margin:0;">
                    Thêm khóa học
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body" style="padding:1.5rem; background:var(--white);">
                <div id="modalResult" style="margin-bottom:1rem;"></div>
                <form id="courseForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="CourseId" name="CourseId" value="0" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="sa-form-group">
                                <label class="sa-label" for="CourseName">
                                    Tên khóa học <span style="color:var(--danger)">*</span>
                                </label>
                                <input type="text" id="CourseName" name="CourseName"
                                       class="sa-input" placeholder="Nhập tên khóa học (3–200 ký tự)" />
                                <div class="invalid-feedback" id="err-CourseName"></div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="sa-form-group">
                                <label class="sa-label" for="Credits">
                                    Tín chỉ <span style="color:var(--danger)">*</span>
                                </label>
                                <input type="number" id="Credits" name="Credits"
                                       class="sa-input" min="1" max="10" placeholder="1–10" />
                                <div class="invalid-feedback" id="err-Credits"></div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="sa-form-group">
                                <label class="sa-label" for="Level">Cấp độ</label>
                                <select id="Level" name="Level" class="sa-input">
                                    <option value="0">Cơ bản</option>
                                    <option value="1">Trung cấp</option>
                                    <option value="2">Nâng cao</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="sa-form-group">
                                <label class="sa-label" for="FeeDisplay">
                                    Học phí (VNĐ) <span style="color:var(--danger)">*</span>
                                </label>
                                <input type="text" id="FeeDisplay"
                                       class="sa-input" placeholder="0–100.000.000"
                                       inputmode="numeric" autocomplete="off" />
                                <input type="hidden" id="Fee" name="Fee" />
                                <div class="invalid-feedback" id="err-Fee"></div>
                            </div>
                        </div>
                    </div>

                    <div class="sa-form-group">
                        <label class="sa-label" for="Description">Mô tả</label>
                        <textarea id="Description" name="Description"
                                  class="sa-input" rows="3" style="resize:vertical;"
                                  placeholder="Mô tả khóa học (tối đa 1000 ký tự)..."></textarea>
                        <div class="invalid-feedback" id="err-Description"></div>
                    </div>

                    <!-- ===== THUMBNAIL ===== -->
                    <div class="sa-form-group">
                        <label class="sa-label">Ảnh bìa</label>
                        <div style="display:flex; align-items:flex-start; gap:1rem;">
                            <div id="thumbnailPreviewWrap" style="
                                width:120px; height:80px; flex-shrink:0;
                                border-radius:var(--radius-sm);
                                background:var(--smoke);
                                border:1px dashed rgba(0,0,0,.2);
                                overflow:hidden; display:flex; align-items:center; justify-content:center;">
                                <img id="thumbnailPreview" src="" alt=""
                                     style="width:100%; height:100%; object-fit:cover; display:none;" />
                                <i id="thumbnailPlaceholder" class="bi bi-image"
                                   style="font-size:1.8rem; color:rgba(0,0,0,.25);"></i>
                            </div>
                            <div style="flex:1;">
                                <input type="file" id="thumbnail" name="thumbnail"
                                       class="sa-input" accept=".png,.jpg,.jpeg,.gif,.webp"
                                       style="padding:.45rem .75rem;" />
                                <div style="font-size:.75rem; color:var(--text-light); margin-top:.3rem;">
                                    PNG / JPG / GIF / WEBP — tối đa 5 MB
                                </div>
                                <div class="invalid-feedback" id="err-thumbnail"></div>
                            </div>
                        </div>
                    </div>

                    <div class="form-check form-switch" style="margin-bottom:.5rem;">
                        <input type="checkbox" id="IsActive" name="IsActive" value="true"
                               class="form-check-input" checked />
                        <label for="IsActive" class="form-check-label"
                               style="font-size:.85rem; font-weight:500; color:var(--text-mid);">
                            Đang mở đăng ký
                        </label>
                    </div>
                </form>
            </div>

            <div class="modal-footer" style="
                padding:1rem 1.5rem;
                background:var(--off-white);
                border-top:1px solid var(--smoke);">
                <button type="button" class="sa-btn sa-btn-outline" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="sa-btn sa-btn-primary" id="btnSaveCourse">
                    <i class="bi bi-check-lg"></i> <span class="btn-text">Lưu</span>
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ==================== MODAL IMPORT EXCEL ==================== -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:520px;">
        <div class="modal-content" style="border:none; border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-lg);">

            <div class="modal-header" style="
                background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
                padding:1.25rem 1.5rem; border:none;">
                <h5 id="importModalLabel" style="
                    font-family:var(--font-display); font-size:1.1rem; font-weight:600;
                    color:#fff; margin:0;">
                    <i class="bi bi-upload me-2"></i>Nhập khóa học từ Excel
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" style="padding:1.5rem; background:var(--white);">
                <div style="
                    background:#f0f7ff; border:1px solid #bdd7f5;
                    border-radius:var(--radius-sm); padding:.85rem 1rem; margin-bottom:1.25rem;
                    display:flex; align-items:center; gap:.75rem;">
                    <i class="bi bi-info-circle-fill" style="color:#0d6efd; font-size:1.1rem; flex-shrink:0;"></i>
                    <div style="font-size:.85rem; color:var(--text-mid); line-height:1.5;">
                        Cột bắt buộc: <strong>Tên khóa học</strong>, <strong>Tín chỉ</strong>, <strong>Học phí (VNĐ)</strong>.
                        Trạng thái để trống sẽ mặc định <strong>Đang mở</strong>.
                        <br>
                        <a href="@Url.Action("DownloadImportTemplate", "Course")"
                           style="color:#0d6efd; font-weight:600; text-decoration:none;">
                            <i class="bi bi-download me-1"></i>Tải file mẫu (.xlsx)
                        </a>
                    </div>
                </div>

                <form id="importForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="sa-form-group">
                        <label class="sa-label">Chọn file Excel (.xlsx)</label>
                        <input type="file" id="importFile" name="file" accept=".xlsx"
                               class="sa-input" style="padding:.45rem .75rem;" />
                    </div>
                </form>

                <div id="importResult" style="display:none; margin-top:1rem;"></div>
            </div>

            <div class="modal-footer" style="padding:1rem 1.5rem; background:var(--off-white); border-top:1px solid var(--smoke);">
                <button type="button" class="sa-btn sa-btn-outline" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="sa-btn" id="btnImport"
                        style="background:#0d6efd; color:#fff; border:none; min-width:110px;">
                    <span class="btn-text"><i class="bi bi-upload me-1"></i>Nhập</span>
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
    <script>
        var isEditMode = false;

        // ====== FORMAT HỌC PHÍ ======
        function formatFeeDisplay(value) {
            var raw = String(value).replace(/\D/g, '');
            if (raw === '') return '';
            return raw.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        }

        $(document).on('input', '#FeeDisplay', function () {
            var input = this;
            var oldVal = input.value;
            var pos = input.selectionStart;
            var digitsBeforeCursor = oldVal.substring(0, pos).replace(/\D/g, '').length;
            var formatted = formatFeeDisplay(oldVal);
            input.value = formatted;
            var newPos = 0, digitCount = 0;
            for (var i = 0; i < formatted.length; i++) {
                if (formatted[i] !== '.') digitCount++;
                if (digitCount === digitsBeforeCursor) { newPos = i + 1; break; }
            }
            input.setSelectionRange(newPos, newPos);
            $('#Fee').val(formatted.replace(/\./g, ''));
            $('#FeeDisplay').removeClass('is-invalid');
            $('#err-Fee').text('');
            $('#modalResult').html('');
        });

        // ====== XÓA LỖI KHI GÕ LẠI ======
        $(document).on('input change', '#courseForm input:not(#FeeDisplay), #courseForm textarea', function () {
            $(this).removeClass('is-invalid');
            var fieldId = $(this).attr('id') || $(this).attr('name');
            $('#err-' + fieldId).text('');
            $('#modalResult').html('');
        });

        function clearErrors() {
            $('#modalResult').html('');
            $('#courseForm .sa-input').removeClass('is-invalid');
            $('#FeeDisplay').removeClass('is-invalid');
            $('#courseForm [id^="err-"]').text('');
        }

        function setThumbnailPreview(url) {
            if (url) {
                $('#thumbnailPreview').attr('src', url).show();
                $('#thumbnailPlaceholder').hide();
            } else {
                $('#thumbnailPreview').attr('src', '').hide();
                $('#thumbnailPlaceholder').show();
            }
        }

        // Preview ảnh ngay khi chọn file
        $(document).on('change', '#thumbnail', function () {
            var file = this.files[0];
            if (file) setThumbnailPreview(URL.createObjectURL(file));
        });

        // ====== MỞ MODAL TẠO MỚI ======
        function openCreateModal() {
            isEditMode = false;
            $('#courseModalLabel').text('➕ Thêm khóa học mới');
            $('#courseForm')[0].reset();
            $('#CourseId').val(0);
            $('#IsActive').prop('checked', true);
            $('#Level').val(0);
            $('#FeeDisplay').val('');
            $('#Fee').val('');
            setThumbnailPreview(null);
            clearErrors();
            $('#btnSaveCourse .btn-text').text('Lưu');
        }

        // ====== MỞ MODAL CHỈNH SỬA ======
        function openEditModal(id) {
            isEditMode = true;
            $('#courseModalLabel').text('✏️ Sửa khóa học');
            $('#btnSaveCourse .btn-text').text('Cập nhật');
            clearErrors();

            $.get('@Url.Action("GetCourse", "Course")/' + id, function (data) {
                $('#CourseId').val(data.courseId);
                $('#CourseName').val(data.courseName);
                $('#Description').val(data.description);
                $('#Credits').val(data.credits);
                $('#Level').val(data.level);
                $('#FeeDisplay').val(formatFeeDisplay(String(data.fee)));
                $('#Fee').val(data.fee);
                $('#IsActive').prop('checked', data.isActive);
                $('#thumbnail').val('');
                setThumbnailPreview(data.thumbnailUrl || null);
                $('#courseModal').modal('show');
            }).fail(function () {
                showToast('Không thể tải thông tin khóa học!', 'danger');
            });
        }

        $(function () {
            // ====== LƯU ======
            $('#btnSaveCourse').on('click', function () {
                $('#Fee').val($('#FeeDisplay').val().replace(/\./g, ''));
                clearErrors();

                var url = isEditMode
                    ? '@Url.Action("EditAjax", "Course")'
                    : '@Url.Action("CreateAjax", "Course")';

                var formData = new FormData(document.getElementById('courseForm'));

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success) {
                            $('#courseModal').modal('hide');
                            showToast(res.message, 'success');
                            loadCourses(1);
                        } else if (res.errors) {
                            $.each(res.errors, function (field, messages) {
                                if (field === 'Fee') {
                                    $('#FeeDisplay').addClass('is-invalid');
                                } else {
                                    $('#' + field).addClass('is-invalid');
                                }
                                $('#err-' + field).text(messages.join(', '));
                            });
                        } else {
                            $('#modalResult').html(
                                '<div class="sa-alert sa-alert-danger"><span class="sa-alert-icon"><i class="bi bi-exclamation-circle-fill"></i></span><span>' + $('<span>').text(res.message).html() + '</span></div>'
                            );
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) showToast('Bạn không có quyền Admin!', 'danger');
                        else showToast('Lỗi: ' + xhr.statusText, 'danger');
                    }
                });
            });

            // ====== BẬT / TẮT ĐĂNG KÝ ======
            $(document).on('click', '.btn-toggle-active', function () {
                var id = $(this).data('id');
                var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("ToggleActive", "Course")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function (res) {
                        if (res.success) { loadCourses($('.pagination .active a').data('page') || 1); }
                        else showToast(res.message, 'danger');
                    },
                    error: function () { showToast('Lỗi khi thay đổi trạng thái!', 'danger'); }
                });
            });

            // ====== TÌM KIẾM ======
            $('#searchForm').on('submit', function (e) {
                e.preventDefault();
                loadCourses(1);
            });

            // ====== PHÂN TRANG ======
            $(document).on('click', '.ajax-page-link', function (e) {
                e.preventDefault();
                var match = $(this).attr('href').match(/page=(\d+)/);
                loadCourses(match ? match[1] : 1);
            });

            // ====== XÓA ======
            $(document).on('click', '.btn-delete-course', function () {
                if (!confirm('Bạn có chắc muốn xóa khóa học này?')) return;
                var id = $(this).data('id');
                var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("DeleteAjax", "Course")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function (res) {
                        if (res.success) { showToast(res.message, 'success'); loadCourses(1); }
                        else { showToast(res.message, 'danger'); }
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) showToast('Bạn không có quyền Admin!', 'danger');
                        else showToast('Lỗi: ' + xhr.statusText, 'danger');
                    }
                });
            });

            // ====== ĐĂNG KÝ KHÓA HỌC (Student) ======
            $(document).on('click', '.btn-register-course', function () {
                var courseId = $(this).data('id');
                var fee = parseFloat($(this).data('fee')) || 0;

                if (fee > 0) {
                    window.location.href = '/Payment/Checkout?courseID=' + courseId;
                    return;
                }

                if (!confirm('Bạn có chắc muốn đăng ký khóa học miễn phí này?')) return;
                var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("Register", "Enrollment")',
                    type: 'POST',
                    data: { courseId: courseId, __RequestVerificationToken: token },
                    success: function (res) {
                        if (res.success) { showToast(res.message, 'success'); loadCourses(1); }
                        else { showToast(res.message, 'danger'); }
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) showToast('Bạn không có quyền!', 'danger');
                        else showToast('Lỗi: ' + xhr.statusText, 'danger');
                    }
                });
            });

            // ====== LOAD BẢNG ======
            function loadCourses(page) {
                var searchTerm = $('#searchForm input[name="searchTerm"]').val();
                $.ajax({
                    url: '@Url.Action("Index", "Course")',
                    type: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    data: { searchTerm: searchTerm, page: page },
                    success: function (html) {
                        $('#courseTableContainer').html(html);
                    }
                });
                var exportUrl = '@Url.Action("ExportExcel", "Course")';
                if (searchTerm) exportUrl += '?searchTerm=' + encodeURIComponent(searchTerm);
                $('#btnExport').attr('href', exportUrl);
            }

            // ====== IMPORT EXCEL ======
            $('#importModal').on('hidden.bs.modal', function () {
                $('#importForm')[0].reset();
                $('#importResult').hide().html('');
                $('#btnImport .btn-text').html('<i class="bi bi-upload me-1"></i>Nhập');
                $('#btnImport').prop('disabled', false);
            });

            $('#btnImport').on('click', function () {
                var fileInput = $('#importFile')[0];
                if (!fileInput.files.length) {
                    showImportResult('danger', 'Vui lòng chọn file Excel trước.');
                    return;
                }

                var formData = new FormData($('#importForm')[0]);

                $('#btnImport .btn-text').html(
                    '<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý...'
                );
                $('#btnImport').prop('disabled', true);
                $('#importResult').hide();

                $.ajax({
                    url: '@Url.Action("ImportExcel", "Course")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        $('#btnImport .btn-text').html('<i class="bi bi-upload me-1"></i>Nhập');
                        $('#btnImport').prop('disabled', false);

                        if (!res.success) {
                            showImportResult('danger', res.message);
                            return;
                        }

                        var html = '';
                        if (res.added > 0) {
                            html += '<div class="sa-alert sa-alert-success" style="margin-bottom:.75rem;">' +
                                '<span class="sa-alert-icon"><i class="bi bi-check-circle-fill"></i></span>' +
                                '<span>Thêm thành công <strong>' + res.added + '</strong> khóa học.</span>' +
                                '</div>';
                        }

                        if (res.skipped && res.skipped.length > 0) {
                            html += '<div class="sa-alert sa-alert-danger" style="margin-bottom:.5rem;">' +
                                '<span class="sa-alert-icon"><i class="bi bi-exclamation-triangle-fill"></i></span>' +
                                '<span><strong>' + res.skipped.length + '</strong> dòng bị bỏ qua:</span>' +
                                '</div>';
                            html += '<ul style="margin:0; padding-left:1.25rem; font-size:.82rem; color:var(--text-mid);">';
                            $.each(res.skipped, function (_, s) {
                                var prefix = s.row > 0 ? ('Dòng ' + s.row + ': ') : '';
                                html += '<li>' + prefix + $('<span>').text(s.reason).html() + '</li>';
                            });
                            html += '</ul>';
                        }

                        if (res.added === 0 && (!res.skipped || res.skipped.length === 0)) {
                            html = '<div class="sa-alert sa-alert-danger">' +
                                '<span class="sa-alert-icon"><i class="bi bi-info-circle-fill"></i></span>' +
                                '<span>Không có dữ liệu hợp lệ nào được nhập.</span></div>';
                        }

                        $('#importResult').html(html).show();

                        if (res.added > 0) loadCourses(1);
                    },
                    error: function (xhr) {
                        $('#btnImport .btn-text').html('<i class="bi bi-upload me-1"></i>Nhập');
                        $('#btnImport').prop('disabled', false);
                        if (xhr.status === 403)
                            showImportResult('danger', 'Bạn không có quyền Manager!');
                        else
                            showImportResult('danger', 'Lỗi server: ' + xhr.statusText);
                    }
                });
            });

            function showImportResult(type, message) {
                var cls  = type === 'success' ? 'sa-alert-success' : 'sa-alert-danger';
                var icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
                $('#importResult').html(
                    '<div class="sa-alert ' + cls + '">' +
                    '<span class="sa-alert-icon"><i class="bi ' + icon + '"></i></span>' +
                    '<span>' + $('<span>').text(message).html() + '</span></div>'
                ).show();
            }

            // ====== TOAST ======
            window.showToast = function (message, type) {
                var cls = type === 'success' ? 'sa-alert-success' : 'sa-alert-danger';
                var icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
                var toast = $('<div class="sa-alert ' + cls + '" style="position:fixed; top:1rem; right:1rem; z-index:9999; min-width:300px; max-width:450px; box-shadow:var(--shadow-md);">' +
                    '<span class="sa-alert-icon"><i class="bi ' + icon + '"></i></span>' +
                    '<span>' + $('<span>').text(message).html() + '</span>' +
                    '<button class="sa-alert-close" onclick="$(this).parent().remove()"><i class="bi bi-x"></i></button>' +
                    '</div>');
                $('body').append(toast);
                setTimeout(function () { toast.fadeOut(300, function () { $(this).remove(); }); }, 3000);
            };
        });
    </script>
}