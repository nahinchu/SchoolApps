@using X.PagedList
@using X.PagedList.Mvc.Core
@using SchoolApp.Models
@model IPagedList<SchoolApp.Models.Course>

@{
    string LevelLabel(CourseLevel l) => l switch
    {
        CourseLevel.Basic => "Cơ bản",
        CourseLevel.Intermediate => "Trung cấp",
        CourseLevel.Advanced => "Nâng cao",
        _ => l.ToString()
    };
    string LevelColor(CourseLevel l) => l switch
    {
        CourseLevel.Basic => "#4caf50",
        CourseLevel.Intermediate => "#ff9800",
        CourseLevel.Advanced => "#e53935",
        _ => "#888"
    };
}

@{
    var role = Context.Session.GetString("Role");
    var isAdmin = role == "Admin";
    var isManager = role == "Manager";
    var isAdminOrManager = isAdmin || isManager;
    var isStudent = role == "Student";
    var studentId = Context.Session.GetInt32("StudentId");
    var enrolledIds = ViewBag.EnrolledCourseIds as HashSet<int> ?? new HashSet<int>();
    var antiForgery = Html.AntiForgeryToken();
}

@if (isAdminOrManager)
{
    <!-- ===== ADMIN / MANAGER TABLE ===== -->
    <div class="adm-table-wrap">
        <table class="adm-table  adm-table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tên khóa học</th>
                    <th class="text-center">Cấp độ</th>
                    <th class="text-center">Tín chỉ</th>
                    <th class="text-end">Học phí</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center; color:rgba(255,255,255,0.3); padding:2rem;">
                            <i class="bi bi-inbox" style="font-size:1.5rem; display:block; margin-bottom:.4rem;"></i>
                            Không có khóa học nào
                        </td>
                    </tr>
                }
                else
                {
                    int i = (Model.PageNumber - 1) * Model.PageSize + 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td style="color:rgba(255,255,255,.4); font-size:.8rem;">@i</td>
                            <td>
                                <div style="display:flex; align-items:center; gap:.75rem;">
                                    @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                                    {
                                        <img src="@item.ThumbnailUrl" alt=""
                                             style="width:56px; height:38px; object-fit:cover; border-radius:4px; flex-shrink:0;" />
                                    }
                                    else
                                    {
                                        <div style="width:56px; height:38px; flex-shrink:0; border-radius:4px;
                                                                                    background:rgba(255,255,255,.06); display:flex; align-items:center; justify-content:center;">
                                            <i class="bi bi-image" style="color:rgba(255,255,255,.2);"></i>
                                        </div>
                                    }
                                    <div>
                                        <div style="font-weight:600; color:rgba(255,255,255,.9);">@item.CourseName</div>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <div style="font-size:.75rem; color:rgba(255,255,255,.4); margin-top:.2rem;
                                                                                        display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                                @item.Description
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span style="
                                                            display:inline-block; padding:.2rem .55rem; border-radius:20px; font-size:.72rem; font-weight:600;
                                                            background:@(LevelColor(item.Level))22; color:@(LevelColor(item.Level)); border:1px solid @(LevelColor(item.Level))55;">
                                    @LevelLabel(item.Level)
                                </span>
                            </td>
                            <td class="text-center" style="color:rgba(255,255,255,.7);">@item.Credits</td>
                            <td class="text-end" style="font-weight:600; color:var(--adm-gold); white-space:nowrap;">
                                @item.Fee.ToString("N0") <small style="font-weight:400; opacity:.6;">₫</small>
                            </td>
                            <td class="text-center">
                                <button type="button" class="adm-btn adm-btn-sm btn-toggle-active"
                                        data-id="@item.CourseId"
                                        style="@(item.IsActive ? "background:rgba(76,175,80,.18); color:#4caf50; border:1px solid #4caf5055;" : "background:rgba(229,57,53,.18); color:#e53935; border:1px solid #e5393555;")">
                                    <i class="bi @(item.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                    @(item.IsActive ? "Đang mở" : "Đã đóng")
                                </button>
                            </td>
                            <td class="text-center" style="white-space:nowrap;">
                                <button type="button" class="adm-btn adm-btn-warning adm-btn-sm"
                                        onclick="openEditModal(@item.CourseId)">
                                    <i class="bi bi-pencil"></i> Sửa
                                </button>
                                @if (isAdmin)
                                {
                                    <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-delete-course"
                                            data-id="@item.CourseId">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                                <a asp-controller="Module" asp-action="Index" asp-route-courseId="@item.CourseId"
                                   class="adm-btn adm-btn-info adm-btn-sm">
                                    <i class="bi bi-folder2"></i> Chương
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:1rem; flex-wrap:wrap; gap:.5rem;">
        <span style="font-size:.8rem; color:rgba(255,255,255,.4);">
            Trang @Model.PageNumber / @Model.PageCount
            &nbsp;·&nbsp; Tổng <strong style="color:rgba(255,255,255,.6);">@Model.TotalItemCount</strong> khóa học
        </span>
        @Html.PagedListPager(Model,
        page => Url.Action("Index", new { page, searchTerm = ViewData["SearchTerm"] }),
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link ajax-page-link" },
            UlElementClasses = new[] { "pagination mb-0" }
        })
</div>
}
else
{
    <!-- ===== STUDENT / GUEST: CARD GRID 3 CỘT ===== -->
    <style>
        .ci-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
        }

        @@media (max-width: 900px) {
            .ci-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 560px) {
            .ci-grid {
                grid-template-columns: 1fr;
            }
        }

        .ci-card {
            background: var(--white);
            border: 1px solid var(--smoke);
            border-radius: var(--radius-md);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            text-decoration: none;
            color: inherit;
            box-shadow: var(--shadow-sm);
            transition: box-shadow .2s ease, transform .2s ease;
            position: relative;
        }

            .ci-card:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-3px);
                color: inherit;
                text-decoration: none;
            }

        .ci-thumb {
            width: 100%;
            aspect-ratio: 16/9;
            background: var(--smoke);
            overflow: hidden;
            position: relative;
            flex-shrink: 0;
        }

            .ci-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                transition: transform .3s ease;
            }

        .ci-card:hover .ci-thumb img {
            transform: scale(1.04);
        }

        .ci-thumb-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .ci-closed-badge {
            position: absolute;
            top: 8px;
            left: 8px;
            background: rgba(20,33,61,.75);
            color: var(--gold-light);
            font-size: .6rem;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 4px;
            letter-spacing: .06em;
        }

        .ci-enrolled-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            background: var(--success);
            color: #fff;
            font-size: .6rem;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 4px;
        }

        .ci-body {
            padding: .9rem 1rem;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: .45rem;
        }

        .ci-title {
            font-family: var(--font-display);
            font-size: .95rem;
            font-weight: 700;
            color: var(--navy);
            line-height: 1.35;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin: 0;
        }

        .ci-desc {
            font-size: .8rem;
            color: var(--text-mid);
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin: 0;
            flex: 1;
        }

        .ci-meta {
            display: flex;
            align-items: center;
            gap: .5rem;
            flex-wrap: wrap;
            margin-top: auto;
            padding-top: .4rem;
        }

        .ci-level {
            display: inline-block;
            padding: .12rem .5rem;
            border-radius: 20px;
            font-size: .68rem;
            font-weight: 700;
        }

        .ci-credits {
            font-size: .75rem;
            color: var(--text-light);
        }

        .ci-footer {
            padding: .65rem 1rem;
            border-top: 1px solid var(--smoke);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--off-white);
        }

        .ci-price-free {
            font-family: var(--font-display);
            font-size: 1rem;
            font-weight: 800;
            color: var(--success);
        }

        .ci-price {
            font-family: var(--font-display);
            font-size: 1rem;
            font-weight: 800;
            color: var(--navy);
            white-space: nowrap;
        }

            .ci-price small {
                font-size: .7rem;
                font-weight: 500;
                color: var(--text-light);
            }

        .ci-cta {
            font-size: .72rem;
            font-weight: 700;
            color: var(--gold);
            display: flex;
            align-items: center;
            gap: .25rem;
            white-space: nowrap;
        }
    </style>

    @if (!Model.Any())
    {
        <div style="text-align:center; padding:4rem 1rem; color:var(--text-light);">
            <i class="bi bi-inbox" style="font-size:3rem; display:block; margin-bottom:.75rem;"></i>
            <p style="font-size:1rem; margin:0; color:var(--text-mid);">Không tìm thấy khóa học nào</p>
        </div>
    }
    else
    {
        <div class="ci-grid">
            @foreach (var item in Model)
            {
                var isEnrolled = enrolledIds.Contains(item.CourseId);
                <a class="ci-card"
                   asp-controller="Course" asp-action="Detail" asp-route-id="@item.CourseId">

                    <!-- Thumbnail -->
                    <div class="ci-thumb">
                        @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                        {
                            <img src="@item.ThumbnailUrl" alt="@item.CourseName" />
                        }
                        else
                        {
                            <div class="ci-thumb-placeholder">
                                <i class="bi bi-play-btn" style="font-size:2.5rem; color:var(--text-light);"></i>
                            </div>
                        }
                        @if (!item.IsActive)
                        {
                            <span class="ci-closed-badge">ĐÃ ĐÓNG</span>
                        }
                        @if (isEnrolled)
                        {
                            <span class="ci-enrolled-badge"><i class="bi bi-check-lg"></i> Đã đăng ký</span>
                        }
                    </div>

                    <!-- Body -->
                    <div class="ci-body">
                        <h3 class="ci-title">@item.CourseName</h3>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="ci-desc">@item.Description</p>
                        }
                        <div class="ci-meta">
                            <span class="ci-level"
                                  style="background:@(LevelColor(item.Level))1a; color:@(LevelColor(item.Level)); border:1px solid @(LevelColor(item.Level))44;">
                                @LevelLabel(item.Level)
                            </span>
                            <span class="ci-credits">
                                <i class="bi bi-journal-bookmark me-1"></i>@item.Credits tín chỉ
                            </span>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="ci-footer">
                        @if (item.Fee == 0)
                        {
                            <span class="ci-price-free">Miễn phí</span>
                        }
                        else
                        {
                            <span class="ci-price">
                                @item.Fee.ToString("N0") <small>₫</small>
                            </span>
                        }
                        <span class="ci-cta">
                            Xem chi tiết <i class="bi bi-arrow-right"></i>
                        </span>
                    </div>
                </a>
            }
        </div>

        <!-- Phân trang -->
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:1.5rem; flex-wrap:wrap; gap:.5rem;">
            <span style="font-size:.8rem; color:var(--text-light);">
                Trang @Model.PageNumber / @Model.PageCount
                &nbsp;·&nbsp; Tổng <strong style="color:var(--text-dark);">@Model.TotalItemCount</strong> khóa học
            </span>
            @Html.PagedListPager(Model,
            page => Url.Action("Index", new { page, searchTerm = ViewData["SearchTerm"], level = ViewData["Level"], sort = ViewData["Sort"] }),
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link ajax-page-link" },
            UlElementClasses = new[] { "pagination mb-0" }
        })
</div>
    }
}