@using SchoolApp.Models
@using SchoolApp.Models.Enums
@model Course

@{
    ViewData["Title"] = "Học - " + Model.CourseName;
    var currentLesson = ViewData["CurrentLesson"] as Lesson;
    var progressMap = (ViewData["ProgressMap"] as Dictionary<int, LessonProgress>) ?? new();
    var quizAttemptMap = (ViewData["QuizAttemptMap"] as Dictionary<int, QuizAttempt>) ?? new();
    var prevLesson = ViewData["PrevLesson"] as Lesson;
    var nextLesson = ViewData["NextLesson"] as Lesson;
    var totalLessons = (int)(ViewData["TotalLessons"] ?? 0);
    var completedCount = (int)(ViewData["CompletedCount"] ?? 0);
    var pctComplete = totalLessons > 0 ? completedCount * 100 / totalLessons : 0;
    var accessState = ViewData["AccessState"] as string; // "guest" | "not_enrolled" | "preview" | null
    var isLocked  = accessState == "guest" || accessState == "not_enrolled";
    var isPreview = accessState == "preview";

    string GetEmbedUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "";
        if (url.Contains("youtube.com/watch", StringComparison.OrdinalIgnoreCase))
        {
            var idPart = url.Split("v=").Last().Split("&").First();
            return $"https://www.youtube.com/embed/{idPart}";
        }
        if (url.Contains("youtu.be/", StringComparison.OrdinalIgnoreCase))
        {
            var idPart = url.Split("youtu.be/").Last().Split("?").First();
            return $"https://www.youtube.com/embed/{idPart}";
        }
        if (url.Contains("vimeo.com/", StringComparison.OrdinalIgnoreCase) && !url.Contains("player.vimeo.com"))
        {
            var idPart = url.Split("vimeo.com/").Last().Split("?").First();
            return $"https://player.vimeo.com/video/{idPart}";
        }
        return url;
    }
}

<style>
    .learn-wrap {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    @@media (max-width: 991px) {
        .learn-wrap {
            grid-template-columns: 1fr;
        }
    }

    /* ========= HEADER ========= */
    .learn-header {
        background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
        color: var(--white);
        padding: 1.5rem;
        border-radius: var(--radius-md);
        margin-bottom: 1.5rem;
    }

        .learn-header h1 {
            font-family: var(--font-display);
            font-size: 1.5rem;
            margin: 0 0 .5rem;
            color: var(--gold-light);
        }

    .learn-progress-bar {
        height: 10px;
        background: rgba(255,255,255,.15);
        border-radius: 999px;
        overflow: hidden;
        margin-top: .75rem;
    }

        .learn-progress-bar > div {
            height: 100%;
            background: linear-gradient(90deg, var(--gold), var(--gold-light));
            transition: width .4s ease;
        }

    .learn-progress-text {
        font-size: .85rem;
        color: rgba(255,255,255,.85);
        margin-top: .35rem;
    }

    /* ========= SIDEBAR ========= */
    .learn-sidebar {
        background: var(--white);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        position: sticky;
        top: 1rem;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
    }

    .module-block {
        border-bottom: 1px solid var(--smoke);
    }

        .module-block:last-child {
            border-bottom: none;
        }

    .module-header {
        padding: .85rem 1rem;
        background: var(--off-white);
        font-weight: 700;
        color: var(--navy);
        font-size: .92rem;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-left: 4px solid var(--navy);
    }

        .module-header:hover {
            background: var(--smoke);
        }

    .lesson-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    /* ===== LESSON ITEM ===== */
    .lesson-row {
        display: flex;
        align-items: center;
        gap: .65rem;
        padding: .75rem 1rem .75rem 1.5rem;
        color: var(--text-mid);
        text-decoration: none;
        font-size: .9rem;
        border-left: 4px solid transparent;
        transition: all .15s ease;
        background: var(--white);
    }

        .lesson-row:hover {
            background: var(--off-white);
            color: var(--navy);
        }

        .lesson-row.active {
            background: linear-gradient(90deg, rgba(20,33,61,.08) 0%, transparent 100%);
            color: var(--navy);
            border-left-color: var(--navy);
            font-weight: 600;
        }

    .lesson-icon {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: .9rem;
    }

        .lesson-icon.done {
            background: var(--success);
            color: var(--white);
        }

        .lesson-icon.current {
            background: var(--navy);
            color: var(--gold-light);
        }

        .lesson-icon.todo {
            background: var(--smoke);
            color: var(--text-light);
            border: 1.5px solid var(--text-light);
        }

    .lesson-row .lesson-title {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .lesson-meta {
        font-size: .72rem;
        color: var(--text-light);
        flex-shrink: 0;
    }

    /* ===== QUIZ CARD (NỔI BẬT) ===== */
    .quiz-card {
        margin: .5rem .75rem .75rem 2.5rem;
        padding: .75rem .9rem;
        background: linear-gradient(135deg, #fff8e1 0%, #fff3cd 100%);
        border: 2px dashed var(--gold);
        border-radius: var(--radius-sm);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: .7rem;
        transition: all .2s ease;
        position: relative;
    }

        .quiz-card::before {
            content: "QUIZ";
            position: absolute;
            top: -9px;
            left: 12px;
            background: var(--gold);
            color: var(--navy);
            font-size: .65rem;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 999px;
            letter-spacing: .08em;
        }

        .quiz-card:hover {
            background: linear-gradient(135deg, #fff3cd 0%, #ffe69c 100%);
            transform: translateX(2px);
            box-shadow: 0 4px 8px rgba(212,175,55,.25);
        }

        .quiz-card .quiz-icon-circle {
            width: 32px;
            height: 32px;
            flex-shrink: 0;
            background: var(--gold);
            color: var(--navy);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .quiz-card .quiz-text {
            flex: 1;
        }

        .quiz-card .quiz-text-title {
            font-weight: 700;
            color: var(--navy);
            font-size: .85rem;
            line-height: 1.2;
        }

        .quiz-card .quiz-text-sub {
            font-size: .72rem;
            color: var(--text-mid);
            margin-top: 2px;
        }

        .quiz-card .quiz-arrow {
            color: var(--navy);
            font-size: 1rem;
        }

        .quiz-card.quiz-passed {
            background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
            border-color: #43a047;
        }

            .quiz-card.quiz-passed .quiz-icon-circle {
                background: #43a047;
                color: #fff;
            }

            .quiz-card.quiz-passed .quiz-text-title {
                color: #2e7d32;
            }

        .quiz-card.quiz-failed {
            background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
            border-color: #fb8c00;
        }

            .quiz-card.quiz-failed .quiz-icon-circle {
                background: #fb8c00;
                color: #fff;
            }

            .quiz-card.quiz-failed .quiz-text-title {
                color: #e65100;
            }

    /* ========= MAIN ========= */
    .learn-main {
        background: var(--white);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .lesson-title-bar {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--smoke);
    }

        .lesson-title-bar h2 {
            font-family: var(--font-display);
            font-size: 1.3rem;
            color: var(--navy);
            margin: 0 0 .25rem;
        }

    .lesson-meta-row {
        font-size: .82rem;
        color: var(--text-light);
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .lesson-body {
        padding: 1.5rem;
    }

    .video-frame {
        position: relative;
        padding-top: 56.25%;
        background: #000;
        border-radius: var(--radius-sm);
        overflow: hidden;
        margin-bottom: 1.25rem;
    }

        .video-frame iframe, .video-frame video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }

    .article-content {
        line-height: 1.7;
        color: var(--text-dark, #222);
        font-size: 1rem;
    }

        .article-content :is(h1,h2,h3,h4) {
            color: var(--navy);
            margin-top: 1.5rem;
        }

        .article-content img {
            max-width: 100%;
            height: auto;
            border-radius: var(--radius-sm);
        }

    /* Quiz banner trong main content */
    .quiz-banner {
        margin-top: 2rem;
        background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
        color: var(--white);
        border-radius: var(--radius-md);
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-wrap: wrap;
        position: relative;
        overflow: hidden;
        border-left: 6px solid var(--gold);
    }

        .quiz-banner::after {
            content: "📋";
            position: absolute;
            right: -10px;
            bottom: -20px;
            font-size: 8rem;
            opacity: .07;
            pointer-events: none;
        }

    .quiz-banner-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: var(--gold);
        color: var(--navy);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        flex-shrink: 0;
    }

    .quiz-banner-text {
        flex: 1;
        min-width: 200px;
        position: relative;
        z-index: 1;
    }

    .quiz-banner-label {
        display: inline-block;
        background: var(--gold);
        color: var(--navy);
        font-size: .7rem;
        font-weight: 800;
        padding: 2px 10px;
        border-radius: 999px;
        letter-spacing: .1em;
        margin-bottom: .35rem;
    }

    .quiz-banner-title {
        font-family: var(--font-display);
        font-size: 1.2rem;
        color: var(--gold-light);
        margin: 0;
    }

    .quiz-banner-sub {
        font-size: .85rem;
        color: rgba(255,255,255,.7);
        margin-top: .25rem;
    }

    .lesson-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--smoke);
        background: var(--off-white);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1.5rem;
        color: var(--text-light);
    }

    /* ========= LOCKED OVERLAY ========= */
    .locked-wrap {
        position: relative;
    }

    .locked-blur {
        filter: blur(4px);
        pointer-events: none;
        user-select: none;
        opacity: .55;
    }

    .locked-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,.55);
        backdrop-filter: blur(2px);
        z-index: 10;
        border-radius: var(--radius-md);
        padding: 2rem;
        text-align: center;
    }

    .locked-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
        color: var(--gold-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 8px 24px rgba(20,33,61,.25);
    }

    .locked-title {
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: .5rem;
    }

    .locked-sub {
        font-size: .92rem;
        color: var(--text-mid);
        margin-bottom: 1.5rem;
        max-width: 360px;
    }

    .locked-actions {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
        justify-content: center;
    }
</style>

<div class="learn-header">
    <div style="display:flex; justify-content:space-between; align-items:start; gap:1rem; flex-wrap:wrap;">
        <div style="flex:1; min-width:240px;">
            <h1>📚 @Model.CourseName</h1>
            <div style="font-size:.88rem; color:rgba(255,255,255,.65);">
                @Model.Modules.Count chương · @totalLessons bài học
            </div>
        </div>
        @if (!isLocked)
        {
            <a asp-controller="Enrollment" asp-action="MyEnrollments"
               class="sa-btn sa-btn-outline" style="border-color:var(--gold-light); color:var(--gold-light);">
                ← Khoá của tôi
            </a>
        }
        else
        {
            <a asp-controller="Course" asp-action="Detail" asp-route-id="@Model.CourseId"
               class="sa-btn sa-btn-outline" style="border-color:var(--gold-light); color:var(--gold-light);">
                ← Chi tiết khoá học
            </a>
        }
    </div>
    @if (!isLocked)
    {
        <div class="learn-progress-bar"><div style="width:@(pctComplete)%;"></div></div>
        <div class="learn-progress-text">
            Tiến độ: <strong>@completedCount / @totalLessons</strong> bài đã hoàn thành (@pctComplete%)
        </div>
    }
    else if (isPreview)
    {
        <div class="learn-progress-text" style="margin-top:.5rem;">
            <i class="bi bi-eye me-1"></i> Đang xem thử chương 1 —
            <a asp-controller="Course" asp-action="Detail" asp-route-id="@Model.CourseId"
               style="color:var(--gold-light); font-weight:600;">Đăng ký để mở khoá toàn bộ</a>
        </div>
    }
    else
    {
        <div class="learn-progress-text" style="margin-top:.5rem;">
            <i class="bi bi-eye me-1"></i> Chế độ xem trước — Đăng nhập hoặc đăng ký để học đầy đủ
        </div>
    }
</div>

<div class="learn-wrap">

    <!-- ============ SIDEBAR ============ -->
    <aside class="learn-sidebar">
        @if (isPreview)
        {
            @await Html.PartialAsync("_ModuleAccordion", Model,
                new ViewDataDictionary(ViewData) {
                    ["ReadOnly"]           = true,
                    ["PreviewFirstModule"] = true,
                    ["CurrentLessonId"]    = currentLesson?.LessonId
                })
        }
        else
        {
            @await Html.PartialAsync("_ModuleAccordion", Model,
                new ViewDataDictionary(ViewData) {
                    ["ReadOnly"]        = false,
                    ["CurrentLessonId"] = currentLesson?.LessonId,
                    ["ProgressMap"]     = progressMap,
                    ["QuizAttemptMap"]  = quizAttemptMap
                })
        }
    </aside>

    <!-- ============ MAIN CONTENT ============ -->
    <div class="@(isLocked ? "locked-wrap" : "")">
        @if (isPreview)
        {
            <div style="background:linear-gradient(90deg,#fff8e1,#fff3cd); border:1.5px solid var(--gold);
                        border-radius:var(--radius-md); padding:.75rem 1.25rem; margin-bottom:1rem;
                        display:flex; align-items:center; gap:.75rem; font-size:.88rem;">
                <i class="bi bi-eye-fill" style="color:var(--gold); font-size:1.1rem; flex-shrink:0;"></i>
                <span style="flex:1; color:#7a5900;">
                    <strong>Đang xem thử chương 1.</strong>
                    Đăng ký để làm quiz, theo dõi tiến độ và xem toàn bộ khoá học.
                </span>
                <a asp-controller="Course" asp-action="Detail" asp-route-id="@Model.CourseId"
                   class="sa-btn sa-btn-gold" style="font-size:.8rem; padding:.35rem .85rem; white-space:nowrap;">
                    Xem khoá học <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        }
        @if (isLocked)
        {
            <div class="locked-overlay">
                <div class="locked-icon">
                    <i class="bi @(accessState == "guest" ? "bi-lock-fill" : "bi-person-lock")"></i>
                </div>
                @if (accessState == "guest")
                {
                    <div class="locked-title">Đăng nhập để học</div>
                    <div class="locked-sub">
                        Bạn cần đăng nhập để xem nội dung bài học của khóa học <strong>@Model.CourseName</strong>.
                    </div>
                    <div class="locked-actions">
                        <a asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                           class="sa-btn sa-btn-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
                        </a>
                        <a asp-controller="Account" asp-action="Register"
                           class="sa-btn sa-btn-outline">
                            <i class="bi bi-person-plus me-1"></i> Tạo tài khoản
                        </a>
                    </div>
                }
                else
                {
                    <div class="locked-title">Đăng ký để học</div>
                    <div class="locked-sub">
                        Bạn chưa đăng ký khóa học <strong>@Model.CourseName</strong>. Hãy đăng ký để mở khóa toàn bộ nội dung.
                    </div>
                    <div class="locked-actions">
                        <a asp-controller="Course" asp-action="Index"
                           class="sa-btn sa-btn-primary">
                            <i class="bi bi-plus-circle me-1"></i> Đăng ký khóa học
                        </a>
                    </div>
                }
            </div>
        }
        <main class="learn-main @(isLocked ? "locked-blur" : "")">
            @if (currentLesson == null)
            {
                <div class="empty-state">
                    <i class="bi bi-journal-x" style="font-size:3rem;"></i>
                    <h4 class="mt-3">Khoá học chưa có bài học nào để học</h4>
                    <p>Vui lòng quay lại sau khi giảng viên cập nhật nội dung.</p>
                </div>
            }
            else
            {
                var curProgress = progressMap.TryGetValue(currentLesson.LessonId, out var cp) ? cp : null;
                var isCompleted = curProgress != null && curProgress.Status == ProgressStatus.Completed;

                <div class="lesson-title-bar">
                    <div style="display:inline-block; background:var(--navy); color:var(--gold-light); font-size:.7rem; font-weight:700; padding:3px 10px; border-radius:999px; letter-spacing:.1em; margin-bottom:.5rem;">
                        BÀI HỌC
                    </div>
                    <h2>@currentLesson.Title</h2>
                    <div class="lesson-meta-row">
                        @switch (currentLesson.Type)
                        {
                            case LessonType.Video:
                                <span><i class="bi bi-play-btn"></i> Video</span>
                                break;
                            case LessonType.Text:

                                <span><i class="bi bi-file-text"></i> Bài viết</span>
                                break;
                            case LessonType.Mixed:

                                <span><i class="bi bi-collection-play"></i> Video + Bài viết</span>
                                break;
                        }
                        @if (currentLesson.DurationMinutes > 0)
                        {
                            <span><i class="bi bi-clock"></i> @currentLesson.DurationMinutes phút</span>
                        }
                        @if (isCompleted)
                        {
                            <span style="color:var(--success);"><i class="bi bi-check-circle-fill"></i> Đã hoàn thành</span>
                        }
                        else
                        {
                            <span style="color:var(--gold);"><i class="bi bi-hourglass-split"></i> Đang học</span>
                        }
                    </div>
                </div>

                <div class="lesson-body">
                    @if ((currentLesson.Type == LessonType.Video || currentLesson.Type == LessonType.Mixed)
                                    && !string.IsNullOrWhiteSpace(currentLesson.VideoUrl))
                    {
                        if (currentLesson.VideoUrl.StartsWith("/uploads/videos/") || currentLesson.VideoUrl.StartsWith("/File/Video"))
                        {
                            <div class="video-frame">
                                <video controls preload="metadata" style="width:100%; height:100%; background:#000;">
                                    <source src="@currentLesson.VideoUrl" />
                                    Trình duyệt không hỗ trợ phát video.
                                </video>
                            </div>
                        }
                        else
                        {
                            var embed = GetEmbedUrl(currentLesson.VideoUrl);
                            <div class="video-frame">
                                <iframe src="@embed"
                                        allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen></iframe>
                            </div>
                        }
                    }

                    @if ((currentLesson.Type == LessonType.Text || currentLesson.Type == LessonType.Mixed)
                                    && !string.IsNullOrWhiteSpace(currentLesson.HtmlContent))
                    {
                        <div class="article-content">@Html.Raw(currentLesson.HtmlContent)</div>
                    }

                    @if (string.IsNullOrWhiteSpace(currentLesson.VideoUrl)
                                    && string.IsNullOrWhiteSpace(currentLesson.HtmlContent))
                    {
                        <div class="empty-state">
                            <i class="bi bi-info-circle" style="font-size:2rem;"></i>
                            <p>Bài học này chưa có nội dung</p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(currentLesson.AttachmentPath))
                    {
                        var attachExt = System.IO.Path.GetExtension(currentLesson.AttachmentPath).ToLowerInvariant();
                        var attachName = System.IO.Path.GetFileName(currentLesson.AttachmentPath);
                        var attachIcon = attachExt switch
                        {
                            ".pdf" => "bi-file-earmark-pdf-fill",
                            ".doc" or ".docx" => "bi-file-earmark-word-fill",
                            ".xls" or ".xlsx" => "bi-file-earmark-excel-fill",
                            ".ppt" or ".pptx" => "bi-file-earmark-ppt-fill",
                            ".zip" or ".rar" => "bi-file-earmark-zip-fill",
                            ".mp4" => "bi-file-earmark-play-fill",
                            ".png" or ".jpg" or ".jpeg" or ".gif" => "bi-file-earmark-image-fill",
                            _ => "bi-file-earmark-fill"
                        };
                        <div style="margin: 1.5rem 0; padding: 1rem 1.25rem; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 8px; display: flex; align-items: center; gap: 1rem;">
                            <i class="bi @attachIcon" style="font-size: 2rem; color: var(--navy, #1a2a4a); flex-shrink:0;"></i>
                            <div style="flex:1; min-width:0;">
                                <div style="font-weight:600; margin-bottom:.2rem;">Tài liệu đính kèm</div>
                                <div style="font-size:.875rem; color:#6c757d; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@attachName</div>
                            </div>
                            <a href="@currentLesson.AttachmentPath" target="_blank" download
                               style="display:inline-flex; align-items:center; gap:.4rem; padding:.5rem 1rem; background:var(--navy, #1a2a4a); color:#fff; border-radius:6px; text-decoration:none; font-size:.875rem; white-space:nowrap;">
                                <i class="bi bi-download"></i> Tải xuống
                            </a>
                        </div>
                    }

                    @if (!isPreview && currentLesson.Quiz != null && currentLesson.Quiz.IsPublished)
                    {
                        quizAttemptMap.TryGetValue(currentLesson.Quiz.QuizId, out var curQa);
                        var bannerBg = curQa == null
                            ? "background:linear-gradient(135deg,var(--navy) 0%,var(--navy-light) 100%);"
                            : (curQa.Passed
                                ? "background:linear-gradient(135deg,#1b5e20 0%,#388e3c 100%);"
                                : "background:linear-gradient(135deg,#bf360c 0%,#e64a19 100%);");
                        <div class="quiz-banner" style="@bannerBg">
                            <div class="quiz-banner-icon">
                                @if (curQa == null)
                                {
                                    <i class="bi bi-pencil-square"></i>
                                }
                                else if (curQa.Passed)
                                {
                                    <i class="bi bi-patch-check-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-repeat"></i>
                                }
                            </div>
                            <div class="quiz-banner-text">
                                @if (curQa == null)
                                {
                                    <span class="quiz-banner-label">📋 BÀI KIỂM TRA</span>
                                }
                                else if (curQa.Passed)
                                {
                                    <span class="quiz-banner-label" style="background:#66bb6a;color:#1b5e20;">✓ ĐÃ ĐẠT</span>
                                }
                                else
                                {
                                    <span class="quiz-banner-label" style="background:#ff7043;color:#fff;">✗ CHƯA ĐẠT</span>
                                }
                                <h3 class="quiz-banner-title">@currentLesson.Quiz.Title</h3>
                                <div class="quiz-banner-sub">
                                    @if (curQa != null)
                                    {
                                        <text>Điểm cao nhất: @curQa.Score/@curQa.MaxScore (@curQa.ScorePercent%) · Làm lần @curQa.AttemptNumber</text>
                                    }
                                    else
                                    {
                                        <text>@currentLesson.Quiz.Questions.Count câu hỏi</text>
                                        if (currentLesson.Quiz.TimeLimitMinutes > 0)
                                        {
                                            <text> · ⏱ @currentLesson.Quiz.TimeLimitMinutes phút</text>
                                        }
                                        <text> · 🎯 Đạt @currentLesson.Quiz.PassingScore%</text>
                                    }
                                </div>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:.5rem;align-items:flex-end;">
                                <a asp-controller="Quiz" asp-action="Take" asp-route-id="@currentLesson.Quiz.QuizId"
                                   class="sa-btn sa-btn-gold" style="font-weight:700; white-space:nowrap;">
                                    @if (curQa == null)
                                    {
                                        <i class="bi bi-play-fill"></i>
                                        <text> Bắt đầu làm bài</text>
                                    }
                                    else if (curQa.Passed)
                                    {
                                        <i class="bi bi-eye-fill"></i>
                                        <text> Xem lại / Làm lại</text>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-repeat"></i>
                                        <text> Làm lại</text>
                                    }
                                </a>
                                @if (curQa != null)
                                {
                                    <a asp-controller="Quiz" asp-action="MyAttempts" asp-route-quizId="@currentLesson.Quiz.QuizId"
                                       style="font-size:.78rem;color:rgba(255,255,255,.7);text-decoration:underline;text-align:right;">
                                        Xem lịch sử làm bài
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="lesson-footer">
                    <div>
                        @if (prevLesson != null)
                        {
                            <a asp-action="Course" asp-route-id="@Model.CourseId" asp-route-lessonId="@prevLesson.LessonId"
                               class="sa-btn sa-btn-outline">
                                <i class="bi bi-arrow-left"></i> Bài trước
                            </a>
                        }
                    </div>

                    <div style="display:flex; gap:.5rem; align-items:center;">
                        @if (isPreview)
                        {
                            <span style="font-size:.82rem; color:var(--text-light);">
                                <i class="bi bi-lock me-1"></i>Đăng ký để theo dõi tiến độ
                            </span>
                        }
                        else if (!isCompleted)
                        {
                            @if (currentLesson.Quiz != null && currentLesson.Quiz.IsPublished)
                            {
                                <span style="font-size:.82rem; color:var(--text-light);">
                                    <i class="bi bi-pencil-square me-1"></i>Làm bài kiểm tra để hoàn thành bài học
                                </span>
                            }
                            else
                            {
                                <button id="btnMarkComplete" class="sa-btn sa-btn-primary"
                                        data-lesson-id="@currentLesson.LessonId">
                                    <i class="bi bi-check-lg"></i> Đánh dấu hoàn thành
                                </button>
                            }
                        }
                        else
                        {
                            <span class="sa-btn sa-btn-outline" style="color:var(--success); border-color:var(--success); cursor:default;">
                                <i class="bi bi-check-circle-fill"></i> Đã hoàn thành
                            </span>
                        }
                    </div>

                    <div>
                        @if (nextLesson != null)
                        {
                            <a asp-action="Course" asp-route-id="@Model.CourseId" asp-route-lessonId="@nextLesson.LessonId"
                               class="sa-btn sa-btn-gold">
                                Bài tiếp theo <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </main>
    </div>@* /locked-wrap *@
</div>

<!-- Modal xác nhận vào quiz -->
<div id="quizConfirmModal" style="display:none; position:fixed; inset:0; z-index:10000; background:rgba(0,0,0,.5); align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:16px; max-width:420px; width:90%; padding:2rem; box-shadow:0 20px 60px rgba(0,0,0,.3); position:relative;">
        <button onclick="closeQuizConfirm()"
                style="position:absolute; top:.75rem; right:.75rem; background:none; border:none; font-size:1.25rem; color:#aaa; cursor:pointer; line-height:1;">
            <i class="bi bi-x"></i>
        </button>

        <div style="font-size:2.5rem; text-align:center; margin-bottom:.75rem;">📝</div>
        <h5 id="qcTitle" style="font-family:var(--font-display); font-size:1.1rem; font-weight:700; color:var(--navy); text-align:center; margin-bottom:1.25rem;"></h5>

        <div style="display:flex; gap:.75rem; justify-content:center; margin-bottom:1.25rem;">
            <div style="text-align:center; background:var(--off-white); border-radius:10px; padding:.6rem 1.1rem;">
                <div id="qcQuestions" style="font-size:1.4rem; font-weight:700; color:var(--navy);"></div>
                <div style="font-size:.72rem; color:var(--text-light); text-transform:uppercase; letter-spacing:.05em;">Câu hỏi</div>
            </div>
            <div style="text-align:center; background:var(--off-white); border-radius:10px; padding:.6rem 1.1rem;">
                <div id="qcPassing" style="font-size:1.4rem; font-weight:700; color:#43a047;"></div>
                <div style="font-size:.72rem; color:var(--text-light); text-transform:uppercase; letter-spacing:.05em;">Điểm đạt</div>
            </div>
        </div>

        <div id="qcNote" style="font-size:.83rem; color:var(--text-mid); text-align:center; margin-bottom:1.5rem; background:var(--off-white); border-radius:8px; padding:.6rem 1rem;"></div>

        <div style="display:flex; gap:.75rem;">
            <button onclick="closeQuizConfirm()" class="sa-btn sa-btn-outline" style="flex:1;">
                <i class="bi bi-x-circle"></i> Huỷ
            </button>
            <a id="qcStartBtn" href="#" class="sa-btn sa-btn-gold" style="flex:1; justify-content:center;">
                <i class="bi bi-play-fill"></i> <span id="qcBtnText">Bắt đầu</span>
            </a>
        </div>
    </div>
</div>

<!-- Modal chúc mừng hoàn thành khoá học -->
<div id="courseCompletedModal" style="display:none; position:fixed; inset:0; z-index:10000; background:rgba(0,0,0,.55); align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:16px; max-width:480px; width:90%; padding:2.5rem; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,.3); position:relative;">
        <div style="font-size:4rem; margin-bottom:1rem;">🎓</div>
        <h2 style="font-family:var(--font-display); color:var(--navy); margin-bottom:.5rem;">Chúc mừng!</h2>
        <p style="color:var(--text-mid); margin-bottom:1.5rem; line-height:1.6;">
            Bạn đã hoàn thành khoá học <strong style="color:var(--gold);">@Model.CourseName</strong>.<br>
            Tất cả bài học và bài kiểm tra đã được hoàn tất!
        </p>
        <div style="display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap;">
            <a asp-controller="Enrollment" asp-action="MyEnrollments"
               class="sa-btn sa-btn-primary">
                <i class="bi bi-mortarboard-fill"></i> Khóa học của tôi
            </a>
            <button onclick="document.getElementById('courseCompletedModal').style.display='none'"
                    class="sa-btn sa-btn-outline">
                Tiếp tục xem
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

    <script>
        function showToast(message, type = 'success') {
            const cls  = type === 'success' ? 'sa-alert-success' : 'sa-alert-danger';
            const icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
            const t = $(`<div class="sa-alert ${cls}" style="position:fixed;top:1rem;right:1rem;z-index:9999;min-width:300px;">
                <span class="sa-alert-icon"><i class="bi ${icon}"></i></span>
                <span>${message}</span>
                <button class="sa-alert-close" onclick="$(this).parent().remove()"><i class="bi bi-x"></i></button>
            </div>`);
            $('body').append(t);
            setTimeout(() => t.fadeOut(400, () => t.remove()), 2500);
        }

        // ===== QUIZ CONFIRM MODAL =====
        function openQuizConfirm(e, url, title, questions, passing, state) {
            e.preventDefault();
            document.getElementById('qcTitle').textContent = title;
            document.getElementById('qcQuestions').textContent = questions;
            document.getElementById('qcPassing').textContent = passing + '%';
            document.getElementById('qcStartBtn').href = url;

            const noteEl = document.getElementById('qcNote');
            const btnText = document.getElementById('qcBtnText');
            if (state === 'passed') {
                noteEl.innerHTML = '<i class="bi bi-check-circle-fill" style="color:#43a047;"></i> Bạn đã đạt bài này. Có thể làm lại để cải thiện điểm.';
                btnText.textContent = 'Làm lại';
            } else if (state === 'retry') {
                noteEl.innerHTML = '<i class="bi bi-exclamation-circle-fill" style="color:#fb8c00;"></i> Bạn chưa đạt. Làm lại để hoàn thành bài học.';
                btnText.textContent = 'Làm lại';
            } else {
                noteEl.innerHTML = '<i class="bi bi-info-circle-fill" style="color:var(--navy);"></i> Hãy đọc kỹ bài học trước khi bắt đầu làm bài kiểm tra.';
                btnText.textContent = 'Bắt đầu';
            }

            const modal = document.getElementById('quizConfirmModal');
            modal.style.display = 'flex';
        }

        function closeQuizConfirm() {
            document.getElementById('quizConfirmModal').style.display = 'none';
        }

        // Đóng modal khi click ra ngoài
        document.getElementById('quizConfirmModal').addEventListener('click', function(e) {
            if (e.target === this) closeQuizConfirm();
        });

        function showCourseCompletedModal() {
            const modal = document.getElementById('courseCompletedModal');
            modal.style.display = 'flex';
        }

        $('#btnMarkComplete').on('click', function () {
            const $btn = $(this);
            const lessonId = $btn.data('lesson-id');
            const token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();

            $btn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> Đang xử lý...');

            $.ajax({
                url: '@Url.Action("MarkComplete", "Learn")',
                type: 'POST',
                data: { lessonId: lessonId, __RequestVerificationToken: token },
                success: function (res) {
                    if (res.success) {
                        if (res.courseCompleted) {
                            showCourseCompletedModal();
                        } else {
                            showToast(res.message, 'success');
                            setTimeout(() => location.reload(), 600);
                        }
                    } else {
                        showToast(res.message || 'Lỗi xảy ra', 'danger');
                        $btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i> Đánh dấu hoàn thành');
                    }
                },
                error: function () {
                    showToast('Lỗi kết nối!', 'danger');
                    $btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i> Đánh dấu hoàn thành');
                }
            });
        });
    </script>
}