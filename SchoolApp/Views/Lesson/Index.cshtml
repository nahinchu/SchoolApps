@using X.PagedList
@model IPagedList<SchoolApp.Models.Lesson>

@{
    ViewData["Title"] = L["Les_Title"].Value;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var moduleId = ViewData["ModuleId"] != null ? (int)ViewData["ModuleId"] : 0;
    var moduleName = ViewData["ModuleName"] as string ?? "";
    var courseId = ViewData["CourseId"] != null ? (int)ViewData["CourseId"] : 0;
}

@* ============================================================
   Fix: Toggle "Publish lesson" shows green when on, grey when off
   ============================================================ *@
<style>
    #lessonModal .ql-toolbar.ql-snow {
        border-radius: 6px 6px 0 0;
        background: #f8f9fa;
        border-color: #dee2e6;
    }
    #lessonModal .ql-container.ql-snow {
        border-color: #dee2e6;
    }
    #lessonModal .ql-editor {
        font-size: .9rem;
        color: #212529;
    }
    #lessonModal .ql-editor.ql-blank::before {
        color: #adb5bd;
        font-style: normal;
    }

    #lessonModal .form-switch .form-check-input {
        width: 2.5em;
        height: 1.25em;
        cursor: pointer;
    }

        #lessonModal .form-switch .form-check-input:checked {
            background-color: #198754 !important;
            border-color: #198754 !important;
        }

        #lessonModal .form-switch .form-check-input:not(:checked) {
            background-color: #adb5bd !important;
            border-color: #adb5bd !important;
        }

        #lessonModal .form-switch .form-check-input:focus {
            border-color: #198754 !important;
            box-shadow: 0 0 0 .2rem rgba(25, 135, 84, .25) !important;
        }

    #lessonModal .form-check-label {
        cursor: pointer;
        margin-left: .5rem;
    }
</style>

<div class="adm-page-header">
    <div>
        <div class="adm-page-title">📝 @L["Les_PageTitle"] — <span>@moduleName</span></div>
        <div class="adm-page-sub">@L["Les_Sub"]</div>
    </div>
</div>

<div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:1.5rem; flex-wrap:wrap;">
    <form id="searchForm" method="get" style="flex:1; max-width:440px; display:flex; gap:0;">
        <input type="hidden" name="moduleId" value="@moduleId" />
        <div style="position:relative; flex:1;">
            <i class="bi bi-search" style="position:absolute; left:11px; top:50%; transform:translateY(-50%); color:var(--adm-text-dim); font-size:.85rem;"></i>
            <input type="text" name="searchTerm" value="@ViewData["SearchTerm"]"
                   class="adm-input" placeholder="@L["Les_SearchPlaceholder"]"
                   style="padding-left:34px; border-radius:8px 0 0 8px;" />
        </div>
        <button type="submit" class="adm-btn adm-btn-primary" style="border-radius:0 8px 8px 0; padding:9px 18px; font-weight:600;">@L["Course_SearchBtn"]</button>
    </form>

    <button type="button" class="adm-btn adm-btn-primary" data-bs-toggle="modal" data-bs-target="#lessonModal"
            onclick="openCreateModal()">
        <i class="bi bi-plus-circle me-1"></i> @L["Les_AddNew"]
    </button>
</div>

<div id="lessonTableContainer">
    @{
        ViewData["ModuleId"] = moduleId;
    }
    @await Html.PartialAsync("_LessonTable", Model)
</div>

<!-- ==================== MODAL ==================== -->
<div class="modal fade" id="lessonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%); color: var(--gold-light);">
                <h5 id="lessonModalLabel">@L["Les_ModalAddTitle"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="modalResult"></div>
                <form id="lessonForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="LessonId" name="LessonId" value="0" />
                    <input type="hidden" id="ModuleId" name="ModuleId" value="@moduleId" />

                    <div class="row">
                        <div class="col-md-8">
                            <label class="sa-label">@L["Les_LessonTitle"] <span style="color:red">*</span></label>
                            <input type="text" id="Title" name="Title" class="sa-input" />
                            <div class="invalid-feedback" id="err-Title"></div>
                        </div>
                        <div class="col-md-4">
                            <label class="sa-label">@L["Les_LessonType"]</label>
                            <select id="Type" name="Type" class="sa-input">
                                <option value="0">@L["Les_TypeVideo"]</option>
                                <option value="1">@L["Les_TypeText"]</option>
                                <option value="2">@L["Les_TypeMixed"]</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label class="sa-label">@L["Les_VideoLesson"]</label>
                            <div class="btn-group w-100 mb-2" role="group">
                                <input type="radio" class="btn-check" name="VideoInputMode" id="modeUrl" value="url" autocomplete="off" checked>
                                <label class="btn btn-outline-secondary btn-sm" for="modeUrl">
                                    <i class="bi bi-link-45deg"></i> @L["Les_EnterUrl"]
                                </label>
                                <input type="radio" class="btn-check" name="VideoInputMode" id="modeFile" value="file" autocomplete="off">
                                <label class="btn btn-outline-secondary btn-sm" for="modeFile">
                                    <i class="bi bi-cloud-upload"></i> @L["Les_UploadVideo"]
                                </label>
                            </div>
                            <div id="videoUrlSection">
                                <input type="url" id="VideoUrl" name="VideoUrl" class="sa-input" placeholder="@L["Les_VideoUrlPlaceholder"]" />
                            </div>
                            <div id="videoFileSection" style="display:none;">
                                <input type="file" id="VideoFile" name="VideoFile" class="sa-input"
                                       accept=".mp4,.webm,.ogg,.mov" />
                                <div class="form-text text-muted">@L["Les_VideoSupport"]</div>
                                <div id="currentVideo" class="mt-2 p-2 bg-light border rounded" style="display:none;">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-file-earmark-play-fill text-primary fs-5"></i>
                                        <span id="currentVideoName" class="fw-bold text-truncate flex-grow-1"></span>
                                    </div>
                                    <div class="form-check mt-1">
                                        <input type="checkbox" id="RemoveVideo" name="RemoveVideo" value="true" class="form-check-input" />
                                        <label class="form-check-label text-danger small" for="RemoveVideo">@L["Les_RemoveVideo"]</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="sa-label">@L["Les_Duration"]</label>
                            <input type="number" id="DurationMinutes" name="DurationMinutes" class="sa-input" min="0" value="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="sa-label">@L["Les_OrderIndex"]</label>
                            <input type="number" id="OrderIndex" name="OrderIndex" class="sa-input" min="0" value="0" />
                        </div>
                    </div>

                    <div class="sa-form-group mt-3">
                        <label class="sa-label">@L["Les_Content"]</label>
                        <div id="quillEditor" style="height:260px; background:#fff; border-radius:0 0 6px 6px;"></div>
                        <textarea id="HtmlContent" name="HtmlContent" style="display:none;"></textarea>
                    </div>

                    <div class="sa-form-group mt-3">
                        <label class="sa-label">@L["Les_Attachment"]</label>
                        <input type="file" id="AttachmentFile" name="AttachmentFile" class="sa-input"
                               accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.zip,.rar,.mp4,.png,.jpg,.jpeg,.gif" />
                        <div class="form-text text-muted">@L["Les_AttachmentSupport"]</div>
                        <div id="currentAttachment" class="mt-2" style="display:none;">
                            <span class="text-muted">@L["Les_CurrentFile"] </span>
                            <a id="currentAttachmentLink" href="#" target="_blank" class="text-primary fw-bold">
                                <i class="bi bi-paperclip"></i> <span id="currentAttachmentName"></span>
                            </a>
                            <div class="form-check mt-1">
                                <input type="checkbox" id="RemoveAttachment" name="RemoveAttachment" value="true" class="form-check-input" />
                                <label class="form-check-label text-danger" for="RemoveAttachment">@L["Les_RemoveAttachment"]</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input type="checkbox" id="IsPublished" name="IsPublished" value="true" class="form-check-input" checked />
                        <label class="form-check-label" for="IsPublished">@L["Les_IsPublished"]</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="sa-btn sa-btn-outline" data-bs-dismiss="modal">@L["Btn_Cancel"]</button>
                <button type="button" class="sa-btn sa-btn-primary" id="btnSaveLesson">
                    <i class="bi bi-check-lg"></i> <span class="btn-text">@L["Les_SaveLesson"]</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

    <script>
        var isEditMode = false;
        var currentModuleId = @moduleId;
        var _lesModalAdd    = '➕ @L["Les_ModalAddTitle"]';
        var _lesModalEdit   = '✏️ @L["Les_ModalEditTitle"]';
        var _lesSave        = '@L["Les_SaveLesson"]';
        var _lesUpdate      = '@L["Les_Update"]';
        var _lesProcessing  = '@L["Les_Processing"]';
        var _lesLoadErr     = '@L["Les_LoadError"]';
        var _lesDelConf     = '@L["Les_DeleteConfirm"]';
        var _lesReorderOk   = '@L["Les_ReorderSuccess"]';
        var _lesReorderErr  = '@L["Les_ReorderError"]';
        var _lesContentPh   = '@L["Les_ContentPlaceholder"]';
        var _errAjaxPrefix  = '@L["Err_AjaxPrefix"]';
        var _errNoPermission = '@L["Err_NoPermission"]';
        var _errConnection  = '@L["Err_Connection"]';
        var _errGeneric     = '@L["Err_Generic"]';

        var quill = new Quill('#quillEditor', {
            theme: 'snow',
            placeholder: _lesContentPh,
            modules: {
                toolbar: [
                    [{ header: [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    ['link', 'image', 'blockquote', 'code-block'],
                    ['clean']
                ]
            }
        });

        function clearErrors() {
            $('#modalResult').html('');
            $('#lessonForm .sa-input, #lessonForm select').removeClass('is-invalid');
            $('#lessonForm [id^="err-"]').text('');
        }

        function setVideoMode(mode) {
            if (mode === 'file') {
                $('#modeFile').prop('checked', true);
                $('#videoUrlSection').hide();
                $('#videoFileSection').show();
            } else {
                $('#modeUrl').prop('checked', true);
                $('#videoUrlSection').show();
                $('#videoFileSection').hide();
            }
        }

        function openCreateModal() {
            isEditMode = false;
            $('#lessonModalLabel').text(_lesModalAdd);
            $('#btnSaveLesson .btn-text').text(_lesSave);
            $('#lessonForm')[0].reset();
            $('#LessonId').val(0);
            $('#ModuleId').val(currentModuleId);
            $('#Type').val(0);
            $('#IsPublished').prop('checked', true);
            $('#currentAttachment').hide();
            $('#currentVideo').hide();
            setVideoMode('url');
            quill.setContents([]);
            clearErrors();
            $('#lessonModal').modal('show');
        }

        function openEditModal(id) {
            isEditMode = true;
            $('#lessonModalLabel').text(_lesModalEdit);
            $('#btnSaveLesson .btn-text').text(_lesUpdate);
            clearErrors();

            $.get('@Url.Action("GetLesson", "Lesson")/' + id, function (data) {
                $('#LessonId').val(data.lessonId);
                $('#Title').val(data.title);
                $('#Type').val(data.type === 'Video' ? 0 : data.type === 'Text' ? 1 : 2);
                quill.clipboard.dangerouslyPasteHTML(data.htmlContent || '');
                $('#DurationMinutes').val(data.durationMinutes || 0);
                $('#OrderIndex').val(data.orderIndex);
                $('#IsPublished').prop('checked', data.isPublished);
                $('#ModuleId').val(data.moduleId);
                $('#AttachmentFile').val('');
                $('#RemoveAttachment').prop('checked', false);
                $('#VideoFile').val('');
                $('#RemoveVideo').prop('checked', false);

                var isUploadedVideo = data.videoUrl && (data.videoUrl.includes('res.cloudinary.com') || data.videoUrl.startsWith('/File/Video'));
                if (isUploadedVideo) {
                    setVideoMode('file');
                    var videoLabel = data.videoUrl.startsWith('/File/Video')
                        ? decodeURIComponent(data.videoUrl.split('path=')[1] || '').split('/').pop()
                        : data.videoUrl.split('/').pop();
                    $('#currentVideoName').text(videoLabel);
                    $('#currentVideo').show();
                } else {
                    setVideoMode('url');
                    $('#VideoUrl').val(data.videoUrl || '');
                    $('#currentVideo').hide();
                }

                if (data.attachmentPath) {
                    $('#currentAttachmentLink').attr('href', data.attachmentPath);
                    $('#currentAttachmentName').text(data.attachmentPath.split('/').pop());
                    $('#currentAttachment').show();
                } else {
                    $('#currentAttachment').hide();
                }

                $('#lessonModal').modal('show');
            }).fail(function () {
                showToast(_lesLoadErr, 'danger');
            });
        }

        $(function () {
            $('#btnSaveLesson').on('click', function () {
                clearErrors();
                $('#HtmlContent').val(quill.root.innerHTML === '<p><br></p>' ? '' : quill.root.innerHTML);
                var $btn = $(this);
                var url = isEditMode ? '@Url.Action("EditAjax", "Lesson")' : '@Url.Action("CreateAjax", "Lesson")';
                var formData = new FormData($('#lessonForm')[0]);

                if (!$('#IsPublished').is(':checked')) {
                    formData.set('IsPublished', 'false');
                } else {
                    formData.set('IsPublished', 'true');
                }

                $btn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> <span class="btn-text">' + _lesProcessing + '</span>');

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success) {
                            $('#lessonModal').modal('hide');
                            showToast(res.message, 'success');
                            loadLessons(1);
                        } else if (res.errors) {
                            $.each(res.errors, function (field, messages) {
                                $('#' + field).addClass('is-invalid');
                                $('#err-' + field).text(messages.join(', '));
                            });
                        } else {
                            showToast(res.message || _errGeneric, 'danger');
                        }
                    },
                    error: function (xhr) {
                        showToast(_errAjaxPrefix + (xhr.status === 403 ? _errNoPermission : _errConnection), 'danger');
                    },
                    complete: function () {
                        var label = isEditMode ? _lesUpdate : _lesSave;
                        $btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i> <span class="btn-text">' + label + '</span>');
                    }
                });
            });

            $('input[name="VideoInputMode"]').on('change', function () {
                setVideoMode($(this).val());
            });

            $('#searchForm').on('submit', function (e) { e.preventDefault(); loadLessons(1); });

            $(document).on('click', '.ajax-page-link', function (e) {
                e.preventDefault();
                var match = $(this).attr('href').match(/page=(\d+)/);
                loadLessons(match ? parseInt(match[1]) : 1);
            });

            $(document).on('click', '.btn-delete-lesson', function () {
                if (!confirm(_lesDelConf)) return;
                var id = $(this).data('id');
                var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("Delete", "Lesson")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function (res) {
                        if (res.success) {
                            showToast(res.message, 'success');
                            loadLessons(1);
                        } else {
                            showToast(res.message, 'danger');
                        }
                    }
                });
            });

            function initSortable() {
                var tbody = document.getElementById('lessonTableBody');
                if (!tbody) return;
                Sortable.create(tbody, {
                    handle: '.bi-grip-vertical',
                    animation: 150,
                    onEnd: function() {
                        var ids = Array.from(tbody.querySelectorAll('tr[data-id]'))
                                       .map(tr => parseInt(tr.dataset.id));
                        var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
                        $.ajax({
                            url: '@Url.Action("ReorderAjax", "Lesson")',
                            type: 'POST',
                            contentType: 'application/json',
                            headers: { 'RequestVerificationToken': token },
                            data: JSON.stringify({ ids: ids }),
                            success: function(res) {
                                if (res.success) showToast(_lesReorderOk, 'success');
                            },
                            error: function() { showToast(_lesReorderErr, 'danger'); }
                        });
                    }
                });
            }

            initSortable();

            window.loadLessons = function (page = 1) {
                var searchTerm = $('#searchForm input[name="searchTerm"]').val();
                $.ajax({
                    url: '@Url.Action("Index", "Lesson")',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    data: { moduleId: currentModuleId, searchTerm: searchTerm, page: page },
                    success: function (html) {
                        $('#lessonTableContainer').html(html);
                        initSortable();
                    }
                });
            };

            window.showToast = function (message, type = 'success') {
                var cls = type === 'success' ? 'sa-alert-success' : 'sa-alert-danger';
                var icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
                var toast = $(`<div class="sa-alert ${cls}" style="position:fixed;top:1rem;right:1rem;z-index:9999;min-width:320px;">
                    <span class="sa-alert-icon"><i class="bi ${icon}"></i></span>
                    <span>${message}</span>
                    <button class="sa-alert-close" onclick="$(this).parent().remove()"><i class="bi bi-x"></i></button>
                </div>`);
                $('body').append(toast);
                setTimeout(() => toast.fadeOut(400, () => toast.remove()), 3000);
            };
        });
    </script>
}
