@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<SchoolApp.Models.User>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SchoolApp.Resources.MyLanguage> L
@{
    var role = Context.Session.GetString("Role");
    var isAdmin = role == "Admin";
    var searchTerm = ViewData["SearchTerm"] as string;
}
<div class="adm-table-wrap">
    <table class="adm-table adm-table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>@L["Stu_ColName"]</th>
                <th>Email</th>
                <th>@L["Stu_ColPhone"]</th>
                <th>@L["Stu_ColDateOfBirth"]</th>
                <th>@L["Stu_ColRegDate"]</th>
                <th class="text-center">@L["Stu_ColActions"]</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" style="text-align:center; padding:2.5rem; color:rgba(255,255,255,0.3);">
                        <i class="bi bi-people" style="font-size:2rem; display:block; margin-bottom:.5rem;"></i>
                        @L["Stu_NoStudents"]
                    </td>
                </tr>
            }
            else
            {
                int i = (Model.PageNumber - 1) * Model.PageSize + 1;
                foreach (var s in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td style="font-weight:600;">@s.FullName</td>
                        <td style="color:rgba(201,168,76,0.8);">@s.Email</td>
                        <td>@s.Phone</td>
                        <td>@s.DateOfBirth?.ToString("dd/MM/yyyy")</td>
                        <td>@s.RegisteredDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center" style="white-space:nowrap;">
                            <button type="button" class="adm-btn adm-btn-info adm-btn-sm"
                                    onclick="openDetailModal(@s.UserId)">
                                <i class="bi bi-eye"></i> @L["Btn_Detail"]
                            </button>
                            @if (isAdmin)
                            {
                                <button type="button" class="adm-btn adm-btn-warning adm-btn-sm"
                                        onclick="openEditModal(@s.UserId)">
                                    <i class="bi bi-pencil"></i> @L["Btn_Edit"]
                                </button>
                                <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-delete-student"
                                        data-id="@s.UserId">
                                    <i class="bi bi-trash"></i> @L["Btn_Delete"]
                                </button>
                            }
                        </td>
                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>
</div>
<div class="d-flex justify-content-between align-items-center mt-3">
    <span style="color:rgba(255,255,255,0.45); font-size:.82rem;">
        @L["Stu_Page"] @Model.PageNumber / @Model.PageCount
        (@L["Adm_Total"]: @Model.TotalItemCount @L["Stu_TotalStudents"])
    </span>
    @Html.PagedListPager(Model,
    page => Url.Action("Index", new { page, searchTerm }),
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link ajax-page-link" },
            UlElementClasses = new[] { "pagination" }
        })
</div>
