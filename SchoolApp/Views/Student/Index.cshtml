@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<SchoolApp.Models.User>
@{
    ViewData["Title"] = L["Stu_Title"].Value;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var role = Context.Session.GetString("Role");
    var isAdmin = role == "Admin";
    var isAdminOrManager = role == "Admin" || role == "Manager";
}

<!-- ==================== PAGE HEADER ==================== -->
<div class="adm-page-header">
    <div>
        <div class="adm-page-title">👥 @L["Stu_Title"]</div>
        <div class="adm-page-sub">@L["Stu_Sub"]</div>
    </div>
</div>

<!-- ==================== TOOLBAR ==================== -->
<div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:20px; flex-wrap:wrap;">
    <form id="searchForm" method="get" style="flex:1; max-width:440px; display:flex; gap:0;">
        <div style="position:relative; flex:1;">
            <i class="bi bi-search" style="position:absolute; left:11px; top:50%; transform:translateY(-50%); color:var(--adm-text-dim); font-size:.85rem;"></i>
            <input type="text" name="searchTerm" value="@ViewData["SearchTerm"]"
                   class="adm-input" placeholder="@L["Stu_SearchPlaceholder"]"
                   style="padding-left:34px; border-radius:8px 0 0 8px;" />
        </div>
        <button type="submit" class="adm-btn adm-btn-primary" style="border-radius:0 8px 8px 0; padding:9px 18px; font-weight:600;">
            @L["Course_SearchBtn"]
        </button>
    </form>

    @if (isAdminOrManager)
    {
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <a id="btnExport" href="@Url.Action("ExportExcel", "Student", new { searchTerm = ViewData["SearchTerm"] })"
               class="adm-btn" style="background:rgba(29,122,58,0.9); color:#fff; border:none;">
                <i class="bi bi-file-earmark-excel"></i> @L["Btn_Export"]
            </a>
            <button type="button" class="adm-btn" style="background:rgba(13,110,253,0.9); color:#fff; border:none;"
                    data-bs-toggle="modal" data-bs-target="#importModal">
                <i class="bi bi-upload"></i> @L["Btn_Import"]
            </button>
            <button type="button" class="adm-btn adm-btn-primary"
                    data-bs-toggle="modal" data-bs-target="#studentModal"
                    onclick="openCreateModal()">
                <i class="bi bi-person-plus"></i> @L["Stu_AddNew"]
            </button>
        </div>
    }
</div>

<!-- ==================== TABLE ==================== -->
<div id="studentTableContainer">
    @await Html.PartialAsync("_StudentTable", Model)
</div>

<!-- ==================== MODAL CREATE / EDIT ==================== -->
<div class="modal fade" id="studentModal" tabindex="-1" aria-labelledby="studentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="border:none; border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-lg);">

            <!-- Header -->
            <div class="modal-header" style="
                background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
                padding:1.25rem 1.5rem; border:none;
            ">
                <h5 id="studentModalLabel" style="
                    font-family:var(--font-display); font-size:1.15rem; font-weight:600;
                    color:var(--gold-light); margin:0;
                ">
                    @L["Stu_AddNew"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Btn_Close"]"></button>
            </div>

            <!-- Body -->
            <div class="modal-body" style="padding:1.5rem; background:var(--white);">
                <div id="modalResult" style="margin-bottom:1rem;"></div>
                <form id="studentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="userId" name="UserId" value="0" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="sa-form-group">
                                <label class="sa-label" for="FullName">
                                    @L["Stu_ColName"] <span style="color:var(--danger)">*</span>
                                </label>
                                <input type="text" id="FullName" name="FullName"
                                       class="sa-input" placeholder="@L["Stu_FullNamePlaceholder"]" />
                                <div class="invalid-feedback" id="err-FullName"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="sa-form-group">
                                <label class="sa-label" for="Email">
                                    Email <span style="color:var(--danger)">*</span>
                                </label>
                                <input type="email" id="Email" name="Email"
                                       class="sa-input" placeholder="example@email.com" />
                                <div class="invalid-feedback" id="err-Email"></div>
                            </div>
                        </div>
                    </div>

                    <div class="row" id="passwordRow">
                        <div class="col-md-6">
                            <div class="sa-form-group">
                                <label class="sa-label" for="Password">
                                    @L["Adm_Password"] <span style="color:var(--danger)">*</span>
                                </label>
                                <input type="password" id="Password" name="Password"
                                       class="sa-input" placeholder="@L["Stu_PasswordPlaceholder"]" />
                                <div class="invalid-feedback" id="err-Password"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="sa-form-group">
                                <label class="sa-label" for="Phone">
                                    @L["Adm_Phone"] <span style="color:var(--danger)">*</span>
                                </label>
                                <input type="text" id="Phone" name="Phone"
                                       class="sa-input" placeholder="@L["Stu_PhonePlaceholder"]" />
                                <div class="invalid-feedback" id="err-Phone"></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="sa-form-group">
                                <label class="sa-label" for="DateOfBirth">@L["Stu_DateOfBirth"]</label>
                                <input type="date" id="DateOfBirth" name="DateOfBirth" class="sa-input" />
                                <div class="invalid-feedback" id="err-DateOfBirth"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="sa-form-group">
                                <label class="sa-label" for="Address">@L["Stu_Address"]</label>
                                <input type="text" id="Address" name="Address"
                                       class="sa-input" placeholder="@L["Stu_AddressPlaceholder"]" />
                                <div class="invalid-feedback" id="err-Address"></div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="modal-footer" style="padding:1rem 1.5rem; background:var(--off-white); border-top:1px solid var(--smoke);">
                <button type="button" class="sa-btn sa-btn-outline" data-bs-dismiss="modal">@L["Btn_Cancel"]</button>
                <button type="button" class="sa-btn sa-btn-primary" id="btnSaveStudent">
                    <i class="bi bi-check-lg"></i> <span class="btn-text">@L["Btn_Save"]</span>
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ==================== MODAL CHI TIẾT ==================== -->
<div class="modal fade" id="studentDetailModal" tabindex="-1" aria-labelledby="studentDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="border:none; border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-lg);">

            <div class="modal-header" style="
                background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
                padding:1.25rem 1.5rem; border:none;">
                <h5 id="studentDetailModalLabel" style="
                    font-family:var(--font-display); font-size:1.15rem; font-weight:600;
                    color:var(--gold-light); margin:0;">
                    👤 @L["Stu_ModalDetailTitle"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Btn_Close"]"></button>
            </div>

            <div class="modal-body" id="studentDetailBody" style="padding:1.5rem; background:var(--white);">
                <div style="text-align:center; padding:2rem 0;">
                    <div class="spinner-border" style="color:var(--gold);" role="status"></div>
                    <p style="margin-top:.75rem; color:var(--text-light);">@L["Stu_Loading"]</p>
                </div>
            </div>

            <div class="modal-footer" style="padding:1rem 1.5rem; background:var(--off-white); border-top:1px solid var(--smoke);">
                <button type="button" class="sa-btn sa-btn-outline" data-bs-dismiss="modal">@L["Btn_Cancel"]</button>
            </div>

        </div>
    </div>
</div>

<!-- ==================== MODAL IMPORT EXCEL ==================== -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:520px;">
        <div class="modal-content" style="border:none; border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-lg);">

            <div class="modal-header" style="
                background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
                padding:1.25rem 1.5rem; border:none;">
                <h5 id="importModalLabel" style="
                    font-family:var(--font-display); font-size:1.1rem; font-weight:600;
                    color:#fff; margin:0;">
                    <i class="bi bi-upload me-2"></i>@L["Stu_ImportTitle"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" style="padding:1.5rem; background:var(--white);">
                <div style="
                    background:#f0f7ff; border:1px solid #bdd7f5;
                    border-radius:var(--radius-sm); padding:.85rem 1rem; margin-bottom:1.25rem;
                    display:flex; align-items:center; gap:.75rem;">
                    <i class="bi bi-info-circle-fill" style="color:#0d6efd; font-size:1.1rem; flex-shrink:0;"></i>
                    <div style="font-size:.85rem; color:var(--text-mid); line-height:1.5;">
                        @Html.Raw(L["Stu_ImportDefaultPwd"])
                        <br>
                        <a href="@Url.Action("DownloadImportTemplate", "Student")"
                           style="color:#0d6efd; font-weight:600; text-decoration:none;">
                            <i class="bi bi-download me-1"></i>@L["Stu_DownloadTemplate"]
                        </a>
                    </div>
                </div>

                <form id="importForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="sa-form-group">
                        <label class="sa-label">@L["Stu_SelectFile"]</label>
                        <input type="file" id="importFile" name="file" accept=".xlsx"
                               class="sa-input" style="padding:.45rem .75rem;" />
                    </div>
                </form>

                <div id="importResult" style="display:none; margin-top:1rem;"></div>
            </div>

            <div class="modal-footer" style="padding:1rem 1.5rem; background:var(--off-white); border-top:1px solid var(--smoke);">
                <button type="button" class="sa-btn sa-btn-outline" data-bs-dismiss="modal">@L["Btn_Cancel"]</button>
                <button type="button" class="sa-btn" id="btnImport"
                        style="background:#0d6efd; color:#fff; border:none; min-width:110px;">
                    <span class="btn-text"><i class="bi bi-upload me-1"></i>@L["Btn_Import"]</span>
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
    <script>
        var isEditMode = false;
        var _stuColName      = '@L["Stu_ColName"]';
        var _stuColPhone     = '@L["Stu_ColPhone"]';
        var _stuDateOfBirth  = '@L["Stu_DateOfBirth"]';
        var _stuAddress      = '@L["Stu_Address"]';
        var _stuRegDate      = '@L["Stu_RegDate"]';
        var _stuCourses      = '@L["Stu_EnrolledCourses"]';
        var _stuEnrDate      = '@L["Enr_ColEnrollDate"]';
        var _stuNoEnr        = '@L["Stu_NoEnrollments"]';
        var _stuLoadErr      = '@L["Stu_LoadDetailError"]';
        var _stuNoPerm       = '@L["Stu_NoPermission"]';
        var _stuDelConf      = '@L["Stu_DeleteConfirm"]';
        var _stuAddTitle     = '➕ @L["Stu_ModalAddTitle"]';
        var _stuEditTitle    = '✏️ @L["Stu_ModalEditTitle"]';
        var _stuSave         = '@L["Btn_Save"]';
        var _stuUpdate       = '@L["Btn_Update"]';
        var _stuProcessing   = '...' ;
        var _stuColCourse    = '@L["AdminCourses"]';
        var _stuColPoints    = '@L["QB_ColPoints"]';
        var _stuAjaxError    = '@L["Stu_AjaxError"]';
        var _stuLoadDataErr  = '@L["Stu_LoadDataError"]';
        var _stuServerError  = '@L["Stu_ServerError"]';
        var _stuBtnImport    = '<i class="bi bi-upload me-1"></i> @L["Stu_ImportBtn"]';
        var _stuImportSelFile = '@L["Stu_ImportSelectFile"]';
        var _stuImportProc   = '@L["Stu_ImportProcessing"]';
        var _stuImportAdded  = '@L["Stu_ImportAdded"]';
        var _stuImportStuWrd = '@L["Stu_ImportStudentWord"]';
        var _stuImportSkip   = '@L["Stu_ImportSkippedWord"]';
        var _stuImportRow    = '@L["Stu_ImportRowPrefix"]';
        var _stuImportNoData = '@L["Stu_ImportNoData"]';

        // ====== MỞ MODAL CHI TIẾT ======
        function openDetailModal(id) {
            $('#studentDetailBody').html(
                '<div style="text-align:center; padding:2rem 0;">' +
                '<div class="spinner-border" style="color:var(--gold);" role="status"></div>' +
                '</div>'
            );
            $('#studentDetailModal').modal('show');

            $.get('@Url.Action("GetStudentDetails", "Student")/' + id, function (data) {
                var enrollHtml = '';
                if (data.enrollments.length === 0) {
                    enrollHtml = '<tr><td colspan="3" style="text-align:center; color:var(--text-light); padding:1.25rem;">' + _stuNoEnr + '</td></tr>';
                } else {
                    $.each(data.enrollments, function (_, e) {
                        enrollHtml +=
                            '<tr>' +
                            '<td>' + $('<span>').text(e.courseName).html() + '</td>' +
                            '<td>' + $('<span>').text(e.enrollDate).html() + '</td>' +
                            '<td>' + $('<span>').text(e.grade).html() + '</td>' +
                            '</tr>';
                    });
                }

                $('#studentDetailBody').html(
                    '<div style="display:grid; grid-template-columns:1fr 1fr; gap:.75rem 2rem; margin-bottom:1.5rem;">' +
                        '<div><span class="sa-label" style="margin-bottom:2px;">' + _stuColName + '</span><div style="font-weight:600; color:var(--text-dark);">' + $('<span>').text(data.fullName).html() + '</div></div>' +
                        '<div><span class="sa-label" style="margin-bottom:2px;">Email</span><div style="color:var(--text-dark);">' + $('<span>').text(data.email).html() + '</div></div>' +
                        '<div><span class="sa-label" style="margin-bottom:2px;">' + _stuColPhone + '</span><div style="color:var(--text-dark);">' + $('<span>').text(data.phone).html() + '</div></div>' +
                        '<div><span class="sa-label" style="margin-bottom:2px;">' + _stuDateOfBirth + '</span><div style="color:var(--text-dark);">' + $('<span>').text(data.dateOfBirth).html() + '</div></div>' +
                        '<div><span class="sa-label" style="margin-bottom:2px;">' + _stuAddress + '</span><div style="color:var(--text-dark);">' + $('<span>').text(data.address).html() + '</div></div>' +
                        '<div><span class="sa-label" style="margin-bottom:2px;">' + _stuRegDate + '</span><div style="color:var(--text-dark);">' + $('<span>').text(data.registeredDate).html() + '</div></div>' +
                    '</div>' +
                    '<div style="height:1px; background:var(--smoke); margin-bottom:1.25rem;"></div>' +
                    '<h6 style="font-family:var(--font-display); font-weight:600; color:var(--navy); margin-bottom:.75rem;">📚 ' + _stuCourses + '</h6>' +
                    '<div class="sa-table-wrap"><table class="sa-table">' +
                    '<thead><tr><th>' + _stuColCourse + '</th><th>' + _stuEnrDate + '</th><th>' + _stuColPoints + '</th></tr></thead>' +
                    '<tbody>' + enrollHtml + '</tbody>' +
                    '</table></div>'
                );
            }).fail(function () {
                $('#studentDetailBody').html(
                    '<div class="sa-alert sa-alert-danger"><span class="sa-alert-icon"><i class="bi bi-exclamation-circle-fill"></i></span><span>' + _stuLoadErr + '</span></div>'
                );
            });
        }

        function clearErrors() {
            $('#modalResult').html('');
            $('#studentForm .sa-input').removeClass('is-invalid');
            $('#studentForm [id^="err-"]').text('');
        }

        // ====== MỞ MODAL TẠO MỚI ======
        function openCreateModal() {
            isEditMode = false;
            $('#studentModalLabel').text(_stuAddTitle);
            $('#btnSaveStudent .btn-text').text(_stuSave);
            $('#studentForm')[0].reset();
            $('#userId').val(0);
            clearErrors();
            $('#passwordRow').show();
            $('#Email').closest('.col-md-6').show();
            $('#Email').prop('disabled', false).attr('name', 'Email');
            $('#Password').prop('disabled', false).attr('name', 'Password');
        }

        // ====== MỞ MODAL CHỈNH SỬA ======
        function openEditModal(id) {
            isEditMode = true;
            $('#studentModalLabel').text(_stuEditTitle);
            $('#btnSaveStudent .btn-text').text(_stuUpdate);
            clearErrors();

            $.get('@Url.Action("GetStudent", "Student")/' + id, function (data) {
                $('#userId').val(data.UserId);
                $('#FullName').val(data.fullName);
                $('#Email').val(data.email);
                $('#Phone').val(data.phone);
                $('#DateOfBirth').val(data.dateOfBirth);
                $('#Address').val(data.address);
                $('#passwordRow').hide();
                $('#Password').prop('disabled', true).removeAttr('name');
                $('#Email').prop('disabled', true).removeAttr('name');
                $('#studentModal').modal('show');
            }).fail(function () {
                showToast(_stuLoadErr, 'danger');
            });
        }

        $(function () {
            $(document).on('input change', '#studentForm input, #studentForm textarea', function () {
                $(this).removeClass('is-invalid');
                $('#err-' + $(this).attr('id')).text('');
                $('#modalResult').html('');
            });

            // ====== LƯU ======
            $('#btnSaveStudent').on('click', function () {
                clearErrors();
                var url = isEditMode
                    ? '@Url.Action("EditAjax", "Student")'
                    : '@Url.Action("CreateAjax", "Student")';

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: $('#studentForm').serialize(),
                    success: function (res) {
                        if (res.success) {
                            $('#studentModal').modal('hide');
                            showToast(res.message, 'success');
                            loadStudents(1);
                        } else if (res.errors) {
                            $.each(res.errors, function (field, messages) {
                                $('#' + field).addClass('is-invalid');
                                $('#err-' + field).text(messages.join(', '));
                            });
                        } else {
                            $('#modalResult').html(
                                '<div class="sa-alert sa-alert-danger"><span class="sa-alert-icon"><i class="bi bi-exclamation-circle-fill"></i></span><span>' + $('<span>').text(res.message).html() + '</span></div>'
                            );
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) showToast(_stuNoPerm, 'danger');
                        else showToast(_stuAjaxError + xhr.statusText, 'danger');
                    }
                });
            });

            // ====== TÌM KIẾM ======
            $('#searchForm').on('submit', function (e) {
                e.preventDefault();
                loadStudents(1);
            });

            // ====== PHÂN TRANG ======
            $(document).on('click', '.ajax-page-link', function (e) {
                e.preventDefault();
                var match = $(this).attr('href').match(/page=(\d+)/);
                loadStudents(match ? match[1] : 1);
            });

            // ====== XÓA ======
            $(document).on('click', '.btn-delete-student', function () {
                if (!confirm(_stuDelConf)) return;
                var id = $(this).data('id');
                var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("DeleteAjax", "Student")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function (res) {
                        if (res.success) { showToast(res.message, 'success'); loadStudents(1); }
                        else { showToast(res.message, 'danger'); }
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) showToast(_stuNoPerm, 'danger');
                        else showToast(_stuAjaxError + xhr.statusText, 'danger');
                    }
                });
            });

            // ====== LOAD BẢNG ======
            function loadStudents(page) {
                var searchTerm = $('#searchForm input[name="searchTerm"]').val();
                $.ajax({
                    url: '@Url.Action("Index", "Student")',
                    type: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    data: { searchTerm: searchTerm, page: page },
                    success: function (html) {
                        $('#studentTableContainer').html(html);
                    },
                    error: function (xhr) {
                        showToast(_stuLoadDataErr + xhr.statusText, 'danger');
                    }
                });
                // Cập nhật link export theo từ khóa hiện tại
                var exportUrl = '@Url.Action("ExportExcel", "Student")';
                if (searchTerm) exportUrl += '?searchTerm=' + encodeURIComponent(searchTerm);
                $('#btnExport').attr('href', exportUrl);
            }

            // ====== IMPORT EXCEL ======
            $('#importModal').on('hidden.bs.modal', function () {
                $('#importForm')[0].reset();
                $('#importResult').hide().html('');
                $('#btnImport .btn-text').html(_stuBtnImport);
                $('#btnImport').prop('disabled', false);
            });

            $('#btnImport').on('click', function () {
                var fileInput = $('#importFile')[0];
                if (!fileInput.files.length) {
                    showImportResult('danger', _stuImportSelFile);
                    return;
                }

                var formData = new FormData($('#importForm')[0]);
                // Token CSRF đã được new FormData(form) tự động lấy từ hidden input
                // do @Html.AntiForgeryToken() sinh ra — không cần append thêm

                $('#btnImport .btn-text').html(
                    '<span class="spinner-border spinner-border-sm me-1"></span>' + _stuImportProc
                );
                $('#btnImport').prop('disabled', true);
                $('#importResult').hide();

                $.ajax({
                    url: '@Url.Action("ImportExcel", "Student")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        $('#btnImport .btn-text').html(_stuBtnImport);
                        $('#btnImport').prop('disabled', false);

                        if (!res.success) {
                            showImportResult('danger', res.message);
                            return;
                        }

                        var html = '';
                        if (res.added > 0) {
                            html += '<div class="sa-alert sa-alert-success" style="margin-bottom:.75rem;">' +
                                '<span class="sa-alert-icon"><i class="bi bi-check-circle-fill"></i></span>' +
                                '<span>' + _stuImportAdded + ' <strong>' + res.added + '</strong> ' + _stuImportStuWrd + '</span>' +
                                '</div>';
                        }

                        if (res.skipped && res.skipped.length > 0) {
                            html += '<div class="sa-alert sa-alert-danger" style="margin-bottom:.5rem;">' +
                                '<span class="sa-alert-icon"><i class="bi bi-exclamation-triangle-fill"></i></span>' +
                                '<span><strong>' + res.skipped.length + '</strong> ' + _stuImportSkip + '</span>' +
                                '</div>';
                            html += '<ul style="margin:0; padding-left:1.25rem; font-size:.82rem; color:var(--text-mid);">';
                            $.each(res.skipped, function (_, s) {
                                var prefix = s.row > 0 ? (_stuImportRow + ' ' + s.row + ': ') : '';
                                html += '<li>' + prefix + $('<span>').text(s.reason).html() + '</li>';
                            });
                            html += '</ul>';
                        }

                        if (res.added === 0 && (!res.skipped || res.skipped.length === 0)) {
                            html = '<div class="sa-alert sa-alert-danger">' +
                                '<span class="sa-alert-icon"><i class="bi bi-info-circle-fill"></i></span>' +
                                '<span>' + _stuImportNoData + '</span></div>';
                        }

                        $('#importResult').html(html).show();

                        if (res.added > 0) {
                            loadStudents(1);
                        }
                    },
                    error: function (xhr) {
                        $('#btnImport .btn-text').html(_stuBtnImport);
                        $('#btnImport').prop('disabled', false);
                        if (xhr.status === 403)
                            showImportResult('danger', _stuNoPerm);
                        else
                            showImportResult('danger', _stuServerError + xhr.statusText);
                    }
                });
            });

            function showImportResult(type, message) {
                var cls  = type === 'success' ? 'sa-alert-success' : 'sa-alert-danger';
                var icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
                $('#importResult').html(
                    '<div class="sa-alert ' + cls + '">' +
                    '<span class="sa-alert-icon"><i class="bi ' + icon + '"></i></span>' +
                    '<span>' + $('<span>').text(message).html() + '</span></div>'
                ).show();
            }

            // ====== TOAST ======
            window.showToast = function (message, type) {
                var cls = type === 'success' ? 'sa-alert-success' : 'sa-alert-danger';
                var icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
                var toast = $('<div class="sa-alert ' + cls + '" style="position:fixed; top:1rem; right:1rem; z-index:9999; min-width:300px; max-width:450px; box-shadow:var(--shadow-md);">' +
                    '<span class="sa-alert-icon"><i class="bi ' + icon + '"></i></span>' +
                    '<span>' + $('<span>').text(message).html() + '</span>' +
                    '<button class="sa-alert-close" onclick="$(this).parent().remove()"><i class="bi bi-x"></i></button>' +
                    '</div>');
                $('body').append(toast);
                setTimeout(function () { toast.fadeOut(300, function () { $(this).remove(); }); }, 3000);
            };
        });
    </script>
}