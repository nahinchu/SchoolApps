@model List<SchoolApp.Models.Notification>
@{
    ViewData["Title"] = L["Notif_Title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div style="max-width:720px; margin:2rem auto;">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; flex-wrap:wrap; gap:.75rem;">
        <h2 style="color:var(--gold-light); margin:0;">
            <i class="bi bi-bell-fill"></i> @L["Notif_Title"]
            @if (unreadCount > 0)
            {
                <span style="display:inline-block; margin-left:.4rem; padding:.1rem .5rem; background:var(--gold); color:#0d1b2a; border-radius:20px; font-size:.65rem; font-weight:800; vertical-align:middle;">
                    @unreadCount @L["Notif_NewCount"]
                </span>
            }
        </h2>
        <div style="display:flex; align-items:center; gap:.5rem;">
            <span style="font-size:.85rem; color:rgba(255,255,255,.45);">@Model.Count @L["Notif_TotalCount"]</span>
            @if (unreadCount > 0)
            {
                <button id="btnMarkAllRead" style="
                    padding:.35rem .85rem; border-radius:var(--radius-sm); border:1px solid rgba(201,168,76,.4);
                    background:rgba(201,168,76,.1); color:var(--gold-light); font-size:.8rem; font-weight:600;
                    cursor:pointer; transition:all .2s;">
                    <i class="bi bi-check2-all me-1"></i> @L["Notif_MarkAllRead"]
                </button>
            }
        </div>
    </div>

    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

    @if (!Model.Any())
    {
        <div style="text-align:center; padding:4rem 2rem; background:var(--navy-light); border-radius:16px; border:1px solid rgba(255,255,255,.08);">
            <i class="bi bi-bell-slash" style="font-size:3rem; color:rgba(255,255,255,.2); display:block; margin-bottom:1rem;"></i>
            <p style="color:rgba(255,255,255,.4); margin:0;">@L["Notif_None"]</p>
        </div>
    }
    else
    {
        <div id="notifList" style="display:flex; flex-direction:column; gap:.75rem;">
            @foreach (var n in Model)
            {
                <div style="background:var(--navy-light); border-radius:12px; padding:1rem 1.25rem;
                            border:1px solid @(n.IsRead ? "rgba(255,255,255,.08)" : "rgba(201,168,76,.35)");
                            @(n.IsRead ? "" : "box-shadow:0 0 0 1px rgba(201,168,76,.15);")">
                    <div style="display:flex; align-items:flex-start; gap:.75rem;">
                        <div style="width:36px; height:36px; flex-shrink:0; border-radius:50%;
                                    background:@(n.IsRead ? "rgba(255,255,255,.07)" : "rgba(201,168,76,.15)");
                                    display:flex; align-items:center; justify-content:center;">
                            <i class="bi @(n.IsRead ? "bi-bell" : "bi-bell-fill")"
                               style="color:@(n.IsRead ? "rgba(255,255,255,.35)" : "var(--gold-light)"); font-size:.9rem;"></i>
                        </div>
                        <div style="flex:1; min-width:0;">
                            <div style="display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; margin-bottom:.3rem;">
                                <strong style="color:@(n.IsRead ? "rgba(255,255,255,.7)" : "#fff"); font-size:.9rem;">@n.Title</strong>
                                @if (!n.IsRead)
                                {
                                    <span style="width:7px; height:7px; border-radius:50%; background:var(--gold-light); flex-shrink:0;"></span>
                                }
                            </div>
                            <p style="color:rgba(255,255,255,.55); font-size:.84rem; margin:0 0 .4rem;">@n.Message</p>
                            <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.5rem;">
                                <span style="font-size:.75rem; color:rgba(255,255,255,.3);">
                                    <i class="bi bi-clock"></i>
                                    @n.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </span>
                                @if (!string.IsNullOrEmpty(n.Link))
                                {
                                    <a href="@n.Link" style="font-size:.8rem; color:var(--gold-light); text-decoration:none;">
                                        @L["Notif_ViewDetail"] <i class="bi bi-arrow-right"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        var _notifProcessing = '<span class="spinner-border spinner-border-sm me-1"></span> @L["Notif_Processing"]';
        var _notifMarkAllRead = '<i class="bi bi-check2-all me-1"></i> @L["Notif_MarkAllRead"]';

        $('#btnMarkAllRead').on('click', function () {
            var btn = $(this);
            var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
            btn.prop('disabled', true).html(_notifProcessing);
            $.ajax({
                url: '@Url.Action("MarkAllRead", "Notification")',
                type: 'POST',
                data: { __RequestVerificationToken: token },
                success: function (res) {
                    if (res.success) {
                        btn.closest('div').find('span[style*="font-size:.65rem"]').remove();
                        btn.remove();
                        $('#notifList > div').each(function () {
                            $(this).css({ 'border': '1px solid rgba(255,255,255,.08)', 'box-shadow': 'none' });
                            $(this).find('span[style*="border-radius:50%"]').remove();
                            $(this).find('strong').css('color', 'rgba(255,255,255,.7)');
                            $(this).find('.bi-bell-fill').removeClass('bi-bell-fill').addClass('bi-bell');
                            $(this).find('div[style*="rgba(201,168,76,.15)"]')
                                .css('background', 'rgba(255,255,255,.07)');
                        });
                    }
                },
                error: function () {
                    btn.prop('disabled', false).html(_notifMarkAllRead);
                }
            });
        });
    </script>
}
