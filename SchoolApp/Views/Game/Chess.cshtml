@{
    ViewData["Title"] = "Cờ vua";
}

<div class="container my-4">
    <h2 class="mb-3">
        <i class="bi bi-grid-3x3-gap-fill me-2"></i>@ViewData["Title"]
    </h2>

    @* Khung bao canh giữa, giữ tỉ lệ canvas Unity (960x600). Iframe lấp đầy khung. *@
    <div id="chessFrameWrap"
         style="position: relative; width: 100%; max-width: 960px; margin: 0 auto;
                aspect-ratio: 960 / 640; border-radius: 14px; overflow: hidden;
                box-shadow: 0 12px 36px rgba(0,0,0,.18); background: #2c4a72;">
        <iframe id="chessFrame" src="~/games/chess/index.html"
                style="position: absolute; inset: 0; border: 0; width: 100%; height: 100%;"
                allowfullscreen
                allow="autoplay; fullscreen"
                scrolling="no"></iframe>
    </div>

    <p class="text-muted small text-center mt-2 mb-0">
        <i class="bi bi-info-circle me-1"></i>
        Chọn <strong>2 Người Chơi</strong>, <strong>Chơi với AI</strong> hoặc <strong>Online</strong> để bắt đầu.
    </p>
</div>
