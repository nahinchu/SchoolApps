@model SchoolApp.DTOs.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

@section Styles {
    <style>
        .sa-header, .sa-admin-bar { display: none !important; }
        body { background: white !important; overflow: hidden; }
        .sa-main { padding: 0 !important; }
        .sa-main > .container { max-width: 100% !important; padding: 0 !important; width: 100% !important; }
        .auth-page { display: grid; grid-template-columns: 1fr 1fr; height: 100vh; }
        .auth-left {
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
            position: relative; overflow: hidden;
            display: flex; align-items: center; justify-content: center;
        }
        .auth-deco { position: absolute; border-radius: 50%; pointer-events: none; }
        .auth-right {
            background: white; display: flex; flex-direction: column;
            padding: 2.25rem 3.5rem; overflow-y: auto;
        }
        .auth-topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; }
        .auth-logo {
            display: flex; align-items: center; gap: .45rem;
            font-weight: 700; font-size: 1.05rem; color: #1a1a1a;
            font-family: var(--font-display,'Georgia',serif); text-decoration: none;
        }
        .auth-logo-icon { color: var(--gold); font-size: 1.35rem; }
        .auth-form-wrapper { flex: 1; display: flex; flex-direction: column; justify-content: center; max-width: 400px; }
        .auth-title { font-family: var(--font-display,'Georgia',serif); font-size: 2rem; font-weight: 700; color: var(--gold); margin-bottom: .35rem; }
        .auth-subtitle { color: #aaa; font-size: .9rem; margin-bottom: 2rem; }
        .auth-label { display: block; color: var(--gold); font-size: .8rem; font-weight: 600; margin-bottom: 6px; }
        .auth-input {
            width: 100%; border: 1.5px solid #e8e8e8; border-radius: 8px;
            padding: 11px 14px; font-size: .88rem; color: #333; outline: none;
            transition: border-color .2s; background: #fafafa; box-sizing: border-box;
        }
        .auth-input:focus { border-color: var(--gold); background: white; }
        .auth-input::placeholder { color: #c8c8c8; }
        .auth-form-group { margin-bottom: 1rem; position: relative; }
        .auth-pw-toggle {
            position: absolute; right: 1px; top: 26px; bottom: 1px; width: 40px;
            border: none; background: transparent; color: #c0c0c0; cursor: pointer;
            display: flex; align-items: center; justify-content: center; border-radius: 0 7px 7px 0;
        }
        .auth-pw-toggle:hover { color: var(--gold); }
        .auth-btn {
            width: 100%; background: var(--gold); color: white; border: none;
            border-radius: 8px; padding: 13px; font-size: .8rem; font-weight: 700;
            letter-spacing: 1.5px; cursor: pointer; transition: background .2s; margin-top: .5rem;
        }
        .auth-btn:hover { background: #d9921f; }
        .auth-field-error { font-size: .75rem; color: #dc3545; margin-top: 4px; display: block; }
        @@media (max-width: 768px) {
            body { overflow: auto; }
            .auth-page { grid-template-columns: 1fr; height: auto; }
            .auth-left { height: 220px; }
            .auth-right { padding: 2rem 1.5rem; }
            .auth-form-wrapper { max-width: 100%; }
        }
    </style>
}

<div class="auth-page">
    <div class="auth-left">
        <div class="auth-deco" style="width:380px;height:380px;top:-140px;left:-140px;background:rgba(255,255,255,.10);"></div>
        <div class="auth-deco" style="width:280px;height:280px;bottom:-90px;right:-90px;background:rgba(255,255,255,.08);"></div>
        <img src="~/images/Studying.gif" alt="Đặt lại mật khẩu"
             style="width:80%;max-width:300px;object-fit:contain;position:relative;z-index:1;
                    filter:drop-shadow(0 12px 32px rgba(0,0,0,.18));" />
    </div>

    <div class="auth-right">
        <div class="auth-topbar">
            <a class="auth-logo" asp-controller="Home" asp-action="Index">
                <span class="auth-logo-icon"><i class="bi bi-mortarboard-fill"></i></span>
                SchoolApp
            </a>
        </div>

        <div class="auth-form-wrapper">
            <h1 class="auth-title">Mật khẩu mới.</h1>
            <p class="auth-subtitle">Đặt mật khẩu mới cho tài khoản của bạn.</p>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="auth-form-group">
                    <label class="auth-label" asp-for="NewPassword">Mật khẩu mới</label>
                    <input class="auth-input" asp-for="NewPassword" id="newPwd"
                           type="password" placeholder="Ít nhất 6 ký tự..."
                           autocomplete="new-password" style="padding-right:42px;" />
                    <button type="button" class="auth-pw-toggle" onclick="togglePwd('newPwd',this)">
                        <i class="bi bi-eye"></i>
                    </button>
                    <span asp-validation-for="NewPassword" class="auth-field-error"></span>
                </div>

                <div class="auth-form-group" style="margin-bottom:1.5rem;">
                    <label class="auth-label" asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                    <input class="auth-input" asp-for="ConfirmPassword" id="cfmPwd"
                           type="password" placeholder="Nhập lại mật khẩu..."
                           autocomplete="new-password" style="padding-right:42px;" />
                    <button type="button" class="auth-pw-toggle" onclick="togglePwd('cfmPwd',this)">
                        <i class="bi bi-eye"></i>
                    </button>
                    <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
                </div>

                <button type="submit" class="auth-btn">ĐẶT LẠI MẬT KHẨU</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd(id, btn) {
            var inp = document.getElementById(id);
            var ico = btn.querySelector('i');
            if (inp.type === 'password') {
                inp.type = 'text';
                ico.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                inp.type = 'password';
                ico.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }
    </script>
}
