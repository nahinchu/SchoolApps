@model SchoolApp.DTOs.EditProfileViewModel
@{
    ViewData["Title"] = L["Prof_Title"].Value;
    var pwdErrorsJson = TempData["PwdErrors"]?.ToString();
    var pwdErrors = pwdErrorsJson != null
        ? System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(pwdErrorsJson)
        : null;
    var activeSection = TempData["ActiveTab"]?.ToString() == "password" ? "password" : "profile";
    var userRole = Context.Session.GetString("Role") ?? "Student";
    var roleLabel = userRole switch
    {
        "Admin" => L["Prof_RoleAdmin"].Value,
        "Manager" => L["Prof_RoleManager"].Value,
        _ => L["Prof_RoleStudent"].Value
    };
    var initials = string.IsNullOrEmpty(Model.FullName) ? "?" :
        string.Concat(Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .TakeLast(2).Select(w => w[0])).ToUpper();
    var avatarUrl = Model.AvatarUrl;
}

@section Styles {
    <style>
        body {
            background: var(--navy-light) !important;
        }

        .sa-main {
            padding-top: 0 !important;
            padding-bottom: 0 !important;
        }

            .sa-main > .container {
                max-width: 100% !important;
                padding: 0 !important;
                width: 100% !important;
            }

        /* ── Page shell ── */
        .profile-layout {
            display: flex;
            min-height: calc(100vh - 66px);
            background: var(--navy-light, #f7f5f0);
        }

        /* ── Sidebar ── */
        .profile-sidebar {
            width: 256px;
            flex-shrink: 0;
            background: white;
            border-right: 1px solid rgba(13,27,42,0.08);
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 66px;
            height: calc(100vh - 66px);
            overflow-y: auto;
        }

        /* Avatar block */
        .sidebar-avatar-block {
            padding: 1.75rem 1.25rem 1.25rem;
            border-bottom: 1px solid rgba(13,27,42,0.07);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.65rem;
            text-align: center;
        }

        .sidebar-avatar {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--navy);
            font-family: var(--font-display);
            box-shadow: 0 4px 16px rgba(201,168,76,0.30);
            flex-shrink: 0;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

        .sidebar-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        }

        .sidebar-avatar-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.45);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.2s;
            color: white;
            font-size: 1.1rem;
        }

        .sidebar-avatar:hover .sidebar-avatar-overlay {
            opacity: 1;
        }

        .avatar-upload-hint {
            font-size: 0.7rem;
            color: rgba(13,27,42,0.4);
            text-align: center;
        }

        .sidebar-name {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--navy);
            line-height: 1.3;
        }

        .sidebar-role-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            background: rgba(201,168,76,0.12);
            color: var(--gold);
            border: 1px solid rgba(201,168,76,0.25);
            border-radius: 20px;
            padding: 2px 10px;
            font-size: 0.72rem;
            font-weight: 600;
        }

        /* Nav section */
        .sidebar-nav {
            flex: 1;
            padding: 0.75rem 0;
        }

        .sidebar-section-title {
            padding: 0.6rem 1.25rem 0.3rem;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: rgba(13,27,42,0.35);
            text-transform: uppercase;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            padding: 0.62rem 1.25rem;
            font-size: 0.86rem;
            color: rgba(13,27,42,0.65);
            cursor: pointer;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
            text-decoration: none;
            transition: background 0.15s, color 0.15s;
            border-left: 3px solid transparent;
            position: relative;
        }

            .sidebar-item:hover {
                background: rgba(201,168,76,0.07);
                color: var(--navy);
            }

            .sidebar-item.active {
                background: rgba(201,168,76,0.10);
                color: var(--gold);
                border-left-color: var(--gold);
                font-weight: 600;
            }

            .sidebar-item i {
                font-size: 0.95rem;
                width: 18px;
                flex-shrink: 0;
            }

            .sidebar-item .item-chevron {
                margin-left: auto;
                font-size: 0.7rem;
                opacity: 0.4;
            }

        .sidebar-item-badge {
            margin-left: auto;
            font-size: 0.65rem;
            background: rgba(13,27,42,0.07);
            color: rgba(13,27,42,0.4);
            border-radius: 10px;
            padding: 1px 7px;
            font-weight: 600;
        }

        .sidebar-item.disabled {
            cursor: default;
            opacity: 0.5;
        }

            .sidebar-item.disabled:hover {
                background: transparent;
                color: rgba(13,27,42,0.65);
            }

        .sidebar-divider {
            height: 1px;
            background: rgba(13,27,42,0.06);
            margin: 0.5rem 1rem;
        }

        /* Sidebar footer */
        .sidebar-footer {
            border-top: 1px solid rgba(13,27,42,0.07);
            padding: 0.6rem 0;
        }

        .sidebar-logout {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            padding: 0.62rem 1.25rem;
            font-size: 0.86rem;
            color: rgba(185,28,28,0.75);
            text-decoration: none;
            cursor: pointer;
            transition: background 0.15s, color 0.15s;
            border-left: 3px solid transparent;
        }

            .sidebar-logout:hover {
                background: rgba(185,28,28,0.05);
                color: #b91c1c;
            }

            .sidebar-logout i {
                font-size: 0.95rem;
                width: 18px;
            }

        /* ── Main content ── */
        .profile-content {
            flex: 1;
            padding: 2rem 2.5rem;
            min-width: 0;
            width: 0; /* force flex child to shrink/grow correctly */
        }

        /* Section card */
        .profile-section {
            display: none;
        }

            .profile-section.active {
                display: block;
            }

        /* Section header — navy background, white text */
        .section-header {
            background: linear-gradient(135deg, var(--navy) 0%, #1c3a52 100%);
            border-radius: 12px;
            padding: 1.4rem 1.75rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .section-header-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: rgba(255,255,255,0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            color: var(--gold-light);
            flex-shrink: 0;
        }

        .section-title {
            font-family: var(--font-display);
            font-size: 1.2rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 0.18rem;
            line-height: 1.2;
        }

        .section-subtitle {
            font-size: 0.81rem;
            color: rgba(255,255,255,0.55);
            font-weight: 400;
        }

        /* Content card */
        .profile-card {
            background: white;
            border-radius: 12px;
            border: 1px solid rgba(13,27,42,0.09);
            overflow: hidden;
            margin-bottom: 1.25rem;
            box-shadow: 0 1px 6px rgba(13,27,42,0.05);
        }

        .profile-card-header {
            padding: 0.9rem 1.5rem;
            border-bottom: 1px solid rgba(13,27,42,0.06);
            background: rgba(13,27,42,0.02);
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .profile-card-title {
            font-size: 0.92rem;
            font-weight: 600;
            color: var(--navy);
        }

            .profile-card-title i {
                color: var(--gold);
            }

        .profile-card-body {
            padding: 1.5rem 1.75rem;
        }

        /* Form grid */
        .form-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem 1.25rem;
        }

        .form-grid-full {
            grid-column: 1 / -1;
        }

        /* Field */
        .pf-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .pf-label {
            font-size: 0.78rem;
            font-weight: 600;
            color: rgba(13,27,42,0.55);
            letter-spacing: 0.2px;
        }

            .pf-label .req {
                color: var(--danger);
            }

        .pf-input {
            border: 1.5px solid rgba(13,27,42,0.12);
            border-radius: 8px;
            padding: 9px 13px;
            font-size: 0.87rem;
            color: var(--navy);
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            background: white;
            width: 100%;
            box-sizing: border-box;
        }

            .pf-input:focus {
                border-color: var(--gold);
                box-shadow: 0 0 0 3px rgba(201,168,76,0.12);
            }

            .pf-input::placeholder {
                color: rgba(13,27,42,0.25);
            }

        textarea.pf-input {
            resize: vertical;
            min-height: 72px;
        }

        .pf-error {
            font-size: 0.73rem;
            color: var(--danger);
        }

        .pw-wrap {
            position: relative;
        }

        .pw-toggle {
            position: absolute;
            right: 1px;
            top: 1px;
            bottom: 1px;
            width: 38px;
            border: none;
            background: transparent;
            cursor: pointer;
            color: rgba(13,27,42,0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0 7px 7px 0;
            transition: color 0.15s;
        }

            .pw-toggle:hover {
                color: var(--gold);
            }

        /* Action bar */
        .section-actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.75rem;
            padding-top: 1.25rem;
            border-top: 1px solid rgba(13,27,42,0.06);
            margin-top: 1.25rem;
        }

        .pf-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 9px 20px;
            border-radius: 8px;
            border: none;
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
        }

        .pf-btn-primary {
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
            color: var(--navy);
            box-shadow: 0 2px 8px rgba(201,168,76,0.30);
        }

            .pf-btn-primary:hover {
                filter: brightness(1.06);
            }

            .pf-btn-primary:active {
                transform: scale(0.98);
            }

        /* Alert */
        .pf-alert {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.7rem 1rem;
            border-radius: 8px;
            font-size: 0.84rem;
            margin-bottom: 1.25rem;
        }

        .pf-alert-error {
            background: #fff5f5;
            border: 1px solid #fca5a5;
            color: #dc2626;
        }

        @@media (max-width: 900px) {
            .form-grid-2 {
                grid-template-columns: 1fr;
            }

            .form-grid-full {
                grid-column: auto;
            }
        }

        @@media (max-width: 700px) {
            .profile-layout {
                flex-direction: column;
            }

            .profile-sidebar {
                width: 100%;
                height: auto;
                position: static;
                flex-direction: row;
                flex-wrap: wrap;
                border-right: none;
                border-bottom: 1px solid rgba(13,27,42,0.08);
            }

            .sidebar-avatar-block {
                flex-direction: row;
                text-align: left;
                padding: 1rem;
                border-bottom: none;
                border-right: 1px solid rgba(13,27,42,0.07);
            }

            .sidebar-nav {
                display: flex;
                flex-wrap: wrap;
                padding: 0.25rem;
            }

            .sidebar-item {
                border-left: none;
                border-bottom: 3px solid transparent;
                border-radius: 6px;
                white-space: nowrap;
            }

                .sidebar-item.active {
                    border-left-color: transparent;
                    border-bottom-color: var(--gold);
                }

            .profile-content {
                padding: 1.25rem;
            }
        }
    </style>
}

<div class="profile-layout">

    <!-- ════════════════════ SIDEBAR ════════════════════ -->
    <aside class="profile-sidebar">

        <!-- Avatar + User info -->
        <div class="sidebar-avatar-block">
            <div class="sidebar-avatar" id="avatarBtn" title="@L["Prof_AvatarTitle"]" onclick="document.getElementById('avatarInput').click()">
                @if (!string.IsNullOrEmpty(avatarUrl))
                {
                    <img src="@avatarUrl" id="avatarImg" alt="Avatar" />
                }
                else
                {
                    <span id="avatarInitials">@initials</span>
                }
                <div class="sidebar-avatar-overlay">
                    <i class="bi bi-camera-fill"></i>
                </div>
            </div>
            <div>
                <div class="sidebar-name">@(Model.FullName ?? L["Prof_NotUpdated"].Value)</div>
                <div style="margin-top:4px;">
                    <span class="sidebar-role-badge">
                        <i class="bi bi-patch-check-fill" style="font-size:0.65rem;"></i>
                        @roleLabel
                    </span>
                </div>
                <div class="avatar-upload-hint" style="margin-top:5px;">@L["Prof_AvatarHint"]</div>
            </div>
        </div>

        <!-- Hidden file input for avatar -->
        <form id="avatarForm" style="display:none;">
            @Html.AntiForgeryToken()
            <input type="file" id="avatarInput" name="avatar" accept="image/png,image/jpeg,image/gif,image/webp" />
        </form>

        <!-- Navigation -->
        <nav class="sidebar-nav">
            <div class="sidebar-section-title">@L["Prof_Account"]</div>

            <button class="sidebar-item @(activeSection == "profile" ? "active" : "")"
                    onclick="switchSection('profile')">
                <i class="bi bi-person-fill"></i>
                <span>@L["Prof_PersonalInfo"]</span>
                <i class="bi bi-chevron-right item-chevron"></i>
            </button>

            <button class="sidebar-item @(activeSection == "password" ? "active" : "")"
                    onclick="switchSection('password')">
                <i class="bi bi-shield-lock-fill"></i>
                <span>@L["Prof_ChangePassword"]</span>
                <i class="bi bi-chevron-right item-chevron"></i>
            </button>

            <div class="sidebar-divider"></div>
            <div class="sidebar-section-title">@L["Prof_Learning"]</div>

            <a class="sidebar-item" asp-controller="Enrollment" asp-action="MyEnrollments">
                <i class="bi bi-book-half"></i>
                <span>@L["Prof_MyCourses"]</span>
                <i class="bi bi-chevron-right item-chevron"></i>
            </a>

            <a class="sidebar-item" asp-controller="Certificate" asp-action="My">
                <i class="bi bi-trophy-fill"></i>
                <span>@L["Prof_MyCerts"]</span>
                <i class="bi bi-chevron-right item-chevron"></i>
            </a>

            <a class="sidebar-item" asp-controller="Enrollment" asp-action="MyEnrollments">
                <i class="bi bi-bar-chart-fill"></i>
                <span>@L["Prof_Progress"]</span>
                <i class="bi bi-chevron-right item-chevron"></i>
            </a>
        </nav>

        <!-- Logout -->
        <div class="sidebar-footer">
            <a class="sidebar-logout" asp-controller="Account" asp-action="Logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>@L["Prof_Logout"]</span>
            </a>
        </div>
    </aside>

    <!-- ════════════════════ CONTENT ════════════════════ -->
    <div class="profile-content">

        <!-- ── Section: Thông tin cá nhân ── -->
        <div id="section-profile" class="profile-section @(activeSection == "profile" ? "active" : "")">

            <div class="section-header">
                <div class="section-header-icon">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div>
                    <div class="section-title">@L["Prof_PersonalInfo"]</div>
                    <div class="section-subtitle">@L["Prof_PersonalInfoSub"]</div>
                </div>
            </div>

            <div class="profile-card">
                <div class="profile-card-header">
                    <i class="bi bi-person-vcard-fill" style="color:var(--gold);"></i>
                    <span class="profile-card-title">@L["Prof_BasicInfo"]</span>
                </div>
                <div class="profile-card-body">

                    @if (!ViewData.ModelState.IsValid && activeSection == "profile")
                    {
                        var generalErrors = ViewData.ModelState[""]?.Errors;
                        if (generalErrors != null && generalErrors.Count > 0)
                        {
                            <div class="pf-alert pf-alert-error">
                                <i class="bi bi-exclamation-circle-fill"></i>
                                <span>@generalErrors[0].ErrorMessage</span>
                            </div>
                        }
                    }

                    <form asp-action="EditProfile" method="post">
                        @Html.AntiForgeryToken()

                        <div class="form-grid-2">

                            <div class="pf-field form-grid-full">
                                <label class="pf-label" asp-for="FullName">
                                    @L["Prof_Fullname"] <span class="req">*</span>
                                </label>
                                <input class="pf-input" asp-for="FullName"
                                       placeholder="@L["Prof_FullNamePh"]"
                                       autocomplete="name" />
                                <span asp-validation-for="FullName" class="pf-error"></span>
                            </div>

                            <div class="pf-field">
                                <label class="pf-label" asp-for="Phone">@L["Prof_Phone"]</label>
                                <input class="pf-input" asp-for="Phone"
                                       type="tel" placeholder="0901 234 567"
                                       autocomplete="tel" />
                                <span asp-validation-for="Phone" class="pf-error"></span>
                            </div>

                            <div class="pf-field">
                                <label class="pf-label" asp-for="DateOfBirth">@L["Prof_DOB"]</label>
                                <input class="pf-input" asp-for="DateOfBirth"
                                       type="date" autocomplete="bday" />
                                <span asp-validation-for="DateOfBirth" class="pf-error"></span>
                            </div>

                            <div class="pf-field form-grid-full">
                                <label class="pf-label" asp-for="Address">@L["Prof_Address"]</label>
                                <textarea class="pf-input" asp-for="Address"
                                          placeholder="@L["Prof_AddressPh"]"
                                          rows="2"></textarea>
                                <span asp-validation-for="Address" class="pf-error"></span>
                            </div>

                        </div>

                        <div class="section-actions">
                            <button type="submit" class="pf-btn pf-btn-primary">
                                <i class="bi bi-check-lg"></i> @L["Prof_SaveChanges"]
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

        <!-- ── Section: Đổi mật khẩu ── -->
        <div id="section-password" class="profile-section @(activeSection == "password" ? "active" : "")">

            <div class="section-header">
                <div class="section-header-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div>
                    <div class="section-title">@L["Prof_ChangePassword"]</div>
                    <div class="section-subtitle">@L["Prof_PwdSectionSub"]</div>
                </div>
            </div>

            <div class="profile-card">
                <div class="profile-card-header">
                    <i class="bi bi-shield-lock-fill" style="color:var(--gold);"></i>
                    <span class="profile-card-title">@L["Prof_SecurityCard"]</span>
                </div>
                <div class="profile-card-body">

                    @if (pwdErrors != null && pwdErrors.ContainsKey("_general"))
                    {
                        <div class="pf-alert pf-alert-error">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span>@pwdErrors["_general"]</span>
                        </div>
                    }

                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div style="display:flex; flex-direction:column; gap:1rem; max-width:440px;">

                            <div class="pf-field">
                                <label class="pf-label" for="CurrentPassword">
                                    @L["Prof_CurrentPwd"] <span class="req">*</span>
                                </label>
                                <div class="pw-wrap">
                                    <input class="pf-input" type="password"
                                           id="CurrentPassword" name="CurrentPassword"
                                           placeholder="@L["Prof_CurrentPwdPh"]"
                                           autocomplete="current-password"
                                           style="padding-right:42px;" />
                                    <button type="button" class="pw-toggle"
                                            onclick="togglePwd('CurrentPassword',this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                @if (pwdErrors != null && pwdErrors.ContainsKey("CurrentPassword"))
                                {
                                    <span class="pf-error">@pwdErrors["CurrentPassword"]</span>
                                }
                            </div>

                            <div class="pf-field">
                                <label class="pf-label" for="NewPassword">
                                    @L["Prof_NewPwd"] <span class="req">*</span>
                                </label>
                                <div class="pw-wrap">
                                    <input class="pf-input" type="password"
                                           id="NewPassword" name="NewPassword"
                                           placeholder="@L["Prof_NewPwdPh"]"
                                           autocomplete="new-password"
                                           style="padding-right:42px;" />
                                    <button type="button" class="pw-toggle"
                                            onclick="togglePwd('NewPassword',this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                @if (pwdErrors != null && pwdErrors.ContainsKey("NewPassword"))
                                {
                                    <span class="pf-error">@pwdErrors["NewPassword"]</span>
                                }
                            </div>

                            <div class="pf-field">
                                <label class="pf-label" for="ConfirmNewPassword">
                                    @L["Prof_ConfirmPwd"] <span class="req">*</span>
                                </label>
                                <div class="pw-wrap">
                                    <input class="pf-input" type="password"
                                           id="ConfirmNewPassword" name="ConfirmNewPassword"
                                           placeholder="@L["Prof_ConfirmPwdPh"]"
                                           autocomplete="new-password"
                                           style="padding-right:42px;" />
                                    <button type="button" class="pw-toggle"
                                            onclick="togglePwd('ConfirmNewPassword',this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                @if (pwdErrors != null && pwdErrors.ContainsKey("ConfirmNewPassword"))
                                {
                                    <span class="pf-error">@pwdErrors["ConfirmNewPassword"]</span>
                                }
                            </div>

                        </div>

                        <div class="section-actions">
                            <button type="submit" class="pf-btn pf-btn-primary">
                                <i class="bi bi-shield-check"></i> @L["Prof_UpdatePwd"]
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function switchSection(name) {
            document.querySelectorAll('.profile-section').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.sidebar-item').forEach(el => el.classList.remove('active'));

            document.getElementById('section-' + name).classList.add('active');
            document.querySelector('[onclick="switchSection(\'' + name + '\')"]').classList.add('active');
        }

        function togglePwd(id, btn) {
            var inp = document.getElementById(id);
            var ico = btn.querySelector('i');
            if (inp.type === 'password') {
                inp.type = 'text';
                ico.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                inp.type = 'password';
                ico.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }

        // ── Avatar upload ──────────────────────────────────────────
        document.getElementById('avatarInput').addEventListener('change', async function () {
            const file = this.files[0];
            if (!file) return;

            const btn = document.getElementById('avatarBtn');
            const overlay = btn.querySelector('.sidebar-avatar-overlay');
            overlay.innerHTML = '<div class="spinner-border spinner-border-sm text-light" role="status"></div>';

            const formData = new FormData();
            formData.append('avatar', file);
            formData.append('__RequestVerificationToken',
                document.querySelector('#avatarForm input[name="__RequestVerificationToken"]').value);

            try {
                const res = await fetch('@Url.Action("UploadAvatar", "Account")', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();

                if (data.success) {
                    // Cập nhật ảnh hiển thị ngay
                    let img = document.getElementById('avatarImg');
                    if (!img) {
                        // Tạo mới nếu chưa có
                        const initials = document.getElementById('avatarInitials');
                        if (initials) initials.remove();
                        img = document.createElement('img');
                        img.id = 'avatarImg';
                        img.alt = 'Avatar';
                        btn.insertBefore(img, overlay);
                    }
                    img.src = data.avatarUrl + '&t=' + Date.now();
                    img.style.width = '100%';
                    img.style.height = '100%';
                    img.style.objectFit = 'cover';
                    img.style.borderRadius = '50%';
                } else {
                    alert(data.message);
                }
            } catch (e) {
                alert('@L["Prof_AvatarError"]');
            } finally {
                overlay.innerHTML = '<i class="bi bi-camera-fill"></i>';
                this.value = '';
            }
        });
    </script>
}