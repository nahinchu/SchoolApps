@model SchoolApp.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

@section Styles {
    <style>
        .sa-header,
        .sa-admin-bar {
            display: none !important;
        }

        body {
            background: white !important;
            overflow: hidden;
        }

        .sa-main {
            padding: 0 !important;
        }

            .sa-main > .container {
                max-width: 100% !important;
                padding: 0 !important;
                width: 100% !important;
            }

        .auth-page {
            display: grid;
            grid-template-columns: 1fr 1fr;
            height: 100vh;
        }

        /* ── Left panel ── */
        .auth-left {
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-deco {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        /* ── Right panel ── */
        .auth-right {
            background: white;
            display: flex;
            flex-direction: column;
            padding: 1.75rem 3.5rem;
            overflow-y: auto;
        }

        .auth-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.75rem;
            flex-shrink: 0;
        }

        .auth-logo {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            font-weight: 700;
            font-size: 1.05rem;
            color: #1a1a1a;
            font-family: var(--font-display, 'Georgia', serif);
            text-decoration: none;
        }

        .auth-logo-icon {
            color: var(--gold);
            font-size: 1.35rem;
        }

        .auth-nav-text {
            font-size: 0.82rem;
            color: #888;
        }

            .auth-nav-text a {
                color: var(--gold);
                font-weight: 600;
                text-decoration: none;
            }

                .auth-nav-text a:hover {
                    text-decoration: underline;
                }

        .auth-form-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .auth-title {
            font-family: var(--font-display, 'Georgia', serif);
            font-size: 2rem;
            font-weight: 700;
            color: var(--gold);
            margin-bottom: 0.3rem;
            line-height: 1.15;
        }

        .auth-subtitle {
            color: #aaa;
            font-size: 0.88rem;
            margin-bottom: 1.5rem;
        }

        .auth-label {
            display: block;
            color: var(--gold);
            font-size: 0.78rem;
            font-weight: 600;
            margin-bottom: 5px;
            letter-spacing: 0.2px;
        }

        .auth-input {
            width: 100%;
            border: 1.5px solid #e8e8e8;
            border-radius: 8px;
            padding: 10px 13px;
            font-size: 0.86rem;
            color: #333;
            outline: none;
            transition: border-color 0.2s;
            background: #fafafa;
            box-sizing: border-box;
        }

            .auth-input:focus {
                border-color: var(--gold);
                background: white;
            }

            .auth-input::placeholder {
                color: #c8c8c8;
            }

        .auth-form-group {
            margin-bottom: 0.85rem;
        }

        .auth-form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.9rem;
        }

        .auth-pw-wrap {
            position: relative;
        }

        .auth-pw-toggle {
            position: absolute;
            right: 1px;
            top: 1px;
            bottom: 1px;
            width: 40px;
            border: none;
            background: transparent;
            color: #c0c0c0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0 7px 7px 0;
            transition: color 0.2s;
        }

            .auth-pw-toggle:hover {
                color: var(--gold);
            }

        .auth-checkbox-row {
            display: flex;
            align-items: flex-start;
            gap: 0.55rem;
            margin: 1rem 0;
            font-size: 0.78rem;
            color: #888;
            line-height: 1.5;
        }

            .auth-checkbox-row input[type="checkbox"] {
                margin-top: 2px;
                accent-color: var(--gold);
                flex-shrink: 0;
            }

            .auth-checkbox-row a {
                color: var(--gold);
                text-decoration: underline;
            }

        .auth-btn {
            width: 100%;
            background: var(--gold);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 12px;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
        }

            .auth-btn:hover {
                background: #d9921f;
            }

            .auth-btn:active {
                transform: scale(0.99);
            }

        .auth-divider {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            margin: 1rem 0 0.75rem;
            color: #c8c8c8;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.8px;
        }

            .auth-divider::before,
            .auth-divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: #ebebeb;
            }

        .auth-social-row {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .auth-social-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: 1.5px solid #e0e0e0;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: border-color 0.2s, color 0.2s;
            text-decoration: none;
            color: #666;
            font-size: 0.9rem;
        }

            .auth-social-btn:hover {
                border-color: var(--gold);
                color: var(--gold);
            }

        .auth-field-error {
            font-size: 0.72rem;
            color: #dc3545;
            margin-top: 3px;
            display: block;
        }

        @@media (max-width: 768px) {
            body {
                overflow: auto;
            }

            .auth-page {
                grid-template-columns: 1fr;
                height: auto;
            }

            .auth-left {
                height: 200px;
            }

            .auth-right {
                padding: 1.75rem 1.5rem;
            }

            .auth-form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="auth-page">

    <!-- ===== Left: Illustration ===== -->
    <div class="auth-left">
        <!-- Background decorative circles -->
        <div class="auth-deco" style="width:380px;height:380px;top:-140px;left:-140px;background:rgba(255,255,255,0.10);"></div>
        <div class="auth-deco" style="width:280px;height:280px;bottom:-90px;right:-90px;background:rgba(255,255,255,0.08);"></div>
        <div class="auth-deco" style="width:160px;height:160px;top:42%;left:-55px;background:transparent;border:1px solid rgba(255,255,255,0.18);"></div>

        <!-- Illustration image — thay file tại wwwroot/images/Welcome.gif để đổi ảnh -->
        <img src="~/images/Register.gif" alt="Minh hoạ đăng ký"
             style="width:80%; max-width:340px; object-fit:contain; position:relative; z-index:1;
                    filter: drop-shadow(0 12px 32px rgba(0,0,0,0.18));" />
    </div>

    <!-- ===== Right: Form ===== -->
    <div class="auth-right">

        <!-- Top bar -->
        <div class="auth-topbar">
            <a class="auth-logo" asp-controller="Home" asp-action="Index">
                <span class="auth-logo-icon"><i class="bi bi-mortarboard-fill"></i></span>
                SchoolApp
            </a>
            <div class="auth-nav-text">
                Đã có tài khoản?
                <a asp-controller="Account" asp-action="Login">Đăng nhập.</a>
            </div>
        </div>

        <!-- Form content -->
        <div class="auth-form-wrapper">
            <h1 class="auth-title">Đăng ký Miễn Phí.</h1>
            <p class="auth-subtitle">Khám phá kiến thức không giới hạn.</p>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                var generalErrors = ViewData.ModelState[""]?.Errors;
                if (generalErrors != null && generalErrors.Count > 0)
                {
                    <div style="background:#fff8f0;border:1.5px solid var(--gold);border-radius:8px;padding:0.65rem 1rem;margin-bottom:1rem;font-size:0.83rem;color:#b37818;display:flex;gap:0.5rem;align-items:center;">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@generalErrors[0].ErrorMessage</span>
                    </div>
                }
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="auth-form-group">
                    <label class="auth-label" asp-for="Email">Địa chỉ Email</label>
                    <input class="auth-input" asp-for="Email"
                           type="email" placeholder="example@email.com"
                           autocomplete="email" />
                    <span asp-validation-for="Email" class="auth-field-error"></span>
                </div>

                <!-- Mật khẩu | Xác nhận mật khẩu -->
                <div class="auth-form-row">
                    <div class="auth-form-group">
                        <label class="auth-label" asp-for="Password">Mật khẩu</label>
                        <div class="auth-pw-wrap">
                            <input class="auth-input" asp-for="Password" id="regPwd"
                                   type="password" placeholder="Ít nhất 6 ký tự"
                                   autocomplete="new-password"
                                   style="padding-right:42px;" />
                            <button type="button" class="auth-pw-toggle"
                                    onclick="togglePwd('regPwd',this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="auth-field-error"></span>
                    </div>
                    <div class="auth-form-group">
                        <label class="auth-label" asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                        <div class="auth-pw-wrap">
                            <input class="auth-input" asp-for="ConfirmPassword" id="regCfm"
                                   type="password" placeholder="Nhập lại mật khẩu"
                                   autocomplete="new-password"
                                   style="padding-right:42px;" />
                            <button type="button" class="auth-pw-toggle"
                                    onclick="togglePwd('regCfm',this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
                    </div>
                </div>

                <!-- Terms checkbox -->
                <div class="auth-checkbox-row">
                    <input type="checkbox" id="terms" required />
                    <label for="terms">
                        Tôi đồng ý với <a href="#">Điều khoản dịch vụ</a>
                        và <a href="#">Chính sách bảo mật</a> của SchoolApp.
                    </label>
                </div>

                <button type="submit" class="auth-btn">ĐĂNG KÝ NGAY</button>
            </form>

            <div class="auth-divider">HOẶC ĐĂNG KÝ VỚI</div>

            <div class="auth-social-row">
                <a asp-controller="Account" asp-action="GoogleLogin" class="auth-social-btn" title="Google">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                    </svg>
                </a>
                <a href="#" class="auth-social-btn" title="Twitter / X">
                    <i class="bi bi-twitter-x"></i>
                </a>
                <a href="#" class="auth-social-btn" title="Facebook">
                    <i class="bi bi-facebook"></i>
                </a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd(id, btn) {
            var inp = document.getElementById(id);
            var ico = btn.querySelector('i');
            if (inp.type === 'password') {
                inp.type = 'text';
                ico.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                inp.type = 'password';
                ico.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }
    </script>
}