@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<SchoolApp.Models.Module>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SchoolApp.Resources.MyLanguage> L

<div class="adm-table-wrap">
    <table class="adm-table adm-table-bordered">
        <thead>
            <tr>
                <th style="width:36px;"></th>
                <th class="text-center" style="width:60px;">#</th>
                <th>@L["Mod_ColChapterName"]</th>
                <th>@L["Mod_ColDescription"]</th>
                <th class="text-center">@L["Mod_ColStatus"]</th>
                <th class="text-center" style="width:110px;">@L["Mod_ColLessons"]</th>
                <th style="width:260px;">@L["Mod_ColActions"]</th>
            </tr>
        </thead>
        <tbody id="moduleTableBody">
            @{ int stt = 1; }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" style="text-align:center; padding:2.5rem; color:rgba(255,255,255,0.3);">
                        <i class="bi bi-folder-x" style="font-size:2rem; display:block; margin-bottom:.5rem;"></i>
                        @L["Mod_NoChapters"]
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr data-id="@item.ModuleId">
                        <td style="text-align:center; cursor:grab; color:rgba(255,255,255,.3); padding:0 8px;">
                            <i class="bi bi-grip-vertical" style="font-size:1.1rem;"></i>
                        </td>
                        <td class="text-center" style="font-weight:700;">@(stt++)</td>
                        <td style="font-weight:600;">@item.Title</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <span style="color:rgba(255,255,255,0.5); font-size:.82rem;">@(item.Description.Length > 90 ? item.Description.Substring(0, 90) + "..." : item.Description)</span>
                            }
                            else
                            {
                                <span style="color:rgba(255,255,255,0.25); font-style:italic; font-size:.82rem;">@L["Mod_NoDescription"]</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.IsPublished)
                            {
                                <span class="adm-badge adm-badge-success">@L["Mod_StatusOpen"]</span>
                            }
                            else
                            {
                                <span class="adm-badge" style="background:rgba(255,255,255,0.06); color:rgba(255,255,255,0.4);">@L["Mod_StatusHidden"]</span>
                            }
                        </td>
                        <td class="text-center" style="font-weight:700;">@item.Lessons.Count</td>
                        <td style="white-space:nowrap;">
                            <button type="button" class="adm-btn adm-btn-warning adm-btn-sm me-1"
                                    onclick="openEditModal(@item.ModuleId)">
                                <i class="bi bi-pencil"></i> @L["Btn_Edit"]
                            </button>
                            <button type="button" class="adm-btn adm-btn-danger adm-btn-sm me-1 btn-delete-module"
                                    data-id="@item.ModuleId">
                                <i class="bi bi-trash"></i>
                            </button>
                            <a asp-controller="Lesson" asp-action="Index" asp-route-moduleId="@item.ModuleId"
                               class="adm-btn adm-btn-info adm-btn-sm">
                                <i class="bi bi-list-ul"></i> @L["Mod_Lessons"]
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="d-flex justify-content-between align-items-center mt-3">
    <span style="color:rgba(255,255,255,0.45); font-size:.82rem;">
        @L["Mod_Page"] @Model.PageNumber / @Model.PageCount
        (@L["Adm_Total"]: @Model.TotalItemCount @L["Mod_TotalChapters"])
    </span>
    @Html.PagedListPager(Model, page => Url.Action("Index", new {
    courseId = ViewData["CourseId"],
        searchTerm = ViewData["SearchTerm"],
        page
        }), new PagedListRenderOptions
    {
        LiElementClasses = new[] { "page-item" },
        PageClasses = new[] { "page-link ajax-page-link" },
        UlElementClasses = new[] { "pagination" }
    })
</div>
