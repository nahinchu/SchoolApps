@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<SchoolApp.Models.Module>

@{
    ViewData["Title"] = L["Mod_Title"].Value;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var courseId = ViewData["CourseId"] != null ? (int)ViewData["CourseId"] : 0;
    var courseName = ViewData["CourseName"] as string ?? "";
}

<div class="adm-page-header">
    <div>
        <div class="adm-page-title">📖 @L["Mod_PageTitle"] — <span>@courseName</span></div>
        <div class="adm-page-sub">@L["Mod_Sub"]</div>
    </div>
</div>

<!-- TOOLBAR -->
<div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:1.5rem; flex-wrap:wrap;">
    <a asp-controller="Course" asp-action="Index"
       class="adm-btn" style="background:rgba(255,255,255,.07); color:rgba(255,255,255,.6); border:1px solid rgba(255,255,255,.12);">
        <i class="bi bi-arrow-left me-1"></i> @L["Mod_BackToCourses"]
    </a>

    <form id="searchForm" method="get" style="flex:1; max-width:440px; display:flex; gap:0;">
        <input type="hidden" name="courseId" value="@courseId" />
        <div style="position:relative; flex:1;">
            <i class="bi bi-search" style="position:absolute; left:11px; top:50%; transform:translateY(-50%); color:var(--adm-text-dim); font-size:.85rem;"></i>
            <input type="text" name="searchTerm" value="@ViewData["SearchTerm"]"
                   class="adm-input" placeholder="@L["Mod_SearchPlaceholder"]"
                   style="padding-left:34px; border-radius:8px 0 0 8px;" />
        </div>
        <button type="submit" class="adm-btn adm-btn-primary" style="border-radius:0 8px 8px 0; padding:9px 18px; font-weight:600;">
            @L["Course_SearchBtn"]
        </button>
    </form>

    <button type="button" class="adm-btn adm-btn-primary" data-bs-toggle="modal" data-bs-target="#moduleModal"
            onclick="openCreateModal()">
        <i class="bi bi-plus-circle me-1"></i> @L["Mod_AddNew"]
    </button>
</div>

<div id="moduleTableContainer">
    @{
        ViewData["CourseId"] = courseId;
    }
    @await Html.PartialAsync("_ModuleTable", Model)
</div>

<!-- ==================== MODAL CREATE / EDIT ==================== -->
<div class="modal fade" id="moduleModal" tabindex="-1" aria-labelledby="moduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border:none; border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-lg);">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%); padding:1.25rem 1.5rem; border:none;">
                <h5 id="moduleModalLabel" style="font-family:var(--font-display); font-size:1.15rem; font-weight:600; color:var(--gold-light); margin:0;">
                    @L["Mod_ModalAddTitle"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" style="padding:1.5rem; background:var(--white);">
                <div id="modalResult"></div>
                <form id="moduleForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="ModuleId" name="ModuleId" value="0" />
                    <input type="hidden" id="CourseId" name="CourseId" value="@courseId" />

                    <div class="row">
                        <div class="col-md-8">
                            <div class="sa-form-group">
                                <label class="sa-label" for="Title">@L["Mod_ChapterName"] <span style="color:var(--danger)">*</span></label>
                                <input type="text" id="Title" name="Title" class="sa-input" placeholder="@L["Mod_ChapterName"]" />
                                <div class="invalid-feedback" id="err-Title"></div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="sa-form-group">
                                <label class="sa-label" for="OrderIndex">@L["Mod_OrderIndex"]</label>
                                <input type="number" id="OrderIndex" name="OrderIndex" class="sa-input" min="0" value="0" />
                                <div class="invalid-feedback" id="err-OrderIndex"></div>
                            </div>
                        </div>
                    </div>

                    <div class="sa-form-group">
                        <label class="sa-label" for="Description">@L["Mod_Description"]</label>
                        <textarea id="Description" name="Description" class="sa-input" rows="4"
                                  placeholder="@L["Mod_Description"]..."></textarea>
                        <div class="invalid-feedback" id="err-Description"></div>
                    </div>

                    <div class="form-check form-switch">
                        <input type="checkbox" id="IsPublished" name="IsPublished" value="true" class="form-check-input" checked />
                        <label for="IsPublished" class="form-check-label">@L["Mod_IsPublished"]</label>
                    </div>
                </form>
            </div>

            <div class="modal-footer" style="padding:1rem 1.5rem; background:var(--off-white); border-top:1px solid var(--smoke);">
                <button type="button" class="sa-btn sa-btn-outline" data-bs-dismiss="modal">@L["Btn_Cancel"]</button>
                <button type="button" class="sa-btn sa-btn-primary" id="btnSaveModule">
                    <i class="bi bi-check-lg"></i> <span class="btn-text">@L["Btn_Save"]</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

    <script>
        var isEditMode = false;
        var currentCourseId = @courseId;
        var _modModalAdd    = '➕ @L["Mod_ModalAddTitle"]';
        var _modModalEdit   = '✏️ @L["Mod_ModalEditTitle"]';
        var _modSave        = '@L["Btn_Save"]';
        var _modUpdate      = '@L["Btn_Update"]';
        var _modLoadErr     = '@L["Mod_LoadError"]';
        var _modDelConf     = '@L["Mod_DeleteConfirm"]';
        var _modDelErr      = '@L["Mod_DeleteError"]';
        var _modNoPermAdmin = '@L["Adm_NoPermAdmin"]';
        var _modReorderOk   = '@L["Mod_ReorderSuccess"]';
        var _modReorderErr  = '@L["Mod_ReorderError"]';
        var _errAjaxPrefix  = '@L["Err_AjaxPrefix"]';

        function clearErrors() {
            $('#modalResult').html('');
            $('#moduleForm .sa-input').removeClass('is-invalid');
            $('#moduleForm [id^="err-"]').text('');
        }

        function openCreateModal() {
            isEditMode = false;
            $('#moduleModalLabel').text(_modModalAdd);
            $('#btnSaveModule .btn-text').text(_modSave);
            $('#moduleForm')[0].reset();
            $('#ModuleId').val(0);
            $('#CourseId').val(currentCourseId);
            $('#IsPublished').prop('checked', true);
            clearErrors();
        }

        function openEditModal(id) {
            isEditMode = true;
            $('#moduleModalLabel').text(_modModalEdit);
            $('#btnSaveModule .btn-text').text(_modUpdate);
            clearErrors();

            $.get('@Url.Action("GetModule", "Module")/' + id, function (data) {
                $('#ModuleId').val(data.moduleId);
                $('#Title').val(data.title);
                $('#Description').val(data.description);
                $('#OrderIndex').val(data.orderIndex);
                $('#IsPublished').prop('checked', data.isPublished);
                $('#CourseId').val(data.courseId);
                $('#moduleModal').modal('show');
            }).fail(function () {
                showToast(_modLoadErr, 'danger');
            });
        }

        $(function () {
            initSortable();

            $('#btnSaveModule').on('click', function () {
                clearErrors();
                var url = isEditMode
                    ? '@Url.Action("EditAjax", "Module")'
                    : '@Url.Action("CreateAjax", "Module")';

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: $('#moduleForm').serialize(),
                    success: function (res) {
                        if (res.success) {
                            $('#moduleModal').modal('hide');
                            showToast(res.message, 'success');
                            loadModules(1);
                        } else if (res.errors) {
                            $.each(res.errors, function (field, messages) {
                                $('#' + field).addClass('is-invalid');
                                $('#err-' + field).text(messages.join(', '));
                            });
                        } else {
                            $('#modalResult').html(
                                '<div class="sa-alert sa-alert-danger"><i class="bi bi-exclamation-circle-fill"></i> ' +
                                $('<span>').text(res.message).html() + '</div>'
                            );
                        }
                    },
                    error: function (xhr) {
                        showToast(xhr.status === 403 ? _modNoPermAdmin : (_errAjaxPrefix + xhr.statusText), 'danger');
                    }
                });
            });

            $('#searchForm').on('submit', function (e) {
                e.preventDefault();
                loadModules(1);
            });

            $(document).on('click', '.ajax-page-link', function (e) {
                e.preventDefault();
                var match = $(this).attr('href').match(/page=(\d+)/);
                loadModules(match ? parseInt(match[1]) : 1);
            });

            $(document).on('click', '.btn-delete-module', function () {
                if (!confirm(_modDelConf)) return;

                var id = $(this).data('id');
                var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("Delete", "Module")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function (res) {
                        if (res.success) {
                            showToast(res.message, 'success');
                            loadModules(1);
                        } else {
                            showToast(res.message, 'danger');
                        }
                    },
                    error: function () {
                        showToast(_modDelErr, 'danger');
                    }
                });
            });

            function initSortable() {
                var tbody = document.getElementById('moduleTableBody');
                if (!tbody) return;
                Sortable.create(tbody, {
                    handle: '.bi-grip-vertical',
                    animation: 150,
                    onEnd: function() {
                        var ids = Array.from(tbody.querySelectorAll('tr[data-id]'))
                                       .map(tr => parseInt(tr.dataset.id));
                        var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
                        $.ajax({
                            url: '@Url.Action("ReorderAjax", "Module")',
                            type: 'POST',
                            contentType: 'application/json',
                            headers: { 'RequestVerificationToken': token },
                            data: JSON.stringify({ ids: ids }),
                            success: function(res) {
                                if (res.success) showToast(_modReorderOk, 'success');
                            },
                            error: function() { showToast(_modReorderErr, 'danger'); }
                        });
                    }
                });
            }

            window.loadModules = function(page) {
                var searchTerm = $('#searchForm input[name="searchTerm"]').val();
                $.ajax({
                    url: '@Url.Action("Index", "Module")',
                    type: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    data: {
                        courseId: currentCourseId,
                        searchTerm: searchTerm,
                        page: page
                    },
                    success: function (html) {
                        $('#moduleTableContainer').html(html);
                        initSortable();
                    }
                });
            };

            window.showToast = function (message, type) {
                var cls = type === 'success' ? 'sa-alert-success' : 'sa-alert-danger';
                var icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
                var toast = $(`
                    <div class="sa-alert ${cls}" style="position:fixed; top:1rem; right:1rem; z-index:9999; min-width:320px; box-shadow:var(--shadow-md);">
                        <span class="sa-alert-icon"><i class="bi ${icon}"></i></span>
                        <span>${message}</span>
                        <button class="sa-alert-close" onclick="$(this).parent().remove()"><i class="bi bi-x"></i></button>
                    </div>`);
                $('body').append(toast);
                setTimeout(() => toast.fadeOut(300, () => toast.remove()), 3000);
            };
        });
    </script>
}
