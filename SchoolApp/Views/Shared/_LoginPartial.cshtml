@inject Microsoft.Extensions.Localization.IStringLocalizer<SchoolApp.Resources.MyLanguage> L
@if (Context.Session.GetString("StudentName") != null)
{
    <span>@L["Nav_Hello"] @Context.Session.GetString("StudentName")</span>
    <a asp-controller="Account" asp-action="Logout">@L["Nav_Logout"]</a>
}
else
{
    <a asp-controller="Account" asp-action="Login">@L["Nav_LoginBtn"]</a>
}
