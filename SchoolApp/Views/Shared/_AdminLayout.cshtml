@inject Microsoft.Extensions.Localization.IStringLocalizer<SchoolApp.Resources.MyLanguage> L
@{
    var _role = Context.Session.GetString("Role") ?? "";
    var _name = Context.Session.GetString("StudentName") ?? "User";
    var _initials = _name.Length > 0 ? _name[0].ToString().ToUpper() : "U";

    var _ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var _action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var _currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var _nextCulture = _currentCulture == "vi-VN" ? "en-GB" : "vi-VN";
    var _flagSrc = _currentCulture == "vi-VN" ? "https://flagcdn.com/w40/vn.png" : "https://flagcdn.com/w40/gb.png";
    var _langCode = _currentCulture == "vi-VN" ? "VI" : "EN";

    bool IsActive(string controller, string action = "")
    {
        if (string.IsNullOrEmpty(action))
            return _ctrl.Equals(controller, StringComparison.OrdinalIgnoreCase);
        return _ctrl.Equals(controller, StringComparison.OrdinalIgnoreCase)
            && _action.Equals(action, StringComparison.OrdinalIgnoreCase);
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SchoolApp Admin</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#127891;</text></svg>" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/css/Schoolapp.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body class="adm-body">

    <!-- ── TOPBAR ────────────────────────────────────────── -->
    <header class="adm-topbar">
        <div class="adm-topbar-toggle">
            <button class="adm-toggle-btn" id="adm-sidebar-toggle" aria-label="Toggle sidebar">
                <i class="bi bi-list"></i>
            </button>
            <a class="adm-brand" asp-controller="Admin" asp-action="Dashboard">
                <div class="adm-brand-icon">🎓</div>
                <span class="adm-brand-name">School<span>App</span></span>
            </a>
        </div>

        <div class="adm-topbar-spacer"></div>

        <div class="adm-topbar-actions">
            <!-- Language switcher -->
            <form asp-controller="Language" asp-action="SetLanguage" method="post" style="margin:0;">
                <input type="hidden" name="culture" value="@_nextCulture" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit"
                        title="@L["SelectLanguage"]"
                        style="background:rgba(255,255,255,.06); border:1.5px solid rgba(255,255,255,.15);
                               cursor:pointer; display:flex; align-items:center; gap:.4rem;
                               padding:.28rem .65rem; border-radius:20px; transition:background .2s, border-color .2s;"
                        onmouseenter="this.style.background='rgba(201,168,76,.18)'; this.style.borderColor='rgba(201,168,76,.6)';"
                        onmouseleave="this.style.background='rgba(255,255,255,.06)'; this.style.borderColor='rgba(255,255,255,.15)';">
                    <img src="@_flagSrc" alt="@_langCode"
                         style="width:20px; height:14px; object-fit:cover; border-radius:2px; box-shadow:0 1px 3px rgba(0,0,0,.4);" />
                    <span style="font-size:.72rem; font-weight:700; color:rgba(255,255,255,.85); letter-spacing:.5px;">@_langCode</span>
                </button>
            </form>

            <!-- User dropdown -->
            <div class="dropdown">
                <button class="adm-user-btn dropdown-toggle" data-bs-toggle="dropdown"
                        aria-expanded="false" type="button">
                    <div class="adm-avatar">@_initials</div>
                    <div class="d-none d-sm-block text-start">
                        <div class="adm-user-name">@_name</div>
                        <div class="adm-user-role">
                            @if (_role == "Admin")
                            {
                                <text><i class="bi bi-shield-fill-check"></i> @L["Nav_AdminRole"]</text>
                            }
                            else
                            {
                                <text><i class="bi bi-person-gear"></i> @L["Nav_ManagerRole"]</text>
                            }
                        </div>
                    </div>
                    <i class="bi bi-chevron-down adm-user-chevron d-none d-sm-block"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end adm-user-menu">
                    <li class="px-3 py-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="adm-avatar">@_initials</div>
                            <div>
                                <div style="font-weight:600;font-size:.85rem;color:#fff;">@_name</div>
                                <div style="font-size:.72rem;color:var(--adm-gold);">
                                    @(_role == "Admin" ? L["Nav_AdminRole"].Value : L["Nav_ManagerRole"].Value)
                                </div>
                            </div>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider" style="border-color:var(--adm-border);margin:4px 0;"></li>
                    <li>
                        <a class="dropdown-item" asp-controller="Account" asp-action="EditProfile">
                            <i class="bi bi-person-gear"></i> @L["Nav_EditProfile"]
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" style="border-color:var(--adm-border);margin:4px 0;"></li>
                    <li>
                        <a class="dropdown-item danger" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right"></i> @L["Nav_Logout"]
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- ── SHELL ──────────────────────────────────────────── -->
    <div class="adm-shell">

        <!-- ── SIDEBAR ──────────────────────────────────── -->
        <nav class="adm-sidebar" id="adm-sidebar">
            <div class="adm-sidebar-inner">

                <!-- TỔNG QUAN -->
                <div class="adm-nav-label">@L["Adm_Overview"]</div>
                <a class="adm-nav-link @(IsActive("Admin", "Dashboard") ? "active" : "")"
                   asp-controller="Admin" asp-action="Dashboard" title="Dashboard">
                    <i class="bi bi-speedometer2 adm-nav-icon"></i>
                    <span class="adm-nav-text">Dashboard</span>
                </a>

                <hr class="adm-nav-divider" />

                <!-- QUẢN LÝ NỘI DUNG -->
                <div class="adm-nav-label">@L["Footer_Manage"]</div>

                <a class="adm-nav-link @(IsActive("Course") ? "active" : "")"
                   asp-controller="Course" asp-action="Index" title="@L["AdminCourses"]">
                    <i class="bi bi-book adm-nav-icon"></i>
                    <span class="adm-nav-text">@L["AdminCourses"]</span>
                </a>

                <a class="adm-nav-link @(IsActive("Student") ? "active" : "")"
                   asp-controller="Student" asp-action="Index" title="@L["AdminStudents"]">
                    <i class="bi bi-people adm-nav-icon"></i>
                    <span class="adm-nav-text">@L["AdminStudents"]</span>
                </a>

                <a class="adm-nav-link @(IsActive("Enrollment") ? "active" : "")"
                   asp-controller="Enrollment" asp-action="Index" title="@L["AdminEnrollments"]">
                    <i class="bi bi-journal-check adm-nav-icon"></i>
                    <span class="adm-nav-text">@L["AdminEnrollments"]</span>
                </a>

                <a class="adm-nav-link @(IsActive("QuestionBank") ? "active" : "")"
                   asp-controller="QuestionBank" asp-action="Index" title="@L["AdminQuestionBank"]">
                    <i class="bi bi-bank adm-nav-icon"></i>
                    <span class="adm-nav-text">@L["AdminQuestionBank"]</span>
                </a>

                @if (_role == "Admin")
                {
                    <hr class="adm-nav-divider" />
                    <div class="adm-nav-label">@L["Footer_System"]</div>
                    <a class="adm-nav-link @(IsActive("Admin", "Payments") ? "active" : "")"
                       asp-controller="Admin" asp-action="Payments" title="@L["Adm_PaymentHistory"]">
                        <i class="bi bi-credit-card adm-nav-icon"></i>
                        <span class="adm-nav-text">@L["Adm_PaymentHistory"]</span>
                    </a>
                    <a class="adm-nav-link @(IsActive("Admin", "Managers") ? "active" : "")"
                       asp-controller="Admin" asp-action="Managers" title="@L["Nav_ManageManagers"]">
                        <i class="bi bi-person-gear adm-nav-icon"></i>
                        <span class="adm-nav-text">@L["Nav_ManageManagers"]</span>
                    </a>
                }

            </div>
        </nav>

        <!-- ── CONTENT ───────────────────────────────────── -->
        <main class="adm-content" id="adm-content">

            @if (TempData["Success"] != null)
            {
                <div class="adm-alert adm-alert-success" id="adm-alert-ok">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["Success"]</span>
                    <button class="adm-alert-close" onclick="this.closest('.adm-alert').remove()">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="adm-alert adm-alert-danger" id="adm-alert-err">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@TempData["Error"]</span>
                    <button class="adm-alert-close" onclick="this.closest('.adm-alert').remove()">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }

            @RenderBody()
        </main>

    </div><!-- /.adm-shell -->
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Fix: xóa backdrop giả do extension inject
        var _admBackdropInterval;
        $(document).on('show.bs.modal', '.modal', function () {
            _admBackdropInterval = setInterval(function () {
                var backdrops = document.querySelectorAll('.modal-backdrop');
                if (backdrops.length > 1) {
                    for (var i = 1; i < backdrops.length; i++) { backdrops[i].remove(); }
                }
            }, 100);
        });
        $(document).on('hidden.bs.modal', '.modal', function () {
            clearInterval(_admBackdropInterval);
        });
    </script>

    <script>
        (function () {
            const body = document.body;
            const toggle = document.getElementById('adm-sidebar-toggle');
            const COLLAPSED_KEY = 'adm_sidebar_collapsed';

            // Restore state
            if (localStorage.getItem(COLLAPSED_KEY) === '1') {
                body.classList.add('sidebar-collapsed');
            }

            toggle.addEventListener('click', function () {
                const isMobile = window.innerWidth <= 768;
                if (isMobile) {
                    body.classList.toggle('sidebar-mobile-open');
                } else {
                    const isCollapsed = body.classList.toggle('sidebar-collapsed');
                    localStorage.setItem(COLLAPSED_KEY, isCollapsed ? '1' : '0');
                }
            });

            // Close on mobile overlay click
            document.addEventListener('click', function (e) {
                if (window.innerWidth <= 768
                    && body.classList.contains('sidebar-mobile-open')
                    && !e.target.closest('#adm-sidebar')
                    && !e.target.closest('#adm-sidebar-toggle')) {
                    body.classList.remove('sidebar-mobile-open');
                }
            });
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>