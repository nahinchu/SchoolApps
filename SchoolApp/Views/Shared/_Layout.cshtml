<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@L["Nav_MetaDesc"]" />
    <title>@ViewData["Title"] - SchoolApp</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#127891;</text></svg>" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="~/css/Schoolapp.css" rel="stylesheet" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        var _topRole = Context.Session.GetString("Role");
    }
    @if (_topRole == "Admin")
    {
        <div class="sa-admin-bar">
            <i class="bi bi-shield-fill-check"></i>
            @Html.Raw(L["Nav_AdminBarAdmin"])
            — <a href="/Admin/Dashboard" style="color:#c9a84c;">@L["Nav_AdminBarDashboard"]</a>
        </div>
    }
    else if (_topRole == "Manager")
    {
        <div class="sa-admin-bar" style="background:linear-gradient(135deg,#1a3a52,#0d2b3e);">
            <i class="bi bi-person-gear"></i>
            @Html.Raw(L["Nav_AdminBarManager"])
        </div>
    }
    <header class="sa-header" id="sa-header">
        <div class="container">
            <a class="sa-brand" asp-controller="Home" asp-action="Index" aria-label="@L["Nav_BrandAria"]">
                <div class="sa-brand-icon">🎓</div>
                <span class="sa-brand-name">School<span>App</span></span>
            </a>

            <button class="sa-toggler" id="sa-toggler" aria-label="@L["Nav_OpenMenu"]" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="sa-nav-container" id="sa-nav-container">
                <ul class="sa-nav" role="navigation" aria-label="@L["Nav_MainNav"]">
                    <li>
                        <a class="sa-nav-link" asp-controller="Course" asp-action="Index">
                            <i class="bi bi-book nav-icon"></i>
                            @L["NavCourses"]
                        </a>
                    </li>
                    
                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <li>
                            <a class="sa-nav-link" asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 nav-icon"></i>
                                Dashboard
                            </a>
                        </li>
                        <li>
                            <a class="sa-nav-link" asp-controller="Admin" asp-action="Managers">
                                <i class="bi bi-person-gear nav-icon"></i>
                                @L["Nav_ManageManagers"]
                            </a>
                        </li>
                    }

                    @if (Context.Session.GetString("Role") == "Manager")
                    {
                        <li>
                            <a class="sa-nav-link" asp-controller="Student" asp-action="Index">
                                <i class="bi bi-people nav-icon"></i>
                                @L["NavStudents"]
                            </a>
                        </li>
                        <li>
                            <a class="sa-nav-link" asp-controller="Enrollment" asp-action="Index">
                                <i class="bi bi-journal-check nav-icon"></i>
                                @L["NavEnrollments"]
                            </a>
                        </li>
                        <li>
                            <a class="sa-nav-link" asp-controller="QuestionBank" asp-action="Index">
                                <i class="bi bi-bank nav-icon"></i>
                                @L["NavQuestionBank"]
                            </a>
                        </li>
                    }

                    @if (Context.Session.GetString("Role") == "Student")
                    {
                        <li>
                            <a class="sa-nav-link" asp-controller="Enrollment" asp-action="MyEnrollments">
                                <i class="bi bi-mortarboard nav-icon"></i>
                                @L["NavMyEnrollments"]
                            </a>
                        </li>
                        <li>
                            <a class="sa-nav-link" asp-controller="Certificate" asp-action="My">
                                <i class="bi bi-patch-check-fill nav-icon"></i>
                                @L["NavCertificates"]
                            </a>
                        </li>
                    }
                    <li>
                        <a class="sa-nav-link" asp-controller="Game" asp-action="Index">
                            <i class="bi bi-controller nav-icon"></i>
                            @L["NavGames"]
                        </a>
                    </li>
                </ul>
               
                <ul class="sa-user-section" aria-label="@L["Nav_AccountMenu"]">
                    @{
                        var _currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                        var _langFlags = new Dictionary<string, (string Flag, string Label)>
                        {
                            ["vi-VN"] = ("🇻🇳", "Tiếng Việt"),
                            ["en-GB"] = ("🇬🇧", "English")
                        };
                        var _currentFlag = _langFlags.TryGetValue(_currentCulture, out var _lf) ? _lf.Flag : "🌐";
                    }

                    @if (Context.Session.GetString("UserName") != null)
                    {
                        var studentName = Context.Session.GetString("UserName");
                        var role = Context.Session.GetString("Role");
                        var initials = studentName?.Length > 0 ? studentName[0].ToString().ToUpper() : "U";
                        var headerAvatar = Context.Session.GetString("AvatarUrl");

                        <!-- Notification Bell -->
                        <li class="dropdown" style="position:relative;">
                            <button type="button" id="notifBell"
                                    data-bs-toggle="dropdown" data-bs-offset="0,10"
                                    style="background:none; border:none; cursor:pointer; position:relative;
                                           width:38px; height:38px; display:flex; align-items:center; justify-content:center;
                                           border-radius:50%; transition:background .2s;"
                                    onmouseenter="this.style.background='rgba(255,255,255,.08)'"
                                    onmouseleave="this.style.background='none'"
                                    aria-label="@L["Nav_Notifications"]">
                                <i class="bi bi-bell-fill" style="font-size:1.1rem; color:rgba(255,255,255,.75);"></i>
                                <span id="notifBadge" style="display:none; position:absolute; top:4px; right:4px;
                                      width:16px; height:16px; border-radius:50%; background:#dc2626;
                                      font-size:.6rem; font-weight:700; color:#fff;
                                      align-items:center; justify-content:center; line-height:1;"></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end"
                                 style="min-width:320px; background:#1b2d42; border:1px solid rgba(201,168,76,.25);
                                        border-radius:14px; padding:0; overflow:hidden;
                                        box-shadow:0 16px 40px rgba(0,0,0,.5);">
                                <div style="padding:.75rem 1rem; border-bottom:1px solid rgba(255,255,255,.08);">
                                    <strong style="font-size:.875rem; color:#fff;">@L["Nav_Notifications"]</strong>
                                </div>
                                <div id="notifList" style="max-height:320px; overflow-y:auto;">
                                    <div style="padding:2rem; text-align:center; color:rgba(255,255,255,.35); font-size:.84rem;">
                                        @L["Nav_Loading"]
                                    </div>
                                </div>
                                <div style="padding:.6rem 1rem; border-top:1px solid rgba(255,255,255,.08); text-align:center;">
                                    <a href="@Url.Action("Index","Notification")"
                                       style="font-size:.8rem; color:rgba(201,168,76,.8); text-decoration:none;">
                                        @L["Nav_AllNotifications"]
                                    </a>
                                </div>
                            </div>
                        </li>

                        <li class="dropdown">
                            <button type="button" class="sa-greeting dropdown-toggle"
                                    data-bs-toggle="dropdown" data-bs-offset="0,10"
                                    aria-expanded="false">
                                <div class="sa-greeting-avatar" style="@(!string.IsNullOrEmpty(headerAvatar) ? "background:transparent;padding:0;overflow:hidden;" : "")">
                                    @if (!string.IsNullOrEmpty(headerAvatar))
                                    {
                                        <img src="@headerAvatar" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" alt="avatar" />
                                    }
                                    else
                                    {
                                        @initials
                                    }
                                </div>
                                <span class="sa-greeting-name">@studentName</span>
                                @if (role == "Admin")
                                {
                                    <span class="sa-badge-admin"><i class="bi bi-shield-fill-check"></i> Admin</span>
                                }
                                else if (role == "Manager")
                                {
                                    <span class="sa-badge-admin" style="background:rgba(26,90,143,0.15);color:#5b9dd9;"><i class="bi bi-person-gear"></i> Manager</span>
                                }
                                else if (role == "Student")
                                {
                                    <span class="sa-badge-student"><i class="bi bi-mortarboard-fill"></i> @L["Nav_StudentBadge"]</span>
                                }
                                <i class="bi bi-chevron-down sa-greeting-chevron"></i>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end sa-user-dropdown-menu"
                                style="
                                            background-color: #1b2d42;
                                            border: 1px solid rgba(201,168,76,0.25);
                                            border-radius: 12px;
                                            box-shadow: 0 16px 40px rgba(0,0,0,0.5);
                                            padding: 6px;
                                            min-width: 220px;
                                        ">
                                <!-- Header -->
                                <li style="
                                            display: flex;
                                            align-items: center;
                                            gap: 12px;
                                            padding: 10px 12px 8px;
                                        ">
                                    <div style="
                                                width:42px; height:42px; flex-shrink:0;
                                                background: linear-gradient(135deg, #c9a84c, #e8c96e);
                                                border-radius: 50%;
                                                display:flex; align-items:center; justify-content:center;
                                                font-size:16px; font-weight:700; color:#0d1b2a;
                                                box-shadow: 0 0 0 3px rgba(201,168,76,0.25);
                                                overflow:hidden;
                                            ">
                                        @if (!string.IsNullOrEmpty(headerAvatar))
                                        {
                                            <img src="@headerAvatar" style="width:100%;height:100%;object-fit:cover;" alt="avatar" />
                                        }
                                        else
                                        {
                                            @initials
                                        }
                                    </div>
                                    <div>
                                        <div style="font-weight:600; font-size:.9rem; color:#ffffff; line-height:1.3;">@studentName</div>
                                        <div style="font-size:.75rem; color:#c9a84c; margin-top:2px;">
                                            @if (role == "Admin")
                                            {
                                                <text><i class="bi bi-shield-fill-check"></i> @L["Nav_AdminRole"]</text>
                                            }
                                            else if (role == "Manager")
                                            {
                                                <text><i class="bi bi-person-gear"></i> @L["Nav_ManagerRole"]</text>
                                            }
                                            else
                                            {
                                                <text><i class="bi bi-mortarboard-fill"></i> @L["Nav_StudentBadge"]</text>
                                            }
                                        </div>
                                    </div>
                                </li>

                                <li><hr style="border-color: rgba(201,168,76,0.2); margin: 4px 0; opacity:1;"></li>

                                <li>
                                    <a class="sa-dditem" asp-controller="Account" asp-action="EditProfile"
                                       style="display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:6px;border-left:2px solid transparent;color:rgba(201,168,76,0.9);font-size:.875rem;font-weight:500;text-decoration:none;">
                                        <span style="width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:6px;background:rgba(201,168,76,0.12);font-size:.85rem;flex-shrink:0;">
                                            <i class="bi bi-person-gear"></i>
                                        </span>
                                        @L["Nav_EditProfile"]
                                    </a>
                                </li>

                                <li><hr style="border-color: rgba(201,168,76,0.2); margin: 4px 0; opacity:1;"></li>

                                <li>
                                    <a class="sa-dditem sa-dditem--danger" asp-controller="Account" asp-action="Logout"
                                       style="display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:6px;border-left:2px solid transparent;color:rgba(224,112,112,0.85);font-size:.875rem;font-weight:500;text-decoration:none;">
                                        <span style="width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:6px;background:rgba(192,57,43,0.15);font-size:.85rem;flex-shrink:0;">
                                            <i class="bi bi-box-arrow-right"></i>
                                        </span>
                                        @L["Nav_Logout"]
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="sa-btn-login" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-person-fill"></i>
                                @L["Nav_LoginBtn"]
                            </a>
                        </li>
                        <li>
                            <a class="sa-btn-register" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus"></i>
                                @L["Nav_RegisterBtn"]
                            </a>
                        </li>
                    }

                    <!-- Language Toggle — click để switch vi-VN ↔ en-GB -->
                    @{
                        var _nextCulture  = _currentCulture == "vi-VN" ? "en-GB" : "vi-VN";
                        var _nextLabel    = _langFlags.TryGetValue(_nextCulture, out var _nl) ? _nl.Label : _nextCulture;
                        var _flagImgSrc   = _currentCulture == "vi-VN"
                            ? "https://flagcdn.com/w40/vn.png"
                            : "https://flagcdn.com/w40/gb.png";
                        var _langCode     = _currentCulture == "vi-VN" ? "VI" : "EN";
                    }
                    <li>
                        <form asp-controller="Language" asp-action="SetLanguage" method="post" style="margin:0;">
                            <input type="hidden" name="culture" value="@_nextCulture" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit"
                                    title="@_nextLabel"
                                    style="background:rgba(255,255,255,.06); border:1.5px solid rgba(255,255,255,.15);
                                           cursor:pointer; display:flex; align-items:center; justify-content:center; gap:.4rem;
                                           padding:.28rem .65rem; border-radius:20px; transition:background .2s, border-color .2s;"
                                    onmouseenter="this.style.background='rgba(201,168,76,.18)'; this.style.borderColor='rgba(201,168,76,.6)';"
                                    onmouseleave="this.style.background='rgba(255,255,255,.06)'; this.style.borderColor='rgba(255,255,255,.15)';">
                                <img src="@_flagImgSrc" alt="@_langCode"
                                     style="width:20px; height:14px; object-fit:cover; border-radius:2px;
                                            box-shadow:0 1px 3px rgba(0,0,0,.4);" />
                                <span style="font-size:.72rem; font-weight:700; color:rgba(255,255,255,.85); letter-spacing:.5px;">
                                    @_langCode
                                </span>
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>

    </header>

    <main class="sa-main" id="sa-main" role="main">
        <div class="container">
            @if (TempData["Success"] != null)
            {
                <div class="sa-alert sa-alert-success" role="alert" id="alert-success">
                    <span class="sa-alert-icon"><i class="bi bi-check-circle-fill"></i></span>
                    <span>@TempData["Success"]</span>
                    <button class="sa-alert-close" onclick="dismissAlert('alert-success')" aria-label="@L["Btn_CloseAlert"]">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="sa-alert sa-alert-danger" role="alert" id="alert-error">
                    <span class="sa-alert-icon"><i class="bi bi-exclamation-circle-fill"></i></span>
                    <span>@TempData["Error"]</span>
                    <button class="sa-alert-close" onclick="dismissAlert('alert-error')" aria-label="@L["Btn_CloseAlert"]">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }

            @RenderBody()
        </div>
    </main>
    <footer class="sa-footer" role="contentinfo">

        <div class="sa-footer-top">
            <div class="container">
                <div class="sa-footer-grid">

                    @* Cot 1: Brand *@
                    <div>
                        <a class="sa-footer-brand" asp-controller="Home" asp-action="Index">
                            <div class="sa-brand-icon" style="width:34px;height:34px;font-size:16px;">&#127891;</div>
                            <span class="sa-footer-brand-name">School<span>App</span></span>
                        </a>
                        <p class="sa-footer-desc">@L["Footer_Desc"]</p>
                    </div>

                    @* Cot 2: Kham pha — hien thi theo role *@
                    <div>
                        <p class="sa-footer-heading">
                            @if (Context.Session.GetString("Role") == "Admin")
                            {
                                @L["Footer_System"]
                            }
                            else if (Context.Session.GetString("Role") == "Manager")
                            {
                                @L["Footer_Manage"]
                            }
                            else
                            {
                                @L["Footer_Explore"]
                            }
                        </p>
                        <ul class="sa-footer-links">
                            <li><a asp-controller="Home" asp-action="Index">@L["Footer_Home"]</a></li>
                            <li><a asp-controller="Course" asp-action="Index">@L["NavCourses"]</a></li>
                            <li><a asp-controller="Game" asp-action="Index">@L["NavGames"]</a></li>
                            @if (Context.Session.GetString("Role") == "Admin")
                            {
                                <li><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                <li><a asp-controller="Admin" asp-action="Managers">@L["Nav_ManageManagers"]</a></li>
                            }
                            @if (Context.Session.GetString("Role") == "Manager")
                            {
                                <li><a asp-controller="Student" asp-action="Index">@L["Footer_ManageStudents"]</a></li>
                                <li><a asp-controller="Enrollment" asp-action="Index">@L["Footer_ManageEnrollments"]</a></li>
                                <li><a asp-controller="QuestionBank" asp-action="Index">@L["NavQuestionBank"]</a></li>
                            }
                            @if (Context.Session.GetString("Role") == "Student")
                            {
                                <li><a asp-controller="Enrollment" asp-action="MyEnrollments">@L["NavMyEnrollments"]</a></li>
                            }
                        </ul>
                    </div>

                    @* Cot 3: Tai khoan — hien thi theo role *@
                    <div>
                        <p class="sa-footer-heading">@L["Footer_Account"]</p>
                        <ul class="sa-footer-links">
                            @{
                                var footerRole = Context.Session.GetString("Role");
                            }
                            @if (footerRole == null)
                            {
                                <li><a asp-controller="Account" asp-action="Login">@L["Footer_Login"]</a></li>
                                <li><a asp-controller="Account" asp-action="Register">@L["Footer_Register"]</a></li>
                            }
                            else if (footerRole == "Admin")
                            {
                                <li><a asp-controller="Admin" asp-action="Dashboard">@L["Footer_SystemDashboard"]</a></li>
                                <li><a asp-controller="Admin" asp-action="Managers">@L["Nav_ManageManagers"]</a></li>
                                <li><a asp-controller="Account" asp-action="Logout">@L["Nav_Logout"]</a></li>
                            }
                            else if (footerRole == "Manager")
                            {
                                <li><a asp-controller="Course" asp-action="Index">@L["Footer_ManageCourses"]</a></li>
                                <li><a asp-controller="Student" asp-action="Index">@L["Footer_ManageStudents"]</a></li>
                                <li><a asp-controller="Account" asp-action="Logout">@L["Nav_Logout"]</a></li>
                            }
                            else
                            {
                                <li><a asp-controller="Enrollment" asp-action="MyEnrollments">@L["NavMyEnrollments"]</a></li>
                                <li><a asp-controller="Account" asp-action="EditProfile">@L["Nav_EditProfile"]</a></li>
                                <li><a asp-controller="Account" asp-action="Logout">@L["Nav_Logout"]</a></li>
                            }
                        </ul>
                    </div>

                    @* Cot 4: Lien he *@
                    <div>
                        <p class="sa-footer-heading">@L["Footer_Contact"]</p>
                        <ul class="sa-footer-links">
                            <li>
                                <a href="mailto:support@schoolapp.vn">
                                    <i class="bi bi-envelope"></i> support@schoolapp.vn
                                </a>
                            </li>
                            <li>
                                <a href="tel:+842812345678">
                                    <i class="bi bi-telephone"></i> 028 1234 5678
                                </a>
                            </li>
                            <li>
                                <a href="#">
                                    <i class="bi bi-geo-alt"></i> @L["Nav_FooterAddress"]
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>

        <div class="sa-footer-divider"></div>

        <div class="container">
            <div class="sa-footer-bottom">
                <p class="sa-footer-copy">
                    &copy; 2026 <strong>SchoolApp</strong>. @L["Footer_Rights"]
                </p>
                <p class="sa-footer-tagline">@L["Footer_Tagline"]</p>
            </div>
        </div>

    </footer>
    <!-- JS -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function dismissAlert(id) {
            var el = document.getElementById(id);
            if (el) el.remove();
        }

        document.getElementById('sa-toggler').addEventListener('click', function () {
            var container = document.getElementById('sa-nav-container');
            var open = container.classList.toggle('open');
            this.classList.toggle('open', open);
            this.setAttribute('aria-expanded', open);
        });


        // Chevron xoay khi dropdown mở/đóng
        document.querySelectorAll('.sa-greeting.dropdown-toggle').forEach(function(btn) {
            btn.addEventListener('shown.bs.dropdown', function() {
                var chevron = btn.querySelector('.sa-greeting-chevron');
                if (chevron) chevron.style.transform = 'rotate(180deg)';
            });
            btn.addEventListener('hidden.bs.dropdown', function() {
                var chevron = btn.querySelector('.sa-greeting-chevron');
                if (chevron) chevron.style.transform = '';
            });
        });

        // Fix: xóa backdrop giả do extension inject
        var backdropInterval;
        $(document).on('show.bs.modal', '.modal', function () {
            backdropInterval = setInterval(function () {
                var backdrops = document.querySelectorAll('.modal-backdrop');
                if (backdrops.length > 1) {
                    for (var i = 1; i < backdrops.length; i++) {
                        backdrops[i].remove();
                    }
                }
            }, 100);
        });
        $(document).on('hidden.bs.modal', '.modal', function () {
            clearInterval(backdropInterval);
        });
    </script>

    @RenderSection("Scripts", required: false)

    @if (Context.Session.GetString("UserName") != null)
    {
        <!-- Hidden form chỉ để cung cấp CSRF token cho JS notification -->
        <form id="notifCsrfForm" style="display:none;">@Html.AntiForgeryToken()</form>

        <script>
        var _noNotifications = '@L["Nav_NoNotifications"]';
        function getCsrfToken() {
            return document.querySelector('#notifCsrfForm input[name="__RequestVerificationToken"]')?.value ?? '';
        }

        function loadNotifications() {
            fetch('@Url.Action("GetDropdown","Notification")')
            .then(r => r.json())
            .then(function(data) {
                updateBadge(data.unread);

                var list = document.getElementById('notifList');
                if (!list) return;
                if (!data.items || data.items.length === 0) {
                    list.innerHTML = '<div style="padding:2rem; text-align:center; color:rgba(255,255,255,.35); font-size:.84rem;">' + _noNotifications + '</div>';
                    return;
                }
                list.innerHTML = data.items.map(function(n) {
                    var bg       = n.isRead ? 'transparent' : 'rgba(201,168,76,.05)';
                    var iconCls  = n.isRead ? 'bi-bell'      : 'bi-bell-fill';
                    var iconClr  = n.isRead ? 'rgba(255,255,255,.3)' : '#c9a84c';
                    var fw       = n.isRead ? '400' : '600';
                    var titleClr = n.isRead ? 'rgba(255,255,255,.6)' : '#fff';
                    return '<a href="' + (n.link || '#') + '" style="display:block;padding:.65rem 1rem;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.05);background:' + bg + ';transition:background .15s;" onmouseenter="this.style.background=\'rgba(255,255,255,.05)\'" onmouseleave="this.style.background=\'' + bg + '\'">'
                        + '<div style="display:flex;align-items:flex-start;gap:.6rem;">'
                        + '<i class="bi ' + iconCls + '" style="color:' + iconClr + ';font-size:.85rem;margin-top:2px;flex-shrink:0;"></i>'
                        + '<div style="flex:1;min-width:0;">'
                        + '<div style="font-size:.82rem;font-weight:' + fw + ';color:' + titleClr + ';white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + n.title + '</div>'
                        + '<div style="font-size:.76rem;color:rgba(255,255,255,.4);margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + n.message + '</div>'
                        + '<div style="font-size:.7rem;color:rgba(255,255,255,.25);margin-top:3px;">' + n.createdAt + '</div>'
                        + '</div></div></a>';
                }).join('');
            })
            .catch(function() {});
        }

        function updateBadge(count) {
            var badge = document.getElementById('notifBadge');
            if (!badge) return;
            if (count > 0) {
                badge.textContent = count > 9 ? '9+' : count;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }
        }

        function sendMarkAllRead() {
            fetch('@Url.Action("MarkAllRead","Notification")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + encodeURIComponent(getCsrfToken())
            }).catch(function() {});
        }

        var notifBell = document.getElementById('notifBell');

        // Mở dropdown → tải danh sách mới nhất
        notifBell?.addEventListener('show.bs.dropdown', loadNotifications);

        // Đóng dropdown → mark all read tự động + ẩn badge ngay
        notifBell?.addEventListener('hidden.bs.dropdown', function() {
            var badge = document.getElementById('notifBadge');
            if (badge && badge.style.display !== 'none') {
                updateBadge(0);
                sendMarkAllRead();
            }
        });

        loadNotifications();
        setInterval(loadNotifications, 60000);
        </script>
    }
</body>
</html>