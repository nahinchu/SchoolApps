# ======================================
# .env - Environment Variables
# ======================================
# COPY file này thành .env
# VÀ FILL VÀO CÁC GIÁ TRỊ THỰC
#
# NEVER COMMIT .env TO GIT!
# Add to .gitignore: .env

# ============================================
# Database (SQL Server)
# ============================================
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!@#
DB_NAME=SchoolAppDB

# ============================================
# MinIO (Object Storage)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=YourStrongPassword123!@#
MINIO_BUCKET=school-app

# ============================================
# Google OAuth
# ============================================
# Lấy từ: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ============================================
# Email (SMTP)
# ============================================
# Recommend: Gmail
# App Password từ: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-16-chars
SENDER_NAME=SchoolApp

# ============================================
# PayOS (Nếu dùng payment)
# ============================================
# Lấy từ PayOS Dashboard
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ============================================
# Cloudinary (Optional - Image hosting)
# ============================================
# Lấy từ: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# SECURITY NOTES
# ============================================
# 1. Mật khẩu nên:
#    - 12+ ký tự
#    - Chứa: Chữ hoa, thường, số, ký tự đặc biệt
#    - Khác nhau cho DB, MinIO
#
# 2. NEVER share .env file!
#
# 3. Rotate credentials định kỳ
#
# 4. Keep .env in .gitignore
